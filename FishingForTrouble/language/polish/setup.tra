// Gadil
@3800 = ~Tak?~
@3801 = ~Twoja ¿ona poleci³a mi z tob¹ pomówiæ. Aiesha przysy³a mnie po swoj¹ now¹ szatê.~
@3802 = ~Nic takiego.~
@3803 = ~Powinieneœ zapytaæ o to moj¹ ¿onê. Ja nic nie wiem o ¿adnej szacie.~ ~Powinnaœ zapytaæ o to moj¹ ¿onê. Ja nic nie wiem o ¿adnej szacie.~
@3804 = ~Dziêkujê.~
@3805 = ~Czy ona ma jêzyk zamiast mózgu? Dlaczego nie mog³a odpowiedzieæ mi od razu? Ech!~
@3806 = ~Nie wiem nic poza tym, co ju¿ ci powiedzia³em.~
@3807 = ~Witaj z powrotem, witaj! Jak mogê ci pomóc tym razem?~
@3808 = ~Czym dok³adnie siê zajmujesz? Co to za zawód RZEMIEŒLNIK?~
@3809 = ~Co wiesz na temat Dusz Umar³ych?~
@3810 = ~Co mo¿esz mi powiedzieæ o Imradim?~
@3811 = ~Nic wiêcej. Dziêkujê.~
@3812 = ~Przybysze! Witajcie w moim domu! Mogê spytaæ o wasze imiona? Jak mogê wam pomóc?~
@3813 = ~Jestem <CHARNAME>, przybywam z Athkatli na Wybrze¿u Mieczy.~
@3814 = ~Najpierw zdradŸ mi swoje imiê. Nie mam pojêcia, kim jesteœ.~
@3815 = ~Zachowam moje imiê dla siebie. Mam kilka pytañ, na które odpowiesz, jeœli wiesz, co dla ciebie dobre.~
@3816 = ~Nie ja, lecz ty. No dobrze; Jestem Gadil, z zawodu rzemieœlnik, obywatel Imradim. Jeœli potrzebujesz coœ naprawiæ albo skonstruowaæ, jestem do dyspozycji.~
@3817 = ~Wiesz, Gadilu, zachowam moje imiê dla siebie. Mam kilka pytañ, na które odpowiesz, jeœli wiesz, co dla ciebie dobre.~
@3818 = ~Mi³o ciê poznaæ, <CHARNAME>. Mo¿e potrzebujesz coœ naprawiæ b¹dŸ skonstruowaæ?~
@3819 = ~Nie, nic mi nie przychodzi do g³owy. Moja broñ i pancerz nie wymagaj¹ naprawy. Mam jednak kilka pytañ, jeœli zgodzisz siê na nie odpowiedzieæ.~
@3820 = ~Odpowiem, jeœli bêdê umia³.~
@3821 = ~Imradim? Jest lepsze od wielu innych miasteczek. Przynajmniej przeje¿d¿aj¹ têdy pustynni wêdrowcy i liczne karawany, wiêc pracy nie brakuje. To jedyna oaza po tej stronie pustyni Calim, wiêc wiêkszoœæ z nich musi siê u nas zatrzymaæ.~
@3822 = ~Naprawiam i wytwarzam wiêkszoœæ przedmiotów, które ceni¹ sobie kobiety; garnki i patelnie, tego typu akcesoria. Naprawiam wozy, kiedy trafiaj¹ do mnie kupcy, którzy byli na tyle g³upi, ¿e próbowali przebyæ nimi pustyniê. Kiedy mam czas, wyrabiam ma³e b³yskotki, œwiecide³ka, które mê¿owie mog¹ dawaæ w prezencie ¿onom. Jeœli interesuje ciê broñ i zbroje, musisz pomówiæ z Nurim, a w sprawie mikstur uzdrawiaj¹cych i ochronnych spróbuj odszukaæ Khoury'ego z Pustyni.~
@3823 = ~Imradim? Jest lepsze od wielu innych miasteczek. Przynajmniej przeje¿d¿aj¹ têdy pustynni wêdrowcy i liczne karawany, wiêc pracy nie brakuje. To jedyna oaza po tej stronie pustyni Calim, wiêc wiêkszoœæ z nich musi têdy przejechaæ, ¿eby dostaæ siê gdziekolwiek dalej.~
@3824 = ~Ha! Musia³eœ rozmawiaæ z Aiesh¹. „Przynieœ mi kielich wody z Dusz Umar³ych”, czy tak? Có¿, mogê ci w tym pomóc. Udaj siê na pustyniê na po³udnie st¹d. Po krótkiej wêdrówce ujrzysz dziwne piaskowe kopce z dziurami. Kiedy wieje wiatr, zawodz¹ one niczym dusze umar³ych; W jednej z nich znajdziesz kwaœn¹ wodê. W³aœnie takiej potrzebuje Aiesha. Proszê, weŸ ten puchar i nabierz do niego wody.~ ~Ha! Musia³aœ rozmawiaæ z Aiesh¹. „Przynieœ mi kielich wody z Dusz Umar³ych”, czy tak? Có¿, mogê ci w tym pomóc. Udaj siê na pustyniê na po³udnie st¹d. Po krótkiej wêdrówce ujrzysz dziwne piaskowe kopce z dziurami. Kiedy wieje wiatr, zawodz¹ one niczym dusze umar³ych; W jednej z nich znajdziesz kwaœn¹ wodê. W³aœnie takiej potrzebuje Aiesha. Proszê, weŸ ten puchar i nabierz do niego wody.~
@3825 = ~Ostre s³owa z ust obcego szukaj¹cego wiktu i opierunku. Czego chcesz? Mów szybko. Nie mam czasu na czcze rozmowy.~
@3826 = ~Co to za miejsce?~
@3827 = ~Naprawiam i wytwarzam wiêkszoœæ przedmiotów, które ceni¹ sobie kobiety; garnki i patelnie, tego typu akcesoria. Naprawiam wozy, kiedy trafiaj¹ do mnie kupcy na tyle g³upi, ¿e próbowali przebyæ z nimi pustyniê. Kiedy mam czas, wyrabiam ma³e b³yskotki, œwiecide³ka, które mê¿owie mog¹ dawaæ w prezencie ¿onom. Tym siê zajmujê. Co jeszcze chcesz wiedzieæ?~
@3828 = ~Nic wiêcej.~
@3829 = ~Jest lepsze od wielu innych miasteczek. Jeszcze jakieœ pytania?~
@3830 = ~Musia³eœ rozmawiaæ z Aiesh¹. Udaj siê na pustyniê na po³udnie st¹d. Po krótkiej wêdrówce ujrzysz dziwne piaskowe kopce z dziurami. Kiedy wieje wiatr, zawodz¹ one niczym dusze umar³ych; W jednej z nich znajdziesz kwaœn¹ wodê. W³aœnie takiej potrzebuje Aiesha.~ ~Musia³aœ rozmawiaæ z Aiesh¹. Udaj siê na pustyniê na po³udnie st¹d. Po krótkiej wêdrówce ujrzysz dziwne piaskowe kopce z dziurami. Kiedy wieje wiatr, zawodz¹ one niczym dusze umar³ych; W jednej z nich znajdziesz kwaœn¹ wodê. W³aœnie takiej potrzebuje Aiesha.~
@3831 = ~Kwaœna woda? Co masz na myœli?~
@3832 = ~Ma wstrêtny smak, wypala usta i bardzo szybko wy¿era dno ka¿dego zwyk³ego pucharu.~
@3833 = ~A ty mo¿esz mi sprzedaæ puchar, który jest odporny na dzia³anie tej kwaœnej wody...?~
@3834 = ~Tak. Za piêæset sztuk z³ota.~
@3835 = ~Co...?! Ty...! Ty...! Piêæset sztuk z³ota! Za puchar!~
@3836 = ~Taka jest cena. Ani miedziaka mniej.~
