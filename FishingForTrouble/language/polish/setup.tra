// Basima
@2900 = ~Witaj ponownie, <CHARNAME>.~
@2901 = ~Rozmawia³em z twoim mê¿em. To bardzo interesuj¹cy i wykszta³cony mê¿czyzna.~ ~Rozmawia³am z twoim mê¿em. To bardzo interesuj¹cy i wykszta³cony mê¿czyzna.~
@2902 = ~Kim jesteœ? Czego chcesz?~
@2903 = ~Jestem <CHARNAME> i chcê z tob¹ zamieniæ kilka s³ów.~
@2904 = ~Uspokój siê i odpowiedz na moje pytania, kobieto.~
@2905 = ~Nic.~
@2906 = ~Nie bêdê rozmawia³a z osob¹ o takich manierach. Mo¿e i jestem kobiet¹, ale nie muszê znosiæ tak bezczelnego zachowania od barbarzyñcy z pó³nocy!~
@2907 = ~Wiêc giñ, wieœniaczko!~
@2908 = ~Skoro pytasz, jestem <CHARNAME>. Mów, kim ty jesteœ.~
@2909 = ~Jestem Basima, ¿ona Jalila Astrologa.~
@2910 = ~¯ona wieszcza, co? Bez w¹tpienia wieszcza rzeczy wielkich i ma³ych. Gdzie jest ten wieszcz owiec i kóz?~
@2911 = ~Ha. Znalaz³em tego wieszcza owiec i kóz na dachu jego chaty.~ ~Ha. Znalaz³am tego wieszcza owiec i kóz na dachu jego chaty.~
@2912 = ~Sam go poszukaj, khunzir. Nie mam zamiaru ani chwili d³u¿ej s³uchaæ twoich obel¿ywych s³ów.~ ~Sama go poszukaj, khunzir. Nie mam zamiaru ani chwili d³u¿ej s³uchaæ twoich obel¿ywych s³ów.~
@2913 = ~Opuœæ mój dom, khunzir. Nie mam zamiaru ani chwili d³u¿ej s³uchaæ twoich obel¿ywych s³ów.~
@2914 = ~Jestem Basima, ¿ona Jalila Astrologa. Co chcesz wiedzieæ?~
@2915 = ~Astrologa? Gdzie mogê znaleŸæ Jalila? Chcia³bym z nim porozmawiaæ.~ ~Astrologa? Gdzie mogê znaleŸæ Jalila? Chcia³abym z nim porozmawiaæ.~
@2916 = ~Ach tak. Rozmawia³em z twoim mê¿em. To bardzo interesuj¹cy i wykszta³cony mê¿czyzna.~ ~Ach tak. Rozmawia³am z twoim mê¿em. To bardzo interesuj¹cy i wykszta³cony mê¿czyzna.~
@2917 = ~Znajdziesz go w jego pracowni na dachu tego domu.~
@2918 = ~Dziêkujê ci.~
@2919 = ~Dziêkujê za tak uprzejme s³owa. Uwa¿am, ¿e spêdza tam za du¿o czasu, ale jestem tylko jego ¿on¹.~
@2920 = ~Wypowiada³ siê o tobie bardzo pochlebnie, Basimo.~
@2921 = ~Oraz kap³anem i magiem.~
@2922 = ~Za du¿o gada. Z ca³ym szacunkiem, <CHARNAME>, mam du¿o do zrobienia i jak zwykle ma³o czasu, ¿eby z tym wszystkim zd¹¿yæ.~
@2923 = ~Powiedzia³ ci o tym? Mam nadziejê, ¿e nie nadu¿yjesz jego zaufania.~
@2924 = ~Co chcesz przez to powiedzieæ?~
@2925 = ~Kap³ani nie s¹ zbyt lubiani w Imradim. Od dawna podejrzewano ich tutaj o kontakty z demonami. Przyjêt¹ praktyk¹ jest wypêdzenie na pustyniê ka¿dej osoby podejrzewanej o bycie kap³anem. Albo magiem.~
@2926 = ~W takim razie kto... ? Ach. Aiesha.~
@2927 = ~W takim razie kto opiekuje siê chorymi i rannymi?~
@2928 = ~Jesteœ bystry, <CHARNAME>. I prêdki. Tak, Aiesha jest kap³ank¹, a ja jestem jej uczennic¹, chocia¿ ona nigdy siê z tym przed tob¹ nie zdradzi. Skoro ju¿ odkry³eœ mój sekret, mam kilka przedmiotów, które mog¹ ciê zainteresowaæ.~ ~Jesteœ bystra, <CHARNAME>. I prêdka. Tak, Aiesha jest kap³ank¹, a ja jestem jej uczennic¹, chocia¿ ona nigdy siê z tym przed tob¹ nie zdradzi. Skoro ju¿ odkry³aœ mój sekret, mam kilka przedmiotów, które mog¹ ciê zainteresowaæ.~
@2929 = ~Poka¿ mi je.~
@2930 = ~Nie w tej chwili. Dziêkujê.~
@2931 = ~Nie domyœli³eœ siê? W takim razie nic ci nie powiem. Skoro ju¿ odkry³eœ mój sekret, mam kilka przedmiotów, które mog¹ ciê zainteresowaæ.~ ~Nie domyœli³aœ siê? W takim razie nic ci nie powiem. Skoro ju¿ odkry³aœ mój sekret, mam kilka przedmiotów, które mog¹ ciê zainteresowaæ.~
@2932 = ~Witaj, <CHARNAME>. Interesuje ciê zakup któregoœ z moich towarów?~
@2933 = ~Owszem.~

//*************************************************************************
// Drosig Seltin
@2950 = ~IdŸ sobie. Nie mam zamiaru z tob¹ rozmawiaæ. Ani z nikim innym.~
@2951 = ~Kim jesteœ? Czego chcesz w moim domu?~
@2952 = ~Jestem <CHARNAME>. A ty?~
@2953 = ~Zamknij siê i odpowiedz na moje pytania. Kim jesteœ?~
@2954 = ~Znowu ty. Czego chcesz tym razem? Jak ty siê tam niby nazywasz?~
@2955 = ~Jestem <CHARNAME>.~
@2956 = ~Po prostu siê zamknij i odpowiedz na moje pytania.~
@2957 = ~To nie twoja sprawa. Wynoœ siê z mojego domu – nie mam ci nic wiêcej do powiedzenia.~
@2958 = ~Odpowiesz na moje pytania, gnomie.~
@2959 = ~Dlaczego? Daj mi jeden dobry powód, co? Choæ jeden. Nie masz go, co?~
@2960 = ~Zacny gnomie, przepraszam za moje opryskliwe s³owa. Nie mia³y na celu ciê zaniepokoiæ. A teraz, czy mogê ci zadaæ kilka pytañ?~
@2961 = ~Niech ciê Dziewiêæ Piekie³ poch³onie, gnomie. I tak nie potrzebujê twojej pomocy.~
@2962 = ~Powiedz mi najpierw, kim jesteœ.~
@2963 = ~Kolejny nêdzny Pomiot Bhaala, co? Znam to okreœlenie. Có¿, Jestem Drosig Seltin, jeœli coœ ci to mówi.~
@2964 = ~Szczerze mówi¹c, nic mi nie mówi.~
@2965 = ~Tak, znam twoje imiê. Jesteœ ca³kiem s³awny w okolicach Athkatli.~
@2966 = ~K³amiesz. W ogóle nie jestem s³awny. A wiêc, czego chcesz?~
@2967 = ~S³ysza³em, ¿e z jakiegoœ dziwnego powodu ci¹gle kradniesz... eee... usuwasz szyld z gospody Pod Smoczym Kresem.~ ~S³ysza³am, ¿e z jakiegoœ dziwnego powodu ci¹gle kradniesz... eee... usuwasz szyld z gospody Pod Smoczym Kresem.~
@2968 = ~Przynajmniej jesteœ szczery. A wiêc, czego chcesz?~ ~Przynajmniej jesteœ szczera. A wiêc, czego chcesz?~
@2969 = ~To NIE jest gospoda „Pod Smoczym Kresem”. W³aœcicielem tej gospody by³ mój ojciec, a przed nim jego ojciec, a jeszcze przed nim jego dziad. Od pocz¹tku nazywa³a siê „Budk¹ Gnoma”, a ten t³usty wa¿niak, krzy¿ówka ludzkiego ³ajna i zara¿onego gibberlinga ma czelnoœæ nazywaæ j¹ „Pod Smoczym Kresem”. Za³o¿ê siê, ¿e wstawia³ ci tê absurdaln¹ gadkê o zielonym smoku, prawda?~
@2970 = ~Có¿... tak.~
@2971 = ~Nie mam na to czasu. Mo¿ecie siê spieraæ w nieskoñczonoœæ – nie wezmê w tym udzia³u.~
@2972 = ~Tak myœla³em. Ale nie powiedzia³ ci najlepszej czêœci, co nie? Jego ojczunio – ha! co za g³upie okreœlenie! – musia³ go wykopaæ ze œrodka ogromnego stosu smoczego ³ajna. Smok za³atwi³ siê na niego z wielkiej wysokoœci, ale tej czêœci to ci nie opowiedzia³, prawda? Oczywiœcie, ¿e nie. Potem przez kilka tygodni œmierdzia³ smoczymi odchodami – za nic nie móg³ siê domyæ.~
@2973 = ~Wiêc dlaczego nie prowadzisz Pod Smo... Budki Gnoma?~
@2974 = ~Mój ojciec straci³ j¹ w pijackim zak³adzie na rzecz tego jego... „ojczunia”. Tamten skorzysta³ z okazji, gdy mój ojciec by³ zalany w trupa, a potem nazwa³ j¹ tym g³upim mianem.~
@2975 = ~Dlaczego zatem twój ojciec nie przyzna³ siê do b³êdu, kiedy ju¿ wytrzeŸwia³?~
@2976 = ~Mój ojciec by³ honorowym gnomem. Da³ s³owo i trzyma³ siê go.~
@2977 = ~W taki razie, dlaczego nadal kradniesz szyld? Czy to nie przeciwko idei honoru twego ojca?~
@2978 = ~Wynoœ siê z mojego domu. Nie chcê z tob¹ rozmawiaæ ani chwili d³u¿ej! I nie wracaj!~

//*************************************************************************
// Stra¿nik Pentyrchu
@3000 = ~Witaj, przyjacielu! Jesteœ nowym stra¿nikiem?~ ~Witaj, moja droga! Jesteœ now¹ stra¿niczk¹?~
@3001 = ~Nie, nie jestem.~
@3002 = ~Nie i nie chcia³bym tej pracy, nawet gdyby by³a do wziêcia.~ ~Nie i nie chcia³abym tej pracy, nawet gdyby by³a do wziêcia.~
@3003 = ~Och! Poznajê ciê – Pomog³eœ odnowiæ wioskê i wie¿ê stra¿nicz¹.~ ~Och! Poznajê ciê – Pomog³aœ odnowiæ wioskê i wie¿ê stra¿nicz¹.~
@3004 = ~Czego tu wypatrujesz?~
@3005 = ~Karawan przybywaj¹cych Nadbrze¿nym Traktem, ale g³ównie statków. Statków wszelkich kszta³tów i rozmiarów. Przy dobrej pogodzie mo¿esz ujrzeæ statki z wysp Nelanthor okr¹¿aj¹ce koniec Pó³wyspu Tethyr, kieruj¹ce siê do Murann i Athkatli.~
@3006 = ~A gdy spojrzysz w inn¹ stronê, mo¿esz dostrzec statki z wysp Moonshae kieruj¹ce siê najpierw do Athkatli, potem do Candlekeep, Wrót Baldura, Waterdeep, Neverwinter i do Luskan na Grzbiecie Œwiata. Od czasu do czasu calishyccy kupcy przep³ywaj¹ têdy, ale niezbyt czêsto. W Calimshanie nie robi¹ dobrych ³odzi.~
@3007 = ~Dlaczego nie?~
@3008 = ~S¹ za bardzo przyzwyczajeni do sta³ych wiatrów i spokoju, do przewidywalnych mórz. Calishycki statek kupiecki jest zwykle zbyt delikatny, by poradziæ sobie ze sztormami i niespokojnymi morzami wokó³ Wybrze¿a Mieczy, dlatego nigdy nie zapuszcz¹ siê dalej na pó³noc ni¿ do Waterdeep. Jest tam dla nich o wiele za dziko. Widzisz ten wrak tam, przy ujœciu rzeki?~
@3009 = ~Tak, co z nim?~
@3010 = ~To „Duma Norlandii” z Caer Corwell na Gwynneth. Dobrze zbudowana na niespokojne morza wokó³ wysp Moonshae, ale mimo to zatonê³a podczas sztormu zesz³ej zimy. A teraz, czy widzisz tam statek z pojedynczym masztem? To w³aœnie calishycki statek kupiecki. Widzisz, jak delikatna jest ta konstrukcja w porównaniu z „Dum¹ Norlandii”?~
@3011 = ~Teraz rozumiem. Ale dlaczego obserwujesz przep³ywaj¹ce têdy statki?~
@3012 = ~Raz w miesi¹cu œlemy wieœci o nich do Athkatli, do Rady Szeœciu. Talos jeden wie, po co im to.~
@3013 = ~Phi. Znajd¹ jakiœ sposób, by mieæ z tego zysk, to pewne! Dziêki za wyjaœnienie, przyjacielu. To by³o bardzo interesuj¹ce.~
@3014 = ~Ale¿ proszê bardzo. Pewnego dnia chcia³bym byæ na jednej z tych ³odzi; zobaczyæ oddalone l¹dy, zanim zbytnio siê zestarzejê. I w trakcie z³apie mnie straszna choroba morska, bez w¹tpienia!~

//*************************************************************************
// Trójka
@3200 = ~A zatem... to nasz ma³y, uparty poszukiwacz przygód. Dwukrotnie próbowaliœmy udzieliæ ci przestrogi. Za pierwszym razem by³o ³atwo, za drugim... nie tak ³atwo. Jednak wci¹¿ tu jesteœ.~ ~A zatem... to nasza ma³a, uparta poszukiwaczka przygód. Dwukrotnie próbowaliœmy udzieliæ ci przestrogi. Za pierwszym razem by³o ³atwo, za drugim... nie tak ³atwo. Jednak wci¹¿ tu jesteœ.~ 
@3201 = ~Kim jesteœ?~
@3202 = ~Prawdê mówi¹c, to za drugim razem by³o tak samo ³atwo, jak za pierwszym. Czy teraz TY zamierzasz mnie powstrzymaæ?~ 
@3203 = ~Jesteœmy Trójk¹. Jedynym Stra¿nikiem.~
@3204 = ~Jedynym Stra¿nikiem? Czego?~ 
@3205 = ~Nie zadawaj g³upich pytañ, œmiertelniku!~
@3206 = ~By³em tylko ciekaw.~ ~By³am tylko ciekawa.~
@3207 = ~Aha. Czyli nie wiesz.~ 
@3208 = ~Twoja ciekawoœæ doprowadzi ciê do szybkiej zguby, œmiertelna istoto, jeœli nie umiesz jej pohamowaæ.~
@3209 = ~Jak na razie ¿yjê.~ 
@3210 = ~Jeszcze jedno s³owo, œmiertelniku, a spotka ciê szybki koniec. Teraz odejdŸ st¹d, póki jeszcze mo¿esz.~
@3211 = ~Nie.~
@3212 = ~Ju¿ sobie idê.~ 
@3213 = ~Twoje ¿ycie mo¿e siê nied³ugo zakoñczyæ. Czego tu chcesz?~
@3214 = ~Chcê obejrzeæ grobowiec krasnoludzkiego w³adcy, który jest tutaj pochowany.~ 
@3215 = ~Byli i inni poszukiwacze przygód, którzy te¿ tego pragnêli, a przy tym chcieli okraœæ grób. OdejdŸ st¹d, póki jeszcze mo¿esz!~
@3216 = ~Cena za to mo¿e byæ wysoka, œmiertelna istoto. Czy zdo³asz j¹ ponieœæ?~
@3217 = ~Tak.~
@3218 = ~Zatem odejdŸ st¹d, póki jeszcze mo¿esz.~ 
@3219 = ~Odwaga mo¿e byæ niekiedy nagrod¹ sam¹ w sobie. Mo¿esz przejœæ, ale nie zapomnij, ¿e bêdziemy tutaj, kiedy bêdziesz wracaæ. Zostaw wszystko na swoim miejscu albo za to zap³acisz.~
@3220 = ~Tylko nie mów, ¿e ciê nie ostrzega³em, kiedy ju¿ rzucisz siê z krzykiem do nóg nêdznego boga, którego czcisz.~ 
@3221 = ~Ciekawe... wracasz, pomimo mojego wczeœniejszego ostrze¿enia. To bêdzie ostatnie. Czego chcesz?~ 
@3222 = ~Zmieni³em zdanie. Nie chcê odchodziæ.~ ~Zmieni³am zdanie. Nie chcê odchodziæ.~
@3223 = ~Wci¹¿ chcê obejrzeæ grobowiec krasnoludzkiego w³adcy, który jest tutaj pochowany.~
@3224 = ~Nie, œmiertelniku, na to nie mogê pozwoliæ. Tylko nie mów, ¿e nie by³em wobec ciebie uczciwy, kiedy ju¿ rzucisz siê z krzykiem do nóg nêdznego boga, którego czcisz.~

//*************************************************************************
// Meilir Meilirion
@3250 = ~A wiêc... to ty zabi³eœ tych obrzydliwych nieumar³ych, którzy zamieszkali w tych korytarzach, poradzi³eœ sobie z moimi pu³apkami i wreszcie omin¹³eœ moich stra¿ników.... jestem pod wra¿eniem.~ ~A wiêc... to ty zabi³aœ tych obrzydliwych nieumar³ych, którzy zamieszkali w tych korytarzach, poradzi³aœ sobie z moimi pu³apkami i wreszcie ominê³aœ moich stra¿ników.... jestem pod wra¿eniem.~
@3251 = ~To nie by³o takie trudne.~
@3252 = ~Ale mi stra¿nicy. Nie strzegli ciê zbyt dobrze.~
@3253 = ~TWOICH stra¿ników? Kim jesteœ?~
@3254 = ~Ha! To ty tak twierdzisz. Obserwowa³em ciê, m³ode Dzieciê Bhaala, a ty musisz jeszcze odnaleŸæ wyjœcie z tego miejsca. Nie, nie fatyguj siê – drzwi za tob¹ s¹ zamkniête.~
@3255 = ~Kim¿e ty jesteœ, ¿eby mnie tak zamykaæ? Masz mnie wypuœciæ!~
@3256 = ~Twoja wolnoœæ bêdzie zale¿a³a od twojego zachowania oraz odpowiedzi, które mi udzielisz, Dzieciê. A wiêc, którym z potomstwa Bhaala jesteœ?~
@3257 = ~Jestem <CHARNAME>.~
@3258 = ~To ty jesteœ Ÿród³em ca³ego zamieszania na Wybrze¿u Mieczy, czy¿ nie? Tak, mo¿e i jestem martwy, ale nie jestem te¿ g³uchy. W jakim celu ciê tu przys³ano? Czy mo¿e tak z w³asnej woli chcesz sobie z³upiæ kilka grobowców? Te wszystkie szkielety i ghasty w korytarzach po drodze, to w³aœnie tacy niedoszli rabusie grobowców, którzy liczyli na szybki i ³atwy zarobek. Chcesz do nich do³¹czyæ?~
@3259 = ~Byæ mo¿e w swoim czasie, jeœli sam siê na to zdecydujê. Co jeszcze mo¿esz mi zaoferowaæ?~ ~Byæ mo¿e w swoim czasie, jeœli sama siê na to zdecydujê. Co jeszcze mo¿esz mi zaoferowaæ?~
@3260 = ~Mocne s³owa, krasnoludzie. Mo¿esz je czymœ poprzeæ?~
@3261 = ~Mo¿e siê przekonamy?~
@3262 = ~Nic. Mogê ci daæ jedynie œmieræ – b¹dŸ ¿ycie, je¿eli oka¿ê siê ³askawy.~
@3263 = ~A co z kul¹?~
@3264 = ~Ach! Zatem wreszcie przechodzimy do tego – chcesz Kulê Breaki.~
@3265 = ~Tak. Gdzie ona jest?~
@3266 = ~Nie, krasnoludzie – JA nie chcê tej kuli – wys³ano mnie, abym j¹ zdoby³.~ ~Nie, krasnoludzie – JA nie chcê tej kuli – wys³ano mnie, abym j¹ zdoby³a.~
@3267 = ~Nie wydaje mi siê, by mówienie ci o tym by³o bezpieczne. Nie, z ca³¹ pewnoœci¹ nie jest. Nie mam zamiaru ofiarowaæ tak wielkiej mocy komuœ takiemu jak ty. Mo¿esz odejœæ.~
@3268 = ~WYS£ANO ciê, aby j¹ zdobyæ? Kto ciê wys³a³? I dlaczego?~
@3269 = ~Nie musisz tego wiedzieæ. Po prostu oddaj mi kulê i pójdê w swoj¹ stronê.~
@3270 = ~S³ysza³eœ o Angharadzie Ognistow³osej? Nie, raczej nie. A o Garalialu Geltaracie?~
@3271 = ~Nie wydaje mi siê, by oddanie ci jej tak po prostu by³o bezpieczne. Nie, z ca³¹ pewnoœci¹ nie jest. Nie mam zamiaru ofiarowaæ tak wielkiej mocy komuœ takiemu jak ty. Mo¿esz odejœæ.~
@3272 = ~Geltarath, zdradziecki Harfiarz? Tak, znam go. Spêdzi³ tu kiedyœ trochê czasu – rozstaliœmy siê w nieprzyjaznych stosunkach i on wie, ¿eby lepiej tu nie wracaæ. Kim jest Angharada Ognistow³osa?~
@3273 = ~Jego kobiet¹. To ona chce kulê.~
@3274 = ~W jakim celu?~
@3275 = ~Aby pomóc w oswobodzeniu wioski Pentyrch od mieszkaj¹cych tam nieumar³ych.~
@3276 = ~Nie, twój powód nie jest wystarczaj¹co dobry. Zatrzymam kulê. Nie mam zamiaru ofiarowaæ tak wielkiej mocy komuœ takiemu jak ty. Mo¿esz odejœæ.~
@3277 = ~Chcesz naprawiæ to, co zrobi³ ten g³upi thayski mag? Przy twojej reputacji to brzmi zbyt piêknie, by by³o prawdziwe. Zatrzymam kulê. Nie mam zamiaru udostêpniaæ tak wielkiej mocy osobie takiej, jak ty. Mo¿esz wyjœæ.~
@3278 = ~Chcesz naprawiæ to, co zrobi³ ten g³upi thayski mag? Zastanawiam siê tylko, po co Angharadzie Ognistow³osej ta kula. Ale... mam ju¿ doœæ prowadzenia gierek z ka¿d¹ band¹ awanturników, którzy po¿¹daj¹ bogactwa tylko dla siebie. A ty przychodzisz z jedynym s³usznym powodem, dla którego móg³bym siê rozstaæ z kul¹, a twoja reputacja sugeruje, ¿e byæ mo¿e mówisz prawdê.~
@3279 = ~Proszê, weŸ klucz do mojego grobowca i miejmy to ju¿ za sob¹.~
@3280 = ~Twoja reputacja nie jest zbyt przychylna, <CHARNAME>, czy¿ nie? A ty twierdzisz, ¿e chcesz naprawiæ to, co zrobi³ ten g³upi thayski mag? Pomimo swojej ewidentnej arogancji potrafisz czyniæ dobrze, kiedy nadejdzie taka potrzeba. Powinienem to dok³adnie przemyœleæ... ale mam ju¿ doœæ prowadzenia gierek z ka¿d¹ band¹ awanturników, którzy po¿¹daj¹ bogactwa tylko dla siebie. A ty przychodzisz z jedynym s³usznym powodem, dla którego móg³bym siê rozstaæ z kul¹.~
@3281 = ~Jestem – by³em – Meilir z Meilirionu, krasnoludzkiego domu pod Górami G³êbokiego Skrzyd³a.~
@3282 = ~Jesteœ wiêc daleko od domu, duchu.~
@3283 = ~To prawda... daleko od domu... bardzo daleko. Tak d³ugo z dala od domu...~
@3284 = ~Dlaczego zosta³eœ pochowany tutaj? Góry G³êbokiego Skrzyd³a musz¹ byæ ze sto mil st¹d.~
@3285 = ~Jesteœ stra¿nikem magicznej kuli?~
@3286 = ~Bli¿ej dwustu mil, m³ody poszukiwaczu przygód. Wyjawisz swe imiê duchowi starego krasnoluda?~ ~Bli¿ej dwustu mil, m³oda poszukiwaczko przygód. Wyjawisz swe imiê duchowi starego krasnoluda?~
@3287 = ~Nie mam na to czasu. Szukam magicznej kuli – wiesz, gdzie siê znajduje?~
@3288 = ~Ach! To ty jesteœ Ÿród³em ca³ego zamieszania na Wybrze¿u Mieczy, czy¿ nie? Tak, mo¿e i jestem martwy, ale nie jestem te¿ g³uchy. W jakim celu ciê tu przys³ano? Czy mo¿e tak z w³asnej woli chcesz sobie z³upiæ kilka grobowców? Te wszystkie szkielety i ghasty w korytarzach po drodze, to w³aœnie tacy niedoszli rabusie grobowców, którzy liczyli na szybki i ³atwy zarobek. Chcesz do nich do³¹czyæ?~
@3289 = ~Wola³bym nie. Co jeszcze mo¿esz mi zaoferowaæ?~ ~Wola³abym nie. Co jeszcze mo¿esz mi zaoferowaæ?~
@3290 = ~*chichocze* S³uszna odpowiedŸ, <CHARNAME>. Co jeszcze mogê zaoferowaæ? Opowieœæ o szczêœciu i g³upocie, jeœli tylko zechcesz jej wys³uchaæ.~
@3291 = ~Chyba znajdê na to czas.~
@3292 = ~Jak d³ugo ci to zajmie?~
@3293 = ~Tyle ile potrzeba i nie d³u¿ej. Czy mam zaczynaæ?~
@3294 = ~By³em jednym z najbogatszych krasnoludów w Przesmyku Vilhon, a dorobi³em siê zupe³nie uczciwie, choæ w doœæ niecodzienny sposób. Przeczesywa³em star¹, krasnoludzk¹ kopalniê w poszukiwaniu nowej ¿y³y rudy mitrylu – a je¿eli nie nowej, to przynajmniej takiej, z której mo¿na by jeszcze coœ wydobyæ – wtem mój kilof wyda³ dziwny, g³uchy dŸwiêk na jednej ze œcian. Bywa³em w tej kopalni od lat, ale nie przypomina³em sobie ¿adnych historii o wydr¹¿onych tunelach, ten konkretny szyb zna³em jak w³asn¹ kieszeñ.~
@3295 = ~Kontynuuj.~
@3296 = ~Od³upa³em delikatnie fragment œciany skalnej i wybi³em dziurê w sam raz tak¹, bym zdo³a³ siê przez ni¹ przecisn¹æ. Rozumiesz, nie by³em przekonany o stablinoœci tej ska³y. Przeczo³ga³em siê przez tê dziurê do ogromnej komory, wsta³em, ponios³em pochodniê i spojrza³em prosto w oko smoka. Wszyscy s³yszeliœmy plotki i opowieœci o smoczych pieczarach, maj¹cych istnieæ w Górach G³êbokiego Skrzyd³a, ale ja naprawdê tak¹ znalaz³em. Prawie zgin¹³em na miejscu.~
@3297 = ~Och, ten smok – b³êkitny – by³ od dawna martwy, ale raczej siê nad tym nie zastawiasz, gdy na jakiegoœ natrafisz. Minê³o sporo czasu, zanim znowu zapuœci³em siê do tej smoczej pieczary. By³em ustawiony – mia³em bogactwo, o jakim nawet nigdy nie œni³em.~
@3298 = ~I?~
@3299 = ~Cieszy³em siê ¿yciem. Podró¿owa³em przez Przesmyk Vilhon w luksusie i wygodzie, zamieszka³em w Hlondeth. Krasnolud zawsze pozostanie krasnoludem – na pocz¹tku nie potrafi³em oddaliæ siê od zbytnio Gór G³êbokiego Skrzyd³a i jaskiñ, rozumiesz. Stopniowo, im bardziej poznawa³em Przesmyk Vilhon, tym mocniej narasta³o we mnie zami³owanie do wêdrowania i ostatecznie z Gór G³êbokiego Skrzyd³a przyby³em do Ormath oraz G³êbokiego Przesmyku, a potem przez Góry Œnie¿ne a¿ do Riatavin. Nigdzie nie zostawa³em zbyt d³ugo; tyle jeszcze by³o do zobaczenia, a ja mia³em œrodki na te podró¿e.~
@3300 = ~W Riatavin trafi³em na karawanê zmierzaj¹c¹ do Saradush, Zamku Tethyr, na Kupiecki Trakt, do Athkatli i dalej na pó³noc. Z³ota mia³em tyle, ile zdo³a³em nosiæ przy sobie, ale mój zapas powoli siê wyczerpywa³, dlatego do³¹czy³em do karawany jako ochroniarz. Krasnolud rzadko kiedy rozstaje siê ze swoim toporem; to by³a jedyna rzecz, której nie potrafi³bym zostawiæ. W³aœnie topór by³ jednym z moich pierwszych nabytków za smocze z³oto, zosta³ wykuty przez najlepszego krasnoludzkiego kowala w Przesmyku. Czeka³em rok, a¿ go wykuje.~
@3301 = ~Co dzia³o siê po do³¹czeniu do karawany?~
@3302 = ~Zbli¿aliœmy siê ju¿ do Zamku Tethyr, gdy napotkaliœmy karawanê wychodz¹c¹ z Calimshanu. W tej karawanie by³y krasnoludy – niewolnicy, skuci i zwi¹zani – wpad³em w sza³. Szczêœcie wci¹¿ mi sprzyja³o, bo wszyscy calishyccy stra¿nicy z wyj¹tkiem trzech le¿eli martwi, zanim zdali sobie sprawê, co ich zaatakowa³o. Przejêliœmy karawanê i ruszyliœmy na zachód w kierunku Zazesspuru, gdzie sprzedaliœmy calishyckie towary – kupcy githyanki kupi¹ wszystko, jeœli im siê wmówi, ¿e to niebywa³a okazja! – wynajêliœmy amnijski okrêt, aby dostaæ siê do Murann, gdzie ci wyzwoleni niewolnicy zamierzali do³¹czaæ do krasnoludzkiego klanu.~
@3303 = ~Ju¿ wtedy by³em gotowy wracaæ do domu, ale trzeciego dnia ¿eglugi w statek uderzy³ potê¿ny sztorm, który zniós³ nas na brzeg nieopodal Pentyrchu.~
@3304 = ~Ach, wiêc tak tu trafi³eœ. A co ze smoczym skarbem w Hlondeth?~
@3305 = ~Ostatecznie przyby³ do Pentyrchu wiele miesiêcy póŸniej – pod œcis³¹ ochron¹ stra¿y – ale to nie jest najwa¿niejsza czêœæ tej opowieœci. Pod gór¹ by³y jaskinie, które okaza³y siê bardzo pomocne. Zabraliœmy siê wiêc do ich rozbudowy, aby sta³y siê domem odpowiednim dla rasy krasnoludzkiej. Wtedy nie by³o tu ¿adnej ludzkiej wioski, a korytarze Meldorarth poszerza³y siê i zape³nia³y mieszkañcami, gdy coraz wiêcej krasnoludów s³ysz¹c o tym miejscu przybywa³o tu i zostawa³o na dobre.~
@3306 = ~Pewnego dnia pokaza³ siê w Meldorarth wêdrowny bard i opowiedzia³ historiê wspania³ego skarbu skradzionego przez zielon¹ smoczycê, która powinna ju¿ le¿eæ od dawna martwa, gdzieœ w Potoku Giganta. Oczywiœcie uwierzy³em w to wszystko i nied³ugo potem wyruszy³em ze spor¹ kompani¹, aby znaleŸæ i odzyskaæ ten skarb.~
@3307 = ~Uwierzy³eœ w to?~
@3308 = ~To ci¹gnie siê zbyt d³ugo, nie mam na to czasu. Szukam magicznej kuli – wiesz, gdzie siê znajduje?~
@3309 = ~Mam spore podejrzenia, ¿e zaklêcie Zauroczenia mia³o tu swój udzia³. To nie by³ ¿aden bard, ale wtedy o tym nie wiedzieliœmy. Dotarliœmy do Potoku Giganta ze sporym baga¿em niezbyt szczêœliwych przygód po drodze. Pewnie nie bêdzie dla ciebie zaskoczeniem, ¿e znaleŸliœmy równie¿ le¿e smoczycy, ale jej samej daleko by³o do œmierci – po prostu przebywa³a daleko od domu – ale nie doœæ daleko jak dla nas. Akurat w dniu naszego przybycia, postanowi³a wróciæ.~
@3310 = ~Rozpêta³a siê walka, w której smoczyca rozszarpa³a na strzêpy prawie ca³¹ kompaniê, zanim dosz³a do wniosku, ¿e pozostali mog¹ j¹ dopaœæ, zanim ona dopadnie ich. Opuœci³a pole walki, aby zagoiæ rany, my w³asne te¿ opatrzyliœmy; spustoszyliœmy smoczy skarbiec i zabraliœmy z niego prawie wszystko, ale gorzko za to zap³aciliœmy. Hlondeth i Góry G³êbokiego Skrzyd³a ju¿ przesta³y byæ dla nas domem, wynajêliœmy wiêc karawanê oraz stra¿ i wróciliœmy do Meldorarth.~
@3311 = ~A co z bardem?~
@3312 = ~Jak umar³eœ? Co sta³o siê ze skarbem?~
@3313 = ~Wszystko w swoim czasie. Nied³ugo po naszym powrocie do Meldorarth, bard pojawi³ siê ponownie. Jakoœ spodziewa³em siê tego, dlatego poleci³em wypatrywaæ jego przybycia. Zosta³ przyprowadzony do wielkiej sali i wtedy us³yszeliœmy od niego ca³¹ prawdê: chcia³, abyœmy zdobyli dla niego ten skarb, a w szczególnoœci po¿¹da³ sporego, niebiesko-czerwonego diamentu zwanego Kul¹ Breaki.~
@3314 = ~Ach.~
@3315 = ~Ha! A zatem kula jest w twoim posiadaniu. W³aœnie jej szuka³em.~ ~Ha! A zatem kula jest w twoim posiadaniu. W³aœnie jej szuka³am.~
@3316 = ~On by³ nekromant¹ – ju¿ nie pamiêtam jego imienia – kula zosta³a zaklêta moc¹, której chcia³ u¿yæ. Odmówi³em i wrzuci³em go do lochów; pamiêæ o straconych kompanach by³a wci¹¿ silna, chcia³em zemsty. Dwa dni póŸniej zwisa³ przywi¹zany za rêce z urwiska nad portem, zostawi³em go tam na powoln¹ œmieræ.~
@3317 = ~Nie wzi¹³em pod uwagê jego mocy, myœla³em, ¿e nie jest w stanie nic zrobiæ, zawieszony jako ¿er dla wron. A on zdo³a³ rzuciæ na mnie kl¹twê wycieñczaj¹cej choroby i bardzo powolnej œmierci. D³ugo czeka³em na œmieræ – wiele lat – wpierw trac¹c wzrok, potem s³uch, a wreszcie dopad³ mnie parali¿ – a przez ca³y ten czas mój umys³ by³ wci¹¿ aktywny i œwiadomy.~
@3318 = ~Myœla³em – mia³em nadziejê – ¿e wpadnê w ob³êd, uwiêziony we w³asnej czaszce uderzaj¹c œlepo w jej œciany, ale jego kl¹twa by³a na to zbyt wyrafinowana i utrzymywa³a mnie przy zdrowych zmys³ach, podczas gdy moje cia³o powoli rozpada³o siê na kawa³ki, tak jak liœcie spadaj¹ z drzew jesieni¹. Moi pobratymcy mieli wiele lat, aby zaprojektowaæ i wybudowaæ moj¹ kryptê – jedn¹ z najlepszych kiedykolwiek stworzonych przez krasnoludy na Wybrze¿u Mieczy! – ale nie wiedzia³em o tym. Ostatecznie nawet kl¹twa nie mog³a d³u¿ej utrzymywaæ mnie przy ¿yciu, umar³em wiêc i powsta³em ponownie jako zagubiona dusza, uwiêziona na wieki w tym miejscu.~
@3319 = ~Ale wszystkie kl¹twy maj¹ swój s³aby punkt, prawda? Nie mo¿na jej jakoœ odwróciæ lub zdj¹æ?~
@3320 = ~Nie by³o nikogo, kto móg³by zatrzymaæ kl¹twê tego nekromanty?~
@3321 = ~<CHARNAME>, myœlisz, ¿e nie próbowa³em?! By³em niezwykle bogaty, wys³a³em goñców po ca³ym Faerunie w poszukiwaniu pomocy; wœród szarlatanów, znachorów, kleryków, magów, proroków i druidów nie by³o nikogo, kto by zdo³a³ cokolwiek zdzia³aæ! Zgni³em i umar³em.~
@3322 = ~Ale wszystkie kl¹twy maj¹ swój s³aby punkt, prawda?~
@3323 = ~Ten nekromanta mia³ mnóstwo czasu, by wszystko przemyœleæ; moj¹ jedyn¹ pociech¹ jest to, ¿e jego œmieræ by³a równie d³uga. Wisia³ tam przez prawie miesi¹c, zanim pad³ z g³odu i pragnienia, a stara³ siê – jak usilnie siê stara³! – uwolniæ. Myœla³em, ¿e w swoich wysi³kach runie na dó³ razem z ca³ym urwiskiem. Lecz tak, kl¹twa mo¿e zostaæ zdjêta i mogê umrzeæ w pokoju. Muszê oddaæ kulê Nieumar³emu, Który Powsta³ – gdybym tylko wiedzia³, gdzie takiego znaleŸæ!~
@3324 = ~By³em nieumar³y... lecz powsta³em ponownie z tamtego stanu na ten œwiat.~ ~By³am nieumar³a... lecz powsta³am ponownie z tamtego stanu na ten œwiat.~
@3325 = ~Po prostu daj mi kulê – potrzebujê jej.~
@3326 = ~Ty...! Ale... ty! Ale... jak?~
@3327 = ~Zapewne znane ci s¹ Pu³apki ¯yj¹cych w jaskiniach niedaleko st¹d. Ktoœ z krasnoludzkiego ludu musia³ je tam umieœciæ; przekroczyæ je mo¿e tylko ktoœ jednoczeœnie nie ¿ywy i nie martwy – uda³o mi siê min¹æ pu³apki z pomoc¹ by³ego nekromanty i nigdy wiêcej nie chcê czegoœ takiego powtarzaæ.~
@3328 = ~Tobie – uda³o siê przekroczyæ te pu³apki? Gdybym mia³ g³os, œmia³bym siê – to ja sam skonstruowa³em te pu³apki, aby strzeg³y grobów moich pobratymców, a ten nekromanta musia³ o tym wiedzieæ. Och, ale by³ z niego spryciarz; niemal podziwiam go za ten pokrêtny zwrot w jego kl¹twie. Zatem Kula Breaki jest prawnie twoja – i wreszcie, WRESZCIE – mogê spocz¹æ w pokoju!!! Proszê, weŸ ten klucz do mojej krypty i niech bóg, jakiegokolwiek czcisz, na zawsze ci b³ogos³awi!!!~
@3329 = ~Ach! Tak szybko do rzeczy. Szukasz Kuli Breaki? Dlaczego?~
@3330 = ~Wys³ano mnie, abym j¹ zdoby³.~ ~Wys³ano mnie, abym j¹ zdoby³a.~
@3331 = ~S³ysza³eœ o Angharadzie Ognistow³osej? Albo o Garalialu Geltaracie?~
@3332 = ~Nie wydaje mi siê, by oddanie ci jej tak po prostu by³o bezpieczne. Nie, z ca³¹ pewnoœci¹ nie jest. Nie mam zamiaru ofiarowaæ tak wielkiej mocy komuœ takiemu jak ty. Mo¿esz odejœæ, ale twój powrót nie bêdzie tu mile widziany.~
@3333 = ~Geltarath, zdradziecki Harfiarz? Tak, znam go. Spêdzi³ tu kiedyœ trochê czasu – rozstaliœmy siê w nieprzyjaznych stosunkach i on wie, ¿eby lepiej tu nie wracaæ. Kim jest Angharada Ognistow³osa?~
@3334 = ~Jego kobiet¹. To ona chce kulê.~
@3335 = ~Ostrzega³em, ¿e twoja obecnoœæ nie bêdzie tu mile widziana po raz drugi.~

