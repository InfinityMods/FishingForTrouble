//*************************************************************************
// Kupcy
@3920 = ~Imradim to najlepsze miejsce w pó³nocnej czêœci pustyni Calim, nie uwa¿asz?~
@3921 = ~Nie mam czasu na pogaduszki, czas to pieni¹dz!~
@3922 = ~Och, czas na odpoczynek w Wodnej Krawêdzi. Nie mogê siê doczekaæ chwili, kiedy wyp³uczê sobie z ust smak piasku i py³u.~
@3923 = ~To by³a najgorsza burza piaskowa, jak¹ widzia³em od lat. Jednej nocy straciliœmy dwa wozy i dziewiêæ koni.~
@3924 = ~To miejsce jest wrzodem na ty³ku cywilizacji. Nie mogê siê doczekaæ, kiedy znów bêdê na dobrej, czystej pustyni.~
@3925 = ~Kogó¿ my tu mamy? Szukasz mo¿e pracy? Potrzebujê paru silnych stra¿ników podczas mojej kolejnej wyprawy na po³udnie.~
@3926 = ~Ile na tym zarobiê?~
@3927 = ~Pradê mówi¹c, nie mogê siê doczekaæ, kiedy opuszczê to miejsce i udam siê gdzieœ, gdzie jest ch³odniej.~
@3928 = ~Nie, dziêkujê.~
@3929 = ~Mo¿emy o tym porozmawiaæ pod koniec podró¿y.~
@3930 = ~¯a³osna wymówka. Pewnie chcesz mnie oszukaæ. Nie interesuj¹ mnie takie warunki.~
@3931 = ~Niech tak bêdzie. Nie wszyscy s¹ odporni na upa³y. Mo¿e nie by³oby z ciebie wielkiego po¿ytku.~
@3932 = ~Nigdy nie ma pod rêk¹ dobrego ko³odzieja, kiedy jest potrzebny. Stary Ali by³ najlepszym w promieniu wielu mil, ale przeszed³ na emeryturê i nie ma w Imradim nikogo, kto móg³by go zast¹piæ.~
@3933 = ~Obcy w mieœcie! Przynajmniej ja nie widzia³em nigdy wczeœniej w Imradim twojej twarzy!~
@3934 = ~Te¿ widzê ciê pierwszy raz. Sk¹d przybywasz?~
@3935 = ~Te¿ widzê ciê pierwszy raz. A teraz odczep siê i zostaw mnie w spokoju.~
@3936 = ~Przykro mi, nie mam czasu na rozmowy.~
@3937 = ~Z Calimportu. To moja druga wyprawa przez pustyniê. Niebawem ruszam w drogê powrotn¹ i dlatego skupujê towary. Masz mo¿e coœ do sprzedania?~
@3938 = ~Nic, co mia³oby dla ciebie jak¹kolwiek wartoœæ.~
@3939 = ~Hê?! Ta wrogoœæ jest zupe³nie niepotrzebna!~
@3940 = ~Có¿, mimo wszystko warto by³o zapytaæ.~
