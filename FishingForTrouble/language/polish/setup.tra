// Populacja Pentyrchu
// Ch³opcy
@1950 = ~Hej, panie! Czy mogê zobaczyæ twój miecz? No, tylko na chwilê! Proszê?~
@1951 = ~Hej, pani! Czy mogê zobaczyæ twój miecz? No, tylko na chwilê! Proszê?~
@1952 = ~Fajno... jesteœ prawdziwym poszukiwaczem przygód, panie?~
@1953 = ~Jesteœ prawdziw¹ pani¹ poszukiwaczem przygód – na pewno!~
@1954 = ~Mój tata mówi, ¿e móg³by za³atwiæ wszystkie okropieñstwa z obiema rêkami zawi¹zanymi na plecach i nie potrzebowalibyœmy ¿adnych parszywych poszukiwaczy przygód.~
@1955 = ~Kiedy dorosnê, te¿ bêdê zabija³ demony!~
@1956 = ~Mój tata mówi, ¿e nie zostanie d³u¿ej w tej zachlanej mieœcinie. Co to jest „zachlany”?~
@1957 = ~Mogê iœæ z tob¹, panie?~
@1958 = ~Lubiê ciê, pani... jesteœ mi³a!~

// Dziewczêta
@1980 = ~Moja mama mówi, ¿e jesteœ bardzo przystojny!~
@1981 = ~Moja mama mówi, ¿e jesteœ naprawdê œliczna!~
@1982 = ~Uch!!! Jesteœ brzydki i œmierdz¹cy!~ ~Uch!!! Jesteœ brzydka i œmierdz¹ca!~
@1983 = ~By³eœ kiedyœ tak przestraszony? Ja bym by³a! Nienawidzê paj¹ków. I wê¿y.~ ~By³aœ kiedyœ tak przestraszona? Ja bym by³a! Nienawidzê paj¹ków. I wê¿y.~
@1984 = ~Kiedy dorosnê, wyjdê za ciebie za m¹¿!~
@1985 = ~Kiedy dorosnê, chcê byæ tak¹ dam¹ jak ty!~
@1986 = ~IdŸ sobie! Nie chcê z tob¹ rozmawiaæ!~
@1987 = ~Ale z ciebie brudas! *chichocze*~

// Mieszkañcy domów
@1990 = ~Mam nadziejê, ¿e nie masz zamiaru zostaæ – akurat muszê wyjœæ.~
@1991 = ~Kim jesteœ? To prywatny dom – proszê, wyjdŸ teraz.~
@1992 = ~Nie jestem pewien, czy potrafiê ci pomóc, przyjacielu.~ ~Nie jestem pewien, czy potrafiê ci pomóc, przyjació³ko.~
@1993 = ~Zaproponowa³bym ci miejsce w mojej ³odzi, tylko ja mam pe³n¹ za³ogê.~
@1994 = ~Ach, zabi³bym za kufelek najlepszego piwa starego Morvansa.~
@1995 = ~Jestem naprawdê wdziêczny, ¿e wybi³eœ tych nieumar³ych i ocali³eœ wioskê. Zaczyna³em myœleæ, ¿e ju¿ nigdy nie bêdziemy mogli wróciæ!~ ~Jestem naprawdê wdziêczny, ¿e wybi³aœ tych nieumar³ych i ocali³aœ wioskê. Zaczyna³em myœleæ, ¿e ju¿ nigdy nie bêdziemy mogli wróciæ!~
@1996 = ~Nie ma to jak w domu. Proszê, usi¹dŸ ze mn¹, jeœli chcesz.~
@1997 = ~Wiêc mówisz, ¿e w latarni by³ prawdziwy demon? Ho ho! Cieszê siê, ¿e nigdy go nie ujrza³em!~
@1998 = ~By³eœ ju¿ w Niebieskiej Harpii? Maj¹ najlepsze piwo po tej stronie od Wrót Baldura!~ ~By³aœ ju¿ w Niebieskiej Harpii? Maj¹ najlepsze piwo po tej stronie od Wrót Baldura!~
@1999 = ~¯adnego ³owienia dzisiaj – i ¿adnego ³owienia jutro. Siedzê przez kilka dni na l¹dzie.~

// Mieszkanki domów
@2000 = ~Mój m¹¿ jest teraz na morzu. PrzyjdŸ, proszê, innym razem.~
@2001 = ~Ja wiem, ¿e mogê ci ufaæ – ale mój m¹¿ nie, a jest zazdrosnym typem. Na twoim miejscu bym st¹d wysz³a.~
@2002 = ~Jestem pewna, ¿e mo¿emy szybko znaleŸæ ci kogoœ mi³ego do o¿enku, jeœli chcesz.~
@2003 = ~Nie widzia³eœ mojej córki biegaj¹cej po okolicy, co? To taki ma³y urwis w czerwonej sukience i z niebiesk¹ wst¹¿k¹ we w³osach.~ ~Nie widzia³aœ mojej córki biegaj¹cej po okolicy, co? To taki ma³y urwis w czerwonej sukience i z niebiesk¹ wst¹¿k¹ we w³osach.~
@2004 = ~Dzieci trzeba pilnowaæ – zawsze wpadaj¹ z jednych k³opotów w kolejne.~
@2005 = ~Jeœli znowu z³apiê mojego syna w koszu na ryby, trzasnê go w ³eb mokrym œledziem, a co.~
@2006 = ~Musisz porozmawiaæ z moim mê¿em – pewnie jest w Niebieskiej Harpii, jak zwykle.~
@2007 = ~S³ysza³eœ, ¿e m³oda Aine gra na pianinie? Mówiê ci, jest tak dobra, ¿e mog³aby graæ w wielkich domach Athkatli!~ ~S³ysza³aœ, ¿e m³oda Aine gra na pianinie? Mówiê ci, jest tak dobra, ¿e mog³aby graæ w wielkich domach Athkatli!~
@2008 = ~W ogóle nie jestem przekonana do tego barda, Dervala. Najpewniej zrobi m³odej Aine dzieciaka, a potem j¹ zostawi.~
@2009 = ~Za parê minut sama wyjdê do Niebieskiej Harpii. Muszê tylko u³o¿yæ w³osy, zanim wyjdê.~

// Mê¿czyŸni
@2020 = ~Po³owy id¹ teraz dobrze. Wczoraj mia³em ca³¹ sieæ, a jak¿e!~
@2021 = ~Nie krêc¹ siê tu ju¿ ¿adni paskudni nieumarli, wszystko dziêki tobie!~
@2022 = ~Popatrzcie no! Bohaterowie!~
@2023 = ~Wygl¹da na to, ¿e pogoda utrzyma siê na jakiœ czas. W zesz³ym roku urwa³o mi maszt podczas sztormu i ledwie prze¿y³em. Nie chcê, by to siê powtórzy³o!~
@2024 = ~Wkrótce ruszymy na po³ów. Teraz, kiedy Pentyrch jest wolny od tych przera¿aj¹cych ghuli, ponownie mo¿emy bez strachu wyp³ywaæ na morze. Chcesz te¿ pójœæ? Wystarczy dla wszystkich!~
@2025 = ~Dziêki za propozycjê, ale obawiam siê choroby morskiej.~
@2026 = ~Ble! Ju¿ sam zapach wywo³uje u mnie odruch wymiotny!~
@2027 = ~Nie dziœ, dziêkujê.~
@2028 = ~Taa, mo¿e masz racjê. I tak mi³y z ciebie goœæ – jesteœ mile widziany, by siê ze mn¹ zabraæ, jeœli jednak zechcesz spróbowaæ si³ w ³owieniu.~ ~Taa, mo¿e masz racjê. I tak mi³a z ciebie babka – jesteœ mile widziana, by siê ze mn¹ zabraæ, jeœli jednak zechcesz spróbowaæ si³ w ³owieniu.~
@2029 = ~Taa... i pewnie wymiotowa³byœ przez ca³y po³ów przy tym swoim biednym, delikatnym ¿o³¹dku!~ ~Taa... i pewnie wymiotowa³abyœ przez ca³y po³ów przy tym swoim biednym, delikatnym ¿o³¹dku!~
@2030 = ~Dziêki, przyjaciele! Spotkajmy siê póŸniej w gospodzie, a postawiê wam kilka kolejek!~
@2031 = ~Brzmi nieŸle!~
@2032 = ~Nie, dziêki – nie pijê brudnego, œmierdz¹cego ryb¹ piwa.~
@2033 = ~Mo¿e póŸniej.~
@2034 = ~Do zobaczenia wiêc! To tam za rogiem.~
@2035 = ~Jak sobie chcesz, ty brudny najemniku. Po prostu chcia³em byæ mi³y.~
@2036 = ~Ostatnimi czasy po³owy tutaj by³y bardzo kiepskie. Nie³atwo zarobiæ na ¿ycie ubogiemu rybakowi.~
@2037 = ~Nie zwracaj uwagi na zapach... coœ z ostatniego po³owu musia³o na mnie zostaæ.~
@2038 = ~Ca³y dzieñ na ³odziach... wiêc teraz wypijê sobie piwko lub dwa, co nie?~
@2039 = ~Wiesz, ¿e tydzieñ temu moj¹ ³odzi¹ natknêliœmy siê na ogromn¹ bestiê? Ale przetrwaliœmy, oj tak. Helm musia³ nad nami czuwaæ.~
@2040 = ~Ej¿e... czemu tak na mnie zezujesz? A mo¿e to ja zezujê na ciebie... Trudno powiedzieæ po tych wszystkich piwach.~
@2041 = ~Nie mam pojêcia, gdzie poznika³y te wszystkie wredne ryby. Ostatnio sieci wci¹¿ mi zostaj¹ puste, a inni ³owi¹ co nie miara.~
@2042 = ~*wzdycha* Mówiê ci, jak ja bym chcia³ tak machn¹æ palcami i wyczarowaæ sobie trochê ryb. Ostatnio po³owy s¹ piekielnie trudne.~
@2043 = ~Aaaach, bogowie na pewno maj¹ coœ do mnie. Pracujê i pracujê, a jesteœmy wci¹¿ biedni, biedni, biedni!~

// Kobiety
@2050 = ~Hehe... wracam wiêc do patroszenia ryb, tak jest! Przynajmniej dziêki tobie mo¿emy w nocy twardo spaæ.~
@2051 = ~Mój bohaterze! Jeœli chcesz, to mam dla ciebie ciep³e, przytulne miejsce... *chichocze*~ ~Moja bohaterko! Jeœli chcesz, to mam dla ciebie ciep³e, przytulne miejsce... *chichocze*~
@2052 = ~Ooo... co za mi³a oferta!~
@2053 = ~OdejdŸ ode mnie, ty brudna ladacznico!~
@2054 = ~Byæ mo¿e zajrzê potem.~
@2055 = ~HAAA!!! Mam poddasze pe³ne siana, na którym mo¿na spaæ... *chichocze*~
@2056 = ~*PLASK!* NIE nazywaj mnie ladacznic¹! Wybebeszê ci wnêtrznoœci nie gorzej ni¿ rybom.~
@2057 = ~Minê³y tygodnie, odk¹d mogliœmy spaæ spokojnie w nocy – nawet nie masz pojêcia, jakie to wspania³e uczucie!~
@2058 = ~Przynajmniej te wszystkie biedne zmar³e dusze spoczywaj¹ w pokoju, dziêki tobie. Kto by pomyœla³? – stare krasnoludzkie ruiny pod Pentyrchem!~
@2059 = ~<CHARNAME>! Potrzebujesz kogoœ jeszcze do swojej dru¿yny – kogoœ kto noc¹ ogrzeje twoje ³ó¿ko?~
@2060 = ~Razem z wê¿ami i paj¹kami...?~
@2061 = ~IdŸ precz, ty bezwstydnico!~
@2062 = ~Tylko jeœli masz piêcioletnie doœwiadczenie i papierek na to.~
@2063 = ~AAA!!! Przepraszam – w³aœnie sobie przypomnia³am – mam zbyt wiele do zrobienia tutaj, w Pentyrchu. Mo¿e w przysz³ym roku, je¿eli znów bêdziesz têdy przechodziæ.~
@2064 = ~Tylko ¿artowa³am! Mam nadziejê, ¿e nastêpny ankheg, którego spotkasz, wypali ci oczy!~
@2065 = ~Ooo – ale¿ miêœnie! Wysz³abym za ciebie, gdybym nie by³a mê¿atk¹!~
@2066 = ~Ooo, <CHARNAME>! – mój lœni¹cy bohaterze! Chcesz, ¿ebym pobawi³a siê twoim mieczem...? *chichocze*~
@2067 = ~No proszê, moja piêkna m³oda damo – to dopiero ostra propozycja!~
@2068 = ~OdejdŸ ode mnie, brudna przekupko! Zabierz swoje plugawe myœli gdzie indziej!~
@2069 = ~Nie, dziêkujê – mój miecz nale¿y tylko do mnie.~
@2070 = ~HAAA!!! Za³o¿ê siê, ¿e to te¿ dobry miecz – ale mój m¹¿ by mnie zabi³, gdyby zobaczy³, ¿e bawiê siê broni¹ innego mê¿czyzny! *chichocze*~
@2071 = ~*PLASK!* Nie ma nic bardziej plugawego od udawania prawego i patrzenia z góry na innych! Mam nadziejê, ¿e jakaœ syrena pozbawi ciê twoich klejnotów!~

// Rybakowa
@2080 = ~Mówiê ci... Mój m¹¿ gada, ¿e ca³y dzieñ ³owi,... ale ja pewna jestem, ¿e ukrywa siê w Niebieskiej Harpii!~
@2081 = ~Potrafiê umyæ i wypatroszyæ rybê szybciej, ni¿ ty mrugn¹æ okiem... ka¿dego dnia mo¿esz znaleŸæ nasze dobra na targu w Nashkel, a jak¿e.~
@2082 = ~Helmie, czuwaj nad nami! W³aœnie wiesza³am to przeklête pranie i jak myœlisz, gdzie siê podzia³y moje dzieci? Zniknê³y! Niech ja je dorwê...~
@2083 = ~B¹dŸ ostro¿ny w tych okolicach, ostrzegam ciê! Jest tam demon na wolnoœci!~
@2084 = ~Wiêc... to ty rozwi¹za³eœ problem z nieumar³ymi, tia? Co... Czekasz na oklaski? Tutaj ich nie dostaniesz!~ ~Wiêc... to ty rozwi¹za³aœ problem z nieumar³ymi, tia? Co... Czekasz na oklaski? Tutaj ich nie dostaniesz!~
@2085 = ~Na co siê gapisz?! Trzymaj swoje ga³y w oczodo³ach albo poczujesz mój wa³ek!~
@2086 = ~Widzê ciê, gnomie! Tacy jak ty to tylko pijane œmiecie, zawsze zatrzymujecie mi mê¿a po knajpach przez ca³¹ noc tymi waszymi opowieœciami! Wynoœ siê!~
@2087 = ~Ty tam! Przechadzasz siê w tej fikuœnej zbroi! Dlaczego nie zrobisz czegoœ po¿ytecznego i nie z³apiesz wszystkich ulicznych z³odziei i rabusiów, co?!~

// Rybak
@2090 = ~Ostatnimi czasy po³ów tutaj by³ niezwykle ubogi. Biednemu rybakowi naprawdê ciê¿ko zarobiæ na ¿ycie.~
@2091 = ~Nie zwracaj uwagi na zapach... to tylko czêœæ ostatniego po³owu przenios³a siê na mnie.~
@2092 = ~Ca³y dzieñ na ³odzi... Chyba udam siê do Niebieskiej Harpii na piwko lub dwa, co?~
@2093 = ~Wiesz, ¿e w zesz³ym tygodniu spotkaliœmy ogromnego stwora na mojej ³odzi rybackiej? Oczywista, ¿eœmy prze¿yli. Helm musi nad nami czuwaæ.~
@2094 = ~Hej, wiêc... dlaczego patrzysz na mnie tak zezowato, hm?~
@2095 = ~Nie mam pojêcia, gdzie podzia³y siê te wredne ryby. Ostatnio sieci bywaj¹ puste.~
@2096 = ~*wzdycha* Mówiê ci, jak ja bym chcia³ tak machn¹æ palcami i wyczarowaæ sobie trochê ryb. Ostatnio po³owy s¹ piekielnie trudne.~
@2097 = ~Aaaach, bogowie na pewno maj¹ coœ do mnie. Pracujê i pracujê, a jesteœmy wci¹¿ biedni, biedni, biedni!~

