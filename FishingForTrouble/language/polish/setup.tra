//*************************************************************************
// Mordaran Skalna Piêœæ
@2750 = ~Otrzyma³eœ rozkazy, wiêc nie zawracaj mi g³owy i je wykonaj.~ ~Otrzyma³aœ rozkazy, wiêc nie zawracaj mi g³owy i je wykonaj.~
@2751 = ~O co chodzi z t¹ Warowni¹ Cerendora? Mój czarodziej mówi, ¿e w³aœnie z niej przyby³eœ.~ ~O co chodzi z t¹ Warowni¹ Cerendora? Mój czarodziej mówi, ¿e w³aœnie z niej przyby³aœ.~
@2752 = ~To prawda. Wtargnê³a tam du¿a grupa szukaj¹cych guza dzikusów ze wzgórz.~
@2753 = ~A jednak uciek³eœ stamt¹d. Jak?~ ~A jednak uciek³aœ stamt¹d. Jak?~
@2754 = ~W³aœciwie nie. Byliœmy we wnêtrzu Warowni, kiedy nast¹pi³ atak. Szybko podniesiono most zwodzony, ale stra¿nicy nie zauwa¿yli w porê grupy, która przesz³a przez mur przy rzecznym urwisku. Powinniœcie chyba byli wyci¹æ te drzewa.~
@2755 = ~Mów dalej. Pewnie po³¹czyliœcie si³y z moimi ludŸmi?~
@2756 = ~Równie¿ nie. Nie podobali nam siê i nic nas nie obchodzili. Napastników nie interesowa³o, z kim walcz¹ i przyparli nas do muru w Grobowcu Cerendora. Trzech twoich zaatakowa³o tych zbójów od ty³u i ocali³o nam skórê.~
@2757 = ~Hm. A co sta³o siê póŸniej?~
@2758 = ~Albo napastnicy zdobyli to, po co przyszli, albo opór okaza³ siê dla nich zbyt silny. Opuœcili most i zniknêli tak szybko, jak siê pojawili.~
@2759 = ~Co z moimi ludŸmi?~
@2760 = ~Siedmiu martwych, dwudziestu trzech rannych, w tym oœmiu ciê¿ko. Zgodzi³em siê zanieœæ ci wieœci w zamian za otrzyman¹ od nich pomoc. Teraz uwa¿am ten d³ug za sp³acony.~ ~Siedmiu martwych, dwudziestu trzech rannych, w tym oœmiu ciê¿ko. Zgodzi³am siê zanieœæ ci wieœci w zamian za otrzyman¹ od nich pomoc. Teraz uwa¿am ten d³ug za sp³acony.~
@2761 = ~Mmm. Potwierdzam, d³ug sp³acony. Dok¹d siê teraz wybierasz?~
@2762 = ~Do Athkatli.~
@2763 = ~Do Wrót Baldura.~
@2764 = ~Trzymaj siê z dala od wozów, a mo¿esz skorzystaæ z naszej ochrony podczas podró¿y.~
@2765 = ~Zgoda.~
@2766 = ~Zostaniemy na noc, ale rano ruszymy w swoj¹ drogê. Wozy podró¿uj¹ dla nas zbyt wolno.~
@2767 = ~Jak chcesz. Darlesson, weŸ dwunastu ludzi i idŸcie do Warowni Cerendora. Zróbcie co w waszej mocy, ¿eby zapanowaæ nad sytuacj¹.~
@2768 = ~Do roboty. Ty. Powiedzia³eœ swoje. Jeœli zamierzasz zostaæ z karawan¹, nie wychylaj siê i pamiêtaj, nie zbli¿aj siê do wozów.~ ~Do roboty. Ty. Powiedzia³aœ swoje. Jeœli zamierzasz zostaæ z karawan¹, nie wychylaj siê i pamiêtaj, nie zbli¿aj siê do wozów.~
@2769 = ~Kim jesteœ i czego chcesz?~
@2770 = ~Nazywam siê <CHARNAME>. A ty, jak mniemam, jesteœ Mordaran Skalna Piêœæ?~
@2771 = ~Najpierw powiedz mi, kim ty jesteœ. Chcê mieæ pewnoœæ, ¿e rozmawiam z w³aœciw¹ osob¹.~
@2772 = ~Doprawdy? Rozejrzyj siê woko³o i rozwa¿, czy nie chcesz inaczej zadaæ swojego pytania.~
@2773 = ~Skoro tak stawiasz sprawê... Nazywam siê <CHARNAME>. A ty, jak mniemam, jesteœ Mordaran Skalna Piêœæ?~
@2774 = ~No i co? Czego chcesz?~
@2775 = ~Mam informacjê, ¿e przewozisz wielki ³adunek czarnego lotosu dla Athkatli i Wrót Baldura.~
@2776 = ~Dopiero co przybyliœmy z Warowni Cerendora. Us³ysza³em, jak Czerwoni Stra¿nicy mówili, ¿e ta karawana zmierza do Athkatli i Wrót Baldura. Liczê, ¿e moglibyœmy podró¿owaæ pod jej os³on¹ przynajmniej do Nashkel.~ ~Dopiero co przybyliœmy z Warowni Cerendora. Us³ysza³em, jak Czerwoni Stra¿nicy mówili, ¿e ta karawana zmierza do Athkatli i Wrót Baldura. Liczê, ¿e moglibyœmy podró¿owaæ pod jej os³on¹ przynajmniej do Nashkel.~
@2777 = ~Ach tak? Czerwona Kompania! Chcê tu widzieæ ich trupy w ci¹gu dwóch minut!!!~
@2778 = ~Coœ takiego. Mów szybko lub giñ w mêczarniach. Sk¹d o tym wiesz?~
@2779 = ~Od Czerwonego Maga o nazwisku Ailoth Tam.~
@2780 = ~Piszcza³ jak zarzynana œwinia, prawda? Ma nie po kolei w g³owie. Co robiliœcie w Warowni Cerendora? I jak wydobyliœcie z niego informacje?~
@2781 = ~Czekaliœmy na transport w dó³ rzeki, kiedy warownia zosta³a zaatakowana przez du¿y oddzia³ bandytów i dzikusów.~
@2782 = ~Równie¿ nie. Nie podobali nam siê i nic nas nie obchodzili. Napastników nie interesowa³o, z kim walcz¹ i przyparli nas do muru w Grobowcu Cerendora. Trzech twoich zaatakowa³o tych zbójów od ty³u i ocali³o nam skórê.~
@2783 = ~Albo napastnicy zdobyli to, po co przyszli, albo opór okaza³ siê dla nich zbyt silny. Opuœcili most i zniknêli tak szybko, jak siê pojawili.~
@2784 = ~Siedmiu martwych, dwudziestu trzech rannych, w tym oœmiu ciê¿ko. Zgodzi³em siê zanieœæ ci wieœci w zamian za otrzyman¹ od nich pomoc.~ ~Siedmiu martwych, dwudziestu trzech rannych, w tym oœmiu ciê¿ko. Zgodzi³am siê zanieœæ ci wieœci w zamian za otrzyman¹ od nich pomoc.~
@2785 = ~Tak wielu? Na zêby Talosa! Megred, weŸ dwunastu ludzi i idŸcie do Warowni Cerendora. Zróbcie co w waszej mocy, ¿eby zapanowac nad sytuacj¹.~
@2786 = ~Do roboty. Ty. Czego chcesz w zamian za swoj¹ przys³ugê?~
@2787 = ~Z³ota. Bêdzie ci brakowaæ ludzi po odes³aniu tego kontyngentu z powrotem do Warowni, a my potrafimy zadbaæ o siebie.~
@2788 = ~Tak jak zadbaliœcie tam? Hmm. Oferujê wam takie same warunki p³acy jak reszcie, a zasada numer jeden brzmi „Trzymaæ siê z dala od wozów”. Zrozumiano?~
@2789 = ~Tak.~
@2790 = ~Po prostu zapamiêtaj – we œnie czy na jawie, masz siê trzymaæ z dala od wozów. Ja najpierw zabijam, a potem zadajê pytania.~
@2791 = ~Bêdzie ciê to kosztowaæ. Nie wo¿ê ze sob¹ pasa¿erów.~
@2792 = ~Ile chcesz?~
@2793 = ~Mo¿emy na siebie zapracowaæ. Wygl¹da na to, ¿e przyda³oby ci siê kilku ludzi.~
@2794 = ~Jak powiedzia³em, nie biorê pasa¿erów. Masz dwie minuty na opuszczenie obozu i radzê ci nie wracaæ. Najpierw zabijamy, póŸniej zadajemy pytania.~
@2795 = ~Twoje uszy s³ysz¹ wiêcej, ni¿ powinny. le siê to mo¿e dla ciebie skoñczyæ. Sk¹d wiesz, ¿e potrzebujê ludzi? Daj mi jeden powód, dla którego nie mia³bym ciê zabiæ tu i teraz.~
@2796 = ~Po Chmurnych Szczytach w³óczy siê plemiê dzikusów ze wzgórz. Zaatakowali Warowniê Cerendora, ale zostali odparci. Byliœmy tam wtedy. Bêdzie ci potrzebna ka¿da pomoc, jak¹ zdo³asz pozyskaæ.~
@2797 = ~Hm. Naprawdê? Ca³e plemiê?~
@2798 = ~Tak to wygl¹da³o. Mo¿e dwa plemiona wspó³pracuj¹ce ze sob¹.~
@2799 = ~Z³ota. Bêdzie ci brakowaæ ludzi po odes³aniu tego kontyngentu z powrotem do Warowni, a my, jak ju¿ mówi³em, potrafimy zadbaæ o siebie.~ ~Z³ota. Bêdzie ci brakowaæ ludzi po odes³aniu tego kontyngentu z powrotem do Warowni, a my, jak ju¿ mówi³am, potrafimy zadbaæ o siebie.~
@2800 = ~Hm. Racja. Oferujê wam takie same warunki p³acy jak reszcie, a zasada numer jeden brzmi „Trzymaæ siê z dala od wozów”. Zrozumiano?~
@2801 = ~Hm. Myœlê, ¿e nie umiesz rachowaæ. Jesteœ pewien, ¿e potrafisz walczyæ?~ ~Hm. Myœlê, ¿e nie umiesz rachowaæ. Jesteœ pewna, ¿e potrafisz walczyæ?~
@2802 = ~Zapytaj ludzi w Warowni Cerendora.~
@2803 = ~Przypuszczam, ¿e nied³ugo otrzymam odpowiedŸ. Oferujê wam takie same warunki p³acy jak reszcie, a zasada numer jeden brzmi „Trzymaæ siê z dala od wozów”. Zrozumiano?~
@2804 = ~Pozostawi to was z przetrzebionymi si³ami i bez ochrony mojego maga. Czy to rozs¹dne? Z powodu uszkodzeñ wozu zostaniemy tu jeszcze przez kilka dni.~

//*************************************************************************
// Hansol Ynnilross
@2850 = ~Tak? Czym mogê ci s³u¿yæ?~
@2851 = ~Z tego co mi wiadomo, zatrzyma³a siê tu niejaka Eildarena Colver, Harfiarz?~
@2852 = ~Gdzie jest Eildarena Colver, hm? Mów szybko!~
@2853 = ~Eildarena Colver, tak? Nie przypominam sobie nikogo nosz¹cego takie miano. Brzmi jak nazwisko elfki. Dlaczego jej szukasz?~
@2854 = ~Mam dla niej wiadomoœæ od Garaliala Geltaratha.~
@2855 = ~Ach, od niego. Tak, by³a tutaj. Wynajê³a pokój na górze, tak jak zwykle.~
@2856 = ~Gdzie jest teraz?~
@2857 = ~Nie ma tu nikogo o tym nazwisku. A teraz idŸ sobie. Nie przepadamy w Piwnym Dworze za takimi jak ty.~
@2858 = ~Chcesz skoñczyæ z podciêtym gard³em, ty nêdzny psie?~
@2859 = ~Proszê bardzo. Ale wtedy nie dowiesz siê...~
@2860 = ~Czego?~
@2861 = ~W którym jest pokoju.~
@2862 = ~Mówi³eœ, ¿e jej tu nie ma!~
@2863 = ~Nieprawda. Powiedzia³em tylko, ¿e nie ma tu nikogo o tym nazwisku. Ta informacja bêdzie ciê trochê kosztowaæ.~
@2864 = ~Ile?~
@2865 = ~5 sztuk z³ota. Wiêcej nie dostaniesz, ty chciwy draniu.~
@2866 = ~500 sztuk z³ota. Piêæset b³yszcz¹cych, piêknych monet z dobrego athkatlañskiego czerwonego z³ota.~
@2867 = ~Ty chciwy, z³odziejski pêtaku!~
@2868 = ~Ty chciwy, z³odziejski pêtaku! Nie mam tylu pieniêdzy.~
@2869 = ~Z ¿ywego czy martwego, za mniej nie wyci¹gniesz ode mnie tej informacji. Wróæ tu, kiedy zbierzesz wystarczaj¹co du¿o z³ota.~
@2870 = ~Jeden chciwy, z³odziejski pêtak zawsze rozpozna drugiego. Z ¿ywego czy martwego, za mniej nie wyci¹gniesz ode mnie tej informacji.~
@2871 = ~Sam j¹ znajdê.~ ~Sama j¹ znajdê.~
@2872 = ~Proszê. Ud³aw siê.~
@2873 = ~Bardzo w¹tpiê.~
@2874 = ~Rozumiem, ¿e masz ju¿ z³oto?~
@2875 = ~Nie.~
@2876 = ~Po prostu powiedz, co wiesz.~
@2877 = ~Wczoraj j¹ st¹d zabrano. Pod murami Zachodniej Bramy w Dzielnicy granicznej znajduje siê enklawa Eldath. Tam j¹ trzymaj¹.~
@2878 = ~Pójdê tam i j¹ odszukam.~
@2879 = ~Czym mogê ci s³u¿yæ? Napitkiem? Kwater¹? Mów prêdko, jestem zajêtym cz³owiekiem!~
@2880 = ~A co masz?~
@2881 = ~W tej chwili niczym.~
@2882 = ~Wszystko jest napisane na tablicy za moimi plecami.~
@2883 = ~Jak sobie ¿yczysz.~

