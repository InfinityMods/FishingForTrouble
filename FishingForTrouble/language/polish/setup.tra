// Aiesha
@4530 = ~Mmmm. Obcy z Pó³nocy. Czego tutaj szukacie?~
@4531 = ~Szukam Aieshy. Pashan powiedzia³, ¿e tu j¹ znajdê.~
@4532 = ~Kim¿e jesteœ?~
@4533 = ~Kim ty jesteœ, stara jêdzo?~
@4534 = ~Ja jestem Aiesh¹. Zawsze by³am Aiesh¹ i nadal bêdê Aiesh¹. Tak.~
@4535 = ~Dobrze, Aiesho. Wiesz coœ na temat po³o¿enia Tygrysiego oka?~
@4536 = ~Pashan to dobry syn, czy¿ nie? Powiedzia³ ci prawdê. Jestem Aiesh¹.~
@4537 = ~Powiedzia³ mi, ¿e znasz po³o¿enie Tygrysiego oka.~
@4538 = ~Aaa. Wielu po¿¹da tej roœliny, lecz tylko nieliczni j¹ zdobywaj¹. Mmm. Do czego jest ci potrzebna? Pragniesz bogactwa? Mi³oœci? S³awy? Mówi siê, ¿e przy jej pomocy mo¿na zdobyæ to wszystko.~
@4539 = ~Mam na tyle rozumu, ¿eby nie wierzyæ we wszystko, co us³yszê. Nie, nie po¿¹dam jej dla bogactwa, s³awy ani mi³oœci. Potrzebujê jej dla kogoœ innego.~
@4540 = ~Dla kogoœ innego, hê? Aiesha s³ysza³a ju¿ wczeœniej tê œpiewkê. Do czego potrzebuje jej ten inny?~
@4541 = ~Jego siostra zapad³¹ na ¿ó³t¹ chorobê. On uwa¿a, ¿e roœlina pomo¿e j¹ wyleczyæ.~
@4542 = ~Kim jest ten inny? Aiesha chce wiedzieæ.~
@4543 = ~Nazywa siê Garalial Geltarath.~
@4544 = ~Nie, Aiesha nie zna tego imienia, jednak w twym g³osie s³yszy prawdê. Czy pragniesz roœliny tak bardzo, ¿e zaryzykujesz dla niej gniew nocnych myœliwych?~
@4545 = ~Nocni myœliwi? Kim oni s¹?~
@4546 = ~Tak, jeœli bêdzie to konieczne.~
@4547 = ~To duchy nawiedzaj¹ce miejsce, w którym roœnie Tygrysie oko. Rozedr¹ na strzêpy ka¿dego, kto siê do nich zbli¿y.~
@4548 = ~Nieumarli? Ich masz na myœli?~
@4549 = ~Tak, znam to s³owo. Nieumarli. Nazywani s¹ te¿ zombie. Przynieœ Aieshy puchar wody z Dusz Umar³ych, a otrzymasz jej pomoc.~
@4550 = ~Dusze Umar³ych? Co to takiego?~
@4551 = ~Nie chcia³byœ chyba, ¿eby Aiesha zanadto u³atwi³a ci sprawê? Wróæ, kiedy nape³nisz puchar.~ ~Nie chcia³abyœ chyba, ¿eby Aiesha zanadto u³atwi³a ci sprawê? Wróæ, kiedy nape³nisz puchar.~
@4552 = ~Aiesha jest stara, tak. Niektórzy nazywaj¹ j¹ jêdz¹, ale Aiesha siê za tak¹ nie uwa¿a. Kiedy bêdzie starsza, mo¿e wtedy stanie siê jêdz¹.~
@4553 = ~Wiesz coœ na temat Tygrysiego oka?~
@4554 = ~Zdobêdê to wszystko bez pomocy jakiegoœ kwiatka.~
@4555 = ~Wiêc kwiat ma byæ dla kogoœ innego, hê? Aiesha s³ysza³a ju¿ wczeœniej tê œpiewkê. Do czego potrzebuje go ten inny?~
@4556 = ~Do stworzenia mikstury, która uleczy jego siostrê z ¿ó³tej choroby. A teraz mów. Wiesz, gdzie go szukaæ, czy nie?~
@4557 = ~Kim jest ten inny? Aiesha chce to wiedzieæ, zanim odpowie na twoje pytanie.~
@4558 = ~Nie, Aiesha nie zna tej osoby i wyczuwa w twoich s³owach fa³sz. Czy pragniesz roœliny tak bardzo, ¿e zaryzykujesz dla niej gniew nocnych myœliwych?~
@4559 = ~Nocni myœliwi, co? Jakoœ mnie to nie przera¿a.~
@4560 = ~Tak, znam to s³owo. Nieumarli. Ale to niew³aœciwe s³owo. Aiesha nie zna w³aœciwego. Przynieœ Aieshy puchar wody z Dusz Umar³ych, a otrzymasz jej pomoc.~
@4561 = ~Jeœli rzeczywiœcie jesteœ taki przebieg³y, przybyszu, znajdziesz odpowiedŸ. Wróæ, kiedy nape³nisz puchar.~ ~Jeœli rzeczywiœcie jesteœ taka przebieg³a, przybyszko, znajdziesz odpowiedŸ. Wróæ, kiedy nape³nisz puchar.~
@4562 = ~Czy nape³ni³eœ ju¿ puchar?~ ~Czy nape³ni³aœ ju¿ puchar?~
@4563 = ~Jeszcze nie.~
@4564 = ~Och, uda³o ci siê nape³niæ puchar. Aiesha czuje jego zapach. Poka¿ mi.~
@4565 = ~Oto i on. Do czego ci potrzebna ta cuchn¹ca woda?~
@4566 = ~Aiesha ma dla niej wiele zastosowañ, jednak nie maj¹ one zwi¹zku z tob¹. Jak siê nazywasz, przybyszu?~ ~Aiesha ma dla niej wiele zastosowañ, jednak nie maj¹ one zwi¹zku z tob¹. Jak siê nazywasz, przybyszko?~
@4567 = ~Jestem <CHARNAME>.~
@4568 = ~Zachowam moje imiê dla siebie, jêdzo. Mów, gdzie jest Tygrysie oko.~
@4569 = ~Aiesha ju¿ powiedzia³a, ¿e nie jest jêdz¹. Dlaczego nadal j¹ obra¿asz?~
@4570 = ~Co za ró¿nica jak ciê nazywam? Gdzie jest ten przeklêty kwiat?~
@4571 = ~Ale¿ jesteœ niecierpliwy, przybyszu. Nie wró¿y ci to najlepiej. Dobrze wiêc. Aiesha wie, ¿e musi ci pomóc, ¿eby twój niechciany cieñ przesta³ padaæ na Imradim. Znajdziesz Tygrysie oko w jaskini nad domem Gadila.~ ~Ale¿ jesteœ niecierpliwa, przybyszko. Nie wró¿y ci to najlepiej. Dobrze wiêc. Aiesha wie, ¿e musi ci pomóc, ¿eby twój niechciany cieñ przesta³ padaæ na Imradim. Znajdziesz Tygrysie oko w jaskini nad domem Gadila.~
@4572 = ~Ach! W koñcu! Bywaj, stara jêdzo.~
@4573 = ~Nie ok³amuj mnie, stara jêdzo. By³em tam. Wejœcie jest zablokowane.~ ~Nie ok³amuj mnie, stara jêdzo. By³am tam. Wejœcie jest zablokowane.~
@4574 = ~Nie przyjrza³eœ mu siê wystarczaj¹co uwa¿nie. Aiesha mówi, ¿e jaskinia jest otwarta i Aiesha nie k³amie.~ ~Nie przyjrza³aœ mu siê wystarczaj¹co uwa¿nie. Aiesha mówi, ¿e jaskinia jest otwarta i Aiesha nie k³amie.~
@4575 = ~Przekonamy siê. Jeœli to nieprawda, zap³acisz ¿yciem.~
@4576 = ~Po co te groŸby, przybyszu? Nie boli ciê od nich g³owa? Daj ju¿ Aieshy spokój. Da³a ci odpowiedŸ na twoje pytanie i nie ma ochoty wiêcej z tob¹ rozmawiaæ.~ ~Po co te groŸby, przybyszko? Nie boli ciê od nich g³owa? Daj ju¿ Aieshy spokój. Da³a ci odpowiedŸ na twoje pytanie i nie ma ochoty wiêcej z tob¹ rozmawiaæ.~
@4577 = ~Có¿, <CHARNAME>, pomog³eœ Aieshy, a teraz Aiesha pomo¿e tobie. Kwiat Tygrysiego oka nie roœnie w œwietle, lecz w ciemnoœci. Mo¿na go znaleŸæ wy³¹cznie w jaskini za domem Gadila. Dostañ siê do miejsca, z którego bêdziesz móg³ ujrzeæ Imradim z lotu ptaka, a odnajdziesz kwiat.~ ~Có¿, <CHARNAME>, pomog³aœ Aieshy, a teraz Aiesha pomo¿e tobie. Kwiat Tygrysiego oka nie roœnie w œwietle, lecz w ciemnoœci. Mo¿na go znaleŸæ wy³¹cznie w jaskini za domem Gadila. Dostañ siê do miejsca, z którego bêdziesz mog³a ujrzeæ Imradim z lotu ptaka, a odnajdziesz kwiat.~
@4578 = ~Zdobêdê go i pójdê w swoj¹ stronê. Dosz³y mnie jednak s³uchy, ¿e wejœcie do jaskini jest zablokowane.~
@4579 = ~By³em tam. Wejœcie jest zablokowane. Jak do niej wejœæ?~ ~By³am tam. Wejœcie jest zablokowane. Jak do niej wejœæ?~
@4580 = ~Aiesha mówi, ¿e jaskinia jest teraz otwarta, <CHARNAME>. Aiesha siê nie myli. Zanim jednak pójdziesz, Aiesha chcia³aby prosiæ ciê o przys³ugê.~
@4581 = ~Czego potrzebujesz? Pomogê ci, jeœli bêdê w stanie.~
@4582 = ~Nie mam na to czasu. Muszê dostarczyæ Geltarathowi Tygrysie oko.~
@4583 = ~Aiesha potrzebuje szaty, ale Aiesha nie mo¿e chodziæ. Pashan to dobry syn, ale nie potrafi skupiæ siê na jednej rzeczy d³u¿ej ni¿ mgnienie oka. Adara, ¿ona Gadila, jest utalentowan¹ tkaczk¹. Aieshy przyda³oby siê od niej trochê dobrego szafranu na now¹ szatê. Aiesha prosi³a Adarê o zrobienie takiej szaty, ale nie ma nikogo, kto móg³by j¹ odebraæ dla Aieshy.~
@4584 = ~I chcesz, ¿ebym to ja odebra³ tê szatê?~ ~I chcesz, ¿ebym to ja odebra³a tê szatê?~
@4585 = ~Jeœli <CHARNAME> ma chwilê czasu.~
@4586 = ~Przyniosê Aieshy – to znaczy tobie – now¹ szatê.~
@4587 = ~W dzisiejszych czasach wszyscy siê spiesz¹. Aiesha to rozumie i ¿yczy ci dobrej podró¿y.~
@4588 = ~Czy masz dla Aieshy now¹ szatê?~
@4589 = ~Oto ona.~
@4590 = ~Jesteœ dobry dla Aieshy. Aiesha dziêkuje ci i ma nadziejê, ¿e twojemu przyjacielowi uda siê uzdrowiæ siostrê.~ ~Jesteœ dobra dla Aieshy. Aiesha dziêkuje ci i ma nadziejê, ¿e twojemu przyjacielowi uda siê uzdrowiæ siostrê.~
@4591 = ~Jesteœ dobry dla Aieshy. Aiesha ma dla ciebie pewn¹ radê. Zapytaj Stra¿nika o jego d³oñ.~ ~Jesteœ dobra dla Aieshy. Aiesha ma dla ciebie pewn¹ radê. Zapytaj Stra¿nika o jego d³oñ.~
@4592 = ~Kim jest Stra¿nik?~
@4593 = ~Aiesha mówi, ¿e siê dowiesz. Nie zapomnij zadaæ mu tego pytania. Aiesha ma te¿ nadziejê, ¿e twojemu przyjacielowi uda siê uzdrowiæ siostrê.~

