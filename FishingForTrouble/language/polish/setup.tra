// Kap³an Helma w Warowni Cerendora
@1700 = ~Czy potrzebujesz leczenia?~ 
@1701 = ~Tak.~
@1702 = ~Nie.~ 
@1703 = ~Jak mogê ci pomóc?~
@1704 = ~Co mo¿esz mi powiedzieæ o Czerwonych Magach i ich stra¿nikach?~ 
@1705 = ~Czy mo¿esz nas uleczyæ?~
@1706 = ~Czy mo¿esz mnie uleczyæ?~
@1707 = ~¯egnaj.~ 
@1708 = ~Nie za du¿o. Przybyli wraz z ostatni¹ karawan¹ z Calimshanu i ju¿ tu zostali; zanim siê zorientowaliœmy, co siê dzieje, przejêli kontrolê nad warowni¹.~
@1709 = ~Czy te wydarzenia wp³ynê³y jakoœ na twoj¹ pracê?~ 
@1710 = ~Tak na co dzieñ, to nie. Ale na d³u¿sz¹ metê z ca³¹ pewnoœci¹ tak bêdzie. Mam nadziejê, ¿e w³adze Crimmoru prêdzej czy póŸniej zaczn¹ siê zastanawiaæ, co siê tu dzieje.~
@1711 = ~A nie mo¿esz skontaktowaæ siê ze swoj¹ œwi¹tyni¹?~
@1712 = ~Sam niedawno tu przyby³em, wiêc moja nieobecnoœæ nawet przez parê miesiêcy ich nie zdziwi. Ale jest jedna sprawa, która mo¿e ciê zainteresowaæ.~ 
@1713 = ~Mów dalej...~
@1714 = ~Jeden z obecnych tu Czerwonych Magów nie wygl¹da na tak pewnego siebie, jak pozostali. Chyba to wszystko go trochê przerasta, mo¿e to jego pierwsze takie zadanie.~ 
@1715 = ~Jak siê nazywa?~
@1716 = ~Ailoth Tam. Jest znacznie m³odszy od pozosta³ych.~
@1717 = ~Dziêki. Czy mo¿esz nas uleczyæ?~
@1718 = ~Dziêki. Czy mo¿esz mnie uleczyæ?~ 
@1719 = ~Dziêki. ¯egnaj.~
@1720 = ~Cieszê siê, ¿e prze¿y³eœ bitwê i w imiê Helma dziêkujê ci za pomoc.~ ~Cieszê siê, ¿e prze¿y³aœ bitwê i w imiê Helma dziêkujê ci za pomoc.~ 
@1721 = ~To nic takiego, garnizon by³ przygotowany do odbicia warowni.~ 
@1722 = ~Nie uda³oby siê to beze mnie.~
@1723 = ~Mo¿liwe, ale moja wdziêcznoœæ pozostaje niezmienna.~ 
@1724 = ~Proszê bardzo. Niewiele mikstur mam do zaoferowania, dopóki nie przybêdzie kolejna karawana z Athkatli.~

//*************************************************************************
// Kapitan stra¿y Warowni Cerendora
@1730 = ~Tak?~
@1731 = ~Jesteœ kapitanem stra¿y Warowni Cerendora?~
@1732 = ~Jeœli jesteœ kapitanem stra¿y, to chcê z tob¹ porozmawiaæ.~
@1733 = ~Jestem. W czym mogê ci pomóc?~
@1734 = ~Mo¿esz mi wyjaœniæ, co siê tu dzieje?~
@1735 = ~Co knuj¹ Czerwoni Magowie?~
@1736 = ~Nie jestem pewien, ale wygl¹da na to, ¿e Czerwoni Magowie i ich przyjaciele zamierzaj¹ wykorzystaæ Warowniê Cerendora jako punkt prze³adunkowy na swoim szlaku przemytniczym.~
@1737 = ~Dlaczego?~
@1738 = ~Sk¹d o tym wiesz?~
@1739 = ~Dlaczego? Sk¹d o tym wiem? Doszed³em do tego drog¹ dedukcji. Nie zostaje siê kapitanem Warowni, nie maj¹c mózgu!~
@1740 = ~Chêtnie wys³ucham twoich argumentów.~
@1741 = ~Rozejrzyjcie siê woko³o. Warownia Cerendora strze¿e jednej z prze³êczy przez Chmurne Szczyty. Kiedyœ by³a to jedna z g³ównych dróg przez góry, ale rosn¹ce rozmiary wozów ograniczy³y jej wykorzystanie.~
@1742 = ~Dlatego te¿ znajdujemy siê przy dobrze utrzymanej trasie, która nie jest zbytnio uczêszczana. Dziêki temu ju¿ z du¿ej odleg³oœci mo¿na dostrzec, kto zbli¿a siê z obu stron prze³êczy. Kontroluj¹c Warowniê Cerendora, kontroluje siê cenny posterunek w kluczowym punkcie jednego z Wielkich Szlaków Karawanowych Faerunu.~
@1743 = ~Warownia wci¹¿ jest w bardzo dobrym stanie i jest bardzo dogodna do obrony. Jest idealnym miejscem do przerzutu towarów, o których powinno wiedzieæ jak najmniej osób. Jeœli nowi „w³aœciciele” bêd¹ wystarczaj¹co sprytni, mog¹ tu prowadziæ normalny interes i nikt nie bêdzie podejrzewa³, co siê za tym kryje.~
@1744 = ~Dlaczego po prostu st¹d nie odejdziesz i nie doniesiesz o tym zwierzchnikom, ¿eby wróciæ z posi³kami i odbiæ Warowniê?~
@1745 = ~Ka¿dy, kto st¹d odejdzie i zg³osi siê do w³adz, mo¿e po¿egnaæ siê z ¿yciem. Jeœli nie swoim, to z ¿yciem jednego lub kliku swoich bliskich. I nie mówimy tu o szybkiej i czystej œmierci. Jeœli nie dosiêgnie go miecz, zrobi to magia.~
@1746 = ~Rozumiem. Co knuj¹ Czerwoni Magowie?~
@1747 = ~S¹dzê, ¿e przemycaj¹ wzd³u¿ Wybrze¿a Mieczy towary o wysokiej wartoœci i ma³ych rozmiarach.~
@1748 = ~Te towary o wysokiej wartoœci i ma³ych rozmiarach pochodz¹ z Calimshanu, prawda?~
@1749 = ~Moje ¿ycie jest dla mnie cenniejsze od swobody dyskusji na pewne tematy.~
@1750 = ~Ach. Czy by³byœ sk³onny dopomóc w... zwrocie... Warowni jej poprzednim w³aœcicielom?~
@1751 = ~Tchórz.~
@1752 = ~Tchórz, tak? A co powiesz na uwiêzienie w ma³ej klatce zawieszonej na murze warowni bez jedzenia, z du¿ym zapasem wody i bez ¿adnej ochrony przed pogod¹. Wiesz, ile czasu zajmuje umieranie w ten sposób?~
@1753 = ~Wiosn¹ usycha siê w ten sposób tygodniami, ca³y czas s³abn¹c z braku ruchu i przestrzeni. Szczêœciarze trafiaj¹cy tam zim¹ wytrzymuj¹ jakiœ tydzieñ, padaj¹c ofiar¹ pogody.~
@1754 = ~A mo¿e wola³byœ wróciæ pewnej nocy do domu i zastaæ tam szcz¹tki swojej rodziny, po¿artej przez likantropy? Nadal jestem dla ciebie tchórzem?~ ~A mo¿e wola³abyœ wróciæ pewnej nocy do domu i zastaæ tam szcz¹tki swojej rodziny, po¿artej przez likantropy? Nadal jestem dla ciebie tchórzem?~
@1755 = ~Có¿... Skoro tak to wygl¹da, cofam wypowiedziane s³owa. Czy by³byœ sk³onny dopomóc w... zwrocie... Warowni jej poprzednim w³aœcicielom?~
@1756 = ~Nie do mnie nale¿y decyzja, choæ jeœli otrzymam stosowne rozkazy, chêtnie je wykonam, jeœli rozumiesz, co mam na myœli.~
@1757 = ~S¹dzê, ¿e rozumiem, kapitanie. Spróbujê „zdobyæ” te rozkazy.~
@1758 = ~Wydaje mi siê, ¿e wszyscy dranie gryz¹ ziemiê. Byæ mo¿e jeden czy dwóch czai siê w jakimœ mrocznym k¹cie, ale ju¿ wkrótce do³¹cz¹ do swoich przyjació³.~
@1759 = ~Jesteœ pewien?~
@1760 = ~A to szkoda. Mia³em nadziejê na jeszcze odrobinê rzezi.~ ~A to szkoda. Mia³am nadziejê na jeszcze odrobinê rzezi.~
@1761 = ~Tak bardzo pewien, jak to mo¿liwe. Teraz muszê ciê jednak przeprosiæ. Chcê sprawdziæ, czy prze¿y³ mój sier¿ant i w jakim stanie s¹ moi ludzie.~
@1762 = ~Jak sobie ¿yczysz, kapitanie.~
@1763 = ~RzeŸ? Tak bardzo ciê ona ekscytuje? Mam tu martwych i rannych ¿o³nierzy, a ty nie mo¿esz siê doczekaæ dalszej „rzezi”...!~
@1764 = ~Mia³em porachunki z tymi Czerwonymi Magami i nie spodziewa³em siê, ¿e tak szybko je wyrównam.~ ~Mia³am porachunki z tymi Czerwonymi Magami i nie spodziewa³em siê, ¿e tak szybko je wyrównam.~
@1765 = ~Och, zamknij siê, stary durniu. Przynajmniej odzyska³eœ swoj¹ warowniê.~
@1766 = ~Tak... i muszê ze wstydem przyznaæ, ¿e potrzebowaliœmy przy tym twojej jak¿e chêtnie udzielonej pomocy. Teraz wybacz mi, ale muszê posprz¹taæ po tej „rzezi”.~
@1767 = ~Ciesz siê, ¿e wci¹¿ ¿yjesz, o wielu innych nie mo¿na tego powiedzieæ. Teraz wybacz mi, ale muszê posprz¹taæ po tej „rzezi”.~
@1768 = ~Moja rodzina wynagrodzi pañsk¹ lojalnoœæ, kapitanie.~
@1769 = ~Dziêkujê, pani Nalio, ale to zarz¹dca karawan pomóg³ nam przetrwaæ, kiedy warownia zosta³a przejêta. To jemu nale¿¹ siê podziêkowania.~
@1770 = ~Skoro tak mówisz. Uwa¿am, ¿e temu biedakowi przyda³aby siê pomoc.~

