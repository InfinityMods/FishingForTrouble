// Aine
@1850 = ~Cii! Gram.~
@1851 = ~Dzieñ dobry, panie. Mogê ci jakoœ pomóc?~ ~Dzieñ dobry, pani. Mogê ci jakoœ pomóc?~
@1852 = ~Czy to ty gra³aœ na pianinie, kiedy wszed³em?~ ~Czy to ty gra³aœ na pianinie, kiedy wesz³am?~
@1853 = ~Æwicz dalej grê, Aine.~
@1854 = ~Kim jesteœ?~
@1855 = ~W tej chwili nie, dziêkujê.~
@1856 = ~Oczywiœcie, panie, oczywiœcie.~ ~Oczywiœcie, pani, oczywiœcie.~
@1857 = ~Jestem córk¹ karczmarza Morvansa.~
@1858 = ~Jak ci na imiê?~
@1859 = ~„Córka karczmarza Morvansa”? Nie posiadasz imienia?~
@1860 = ~Och! Tak. Nazywam siê Aine.~
@1861 = ~Kto nauczy³ ciê graæ? I sk¹d masz pianino?~
@1862 = ~Derval uczy mnie gry. O pianino bêdziesz musia³ zapytaæ ojca – powiedzia³, ¿e to d³uga historia i mi jej nie opowie.~ ~Derval uczy mnie gry. O pianino bêdziesz musia³a zapytaæ ojca – powiedzia³, ¿e to d³uga historia i mi jej nie opowie.~
@1863 = ~Dobrze siê uczysz?~
@1864 = ~O to musisz zapytaæ Dervala, panie.~ ~O to musisz zapytaæ Dervala, pani.~

//*************************************************************************
// Derval
@1870 = ~Witaj ponownie, panie! ¯yczysz sobie znów pos³uchaæ Przygrywek?~ ~Witaj ponownie, pani! ¯yczysz sobie znów pos³uchaæ Przygrywek?~
@1871 = ~Tak, z mi³¹ chêci¹.~
@1872 = ~Eee, nie teraz. Mo¿e innym razem.~
@1873 = ~B³agam ciê, panie, b¹dŸ, proszê, cicho, kiedy pani gra.~ ~B³agam ciê, pani, b¹dŸ, proszê, cicho, kiedy pani gra.~
@1874 = ~Derval Cadarn, bard z Wybrze¿a Mieczy, Do us³ug, panie!~ ~Derval Cadarn, bard z Wybrze¿a Mieczy, Do us³ug, pani!~
@1875 = ~Derval Cadarn? Hmm. To imiê brzmi znajomo.~
@1876 = ~Nigdy o tobie nie s³ysza³em.~ ~Nigdy o tobie nie s³ysza³am.~
@1877 = ~Tak szczerze, to w¹tpiê, by ktokolwiek o mnie s³ysza³. Ale brzmi nieŸle, co?~
@1878 = ~Phi! A¿ za dobra ta prezentacja.~
@1879 = ~Brzmi, jakbyœ by³ idiot¹.~
@1880 = ~Nie potwierdzam, nie zaprzeczam.~
@1881 = ~Wiêc po co ta kwiecista prezentacja?~
@1882 = ~Wiêc po co to g³upie machanie czapk¹ i zmyœlone imiona?~
@1883 = ~Mam nadziejê, ¿e nie, panie. Wolê pozostaæ nieznanym, jeœli wiesz, co mam na myœli.~ ~Mam nadziejê, ¿e nie, pani. Wolê pozostaæ nieznanym, jeœli wiesz, co mam na myœli.~
@1884 = ~Och, bo to dobrze brzmi. Mimo wszystko i tak jestem kiepskim bardem.~
@1885 = ~Jesteœ...! Dobra, niewa¿ne. Czy to ty gra³eœ na pianinie, kiedy wszed³em przez drzwi?~ ~Jesteœ...! Dobra, niewa¿ne. Czy to ty gra³eœ na pianinie, kiedy wesz³am przez drzwi?~
@1886 = ~Nie, to by³a Aine. Dobrze gra, prawda? Jedyny problem jest taki, ¿e potrafi spamiêtaæ tylko po³owê.~
@1887 = ~Wiêc jeœli nasi goœcie ¿ycz¹ sobie ca³oœæ utworu, ja, Derval Cadarn, bard z Wybrze¿a Mieczy, zagram j¹ dla nich!~
@1888 = ~Wiêc przygotuj siê na wielkie zdumienie!!~
@1889 = ~Cii, moja s³odka... potem ci to wynagrodzê. Z ty³u jest bardzo wygodny strych, który bêdzie na to idealny. Teraz s³uchaj!~
@1890 = ~Jedn¹ chwilê... jak nazywa siê utwór?~
@1891 = ~Ach! Dobre pytanie. Tak naprawdê nie wiem – znalaz³em go na dalekim zachodzie wysp Moonshae. Nazywam go „Po-utwór Aine”.~
@1892 = ~Dziêkujê, Dervalu Cadarnie. Zdawa³o mi siê, ¿e tylko ja mam tendencje do bardzo kiepskich gier s³ownych, ale wygl¹da na to, ¿e bardzo siê myli³em. Graj dalej.~ ~Dziêkujê, Dervalu Cadarnie. Zdawa³o mi siê, ¿e tylko ja mam tendencje do bardzo kiepskich gier s³ownych, ale wygl¹da na to, ¿e bardzo siê myli³am. Graj dalej.~
@1893 = ~To dlatego, ¿e nauczy³eœ mnie tylko pierwszej czêœci!~
@1894 = ~To dlatego, ¿e nie mo¿esz zapamiêtaæ tej drugiej, moja s³odka.~
@1895 = ~Mê¿czyŸni! Nigdy nie uwierz¹, ¿e kobieta mo¿e byæ równie dobra jak oni i niech bogowie maj¹ w opiece, jeœli by³aby lepsza!~
@1896 = ~Czasem chcia³bym, abyœ by³a zamkniêta w labiryncie. Na zawsze.~

//*************************************************************************
// Karczmarz Morvans
@1900 = ~Dla ciebie moje towary maj¹ specjaln¹ cenê. Czy ¿yczysz sobie coœ kupiæ?~
@1901 = ~Rozmawia³em z twoj¹ córk¹, Aine. Rzek³a, i¿ nie powiesz jej, jak zdoby³eœ pianino.~ ~Rozmawia³am z twoj¹ córk¹, Aine. Rzek³a, i¿ nie powiesz jej, jak zdoby³eœ pianino.~
@1902 = ~Tak, dziêkujê.~
@1903 = ~Nie w tej chwili, dziêkujê.~
@1904 = ~Ach! Witam w Niebieskiej Harpii! Proszê, przyjaciele... usi¹dŸcie sobie.~
@1905 = ~Dziêkujê... odpoczynek bêdzie mile widziany.~
@1906 = ~Nie jesteœmy twoimi przyjació³mi. Prawie siê nie znamy.~
@1907 = ~Taki mam sposób wyra¿ania siê, rozumiesz... nie mia³em zamiaru ciê uraziæ.~
@1908 = ~Nie urazi³eœ mnie. Wybacz mi mój ostry ton – jestem po prostu trochê zmêczony podró¿¹.~ ~Nie urazi³eœ mnie. Wybacz mi mój ostry ton – jestem po prostu trochê zmêczona podró¿¹.~
@1909 = ~Nastêpnym razem bardziej uwa¿aj z tym swoim „sposobem wyra¿ania siê”.~
@1910 = ~Rozumiem. ¯yczysz sobie kupiæ coœ do picia albo sprzedaæ jakieœ przedmioty?~
@1911 = ~Tak.~
@1912 = ~Nie.~
@1913 = ~Jak mogê ci pomóc?~
@1914 = ~Dlaczego ta karczma nazywa siê „Niebieska Harpia”?~
@1915 = ~Co tu sprzedajesz?~
@1916 = ~Poprzedni w³aœciciel tak nazwa³ to miejsce. Powiedzia³, ¿e to osobisty ¿art, którego nikomu nie chcia³ opowiedzieæ. No, ale tego dnia, gdy sprzeda³ mi tê karczmê, bardzo siê spiliœmy i wyci¹gn¹³em to z niego.~
@1917 = ~No i?~
@1918 = ~Nie mam czasu na d³ugie historie. Co tu sprzedajesz?~
@1919 = ~A zatem, panie, powiedzia³, ¿e nazwa³ j¹ po swojej ¿onie, która tak d³ugo wrzeszcza³a jak harpia, póki nie zrobi³a siê niebieska na twarzy.~ ~A zatem, pani, powiedzia³, ¿e nazwa³ j¹ po swojej ¿onie, która tak d³ugo wrzeszcza³a jak harpia, póki nie zrobi³a siê niebieska na twarzy.~
@1920 = ~Och, no tak. To okropny ¿art.~
@1921 = ~Nie mam na to czasu. Co tu sprzedajesz?~
@1922 = ~Tak naprawdê, panie, to szczera prawda.~ ~Tak naprawdê, pani, to szczera prawda.~
@1923 = ~Jak mogê ci pomóc w takim razie?~
@1924 = ~Poniewa¿ to d³uga historia. Tak, tak – wiem. Prawda jest taka, ¿e nie jest to wcale tak d³uga historia. Powiedzia³em to tylko dlatego, by otoczyæ to wiêksz¹ tajemnic¹, gdy¿ zawsze chcia³a pianino, odk¹d us³ysza³a je w Piwnym Dworze w Athkatli.~
@1925 = ~Jak je zdoby³eœ?~
@1926 = ~Och. W takim razie nie za bardzo mnie to interesuje.~
@1927 = ~Kilka lat temu przeje¿d¿a³a têdy ma³a, ale dobrze uzbrojona i chroniona karawana, uciekaj¹ca przed konfliktem w Murann. Zapomnia³em nazwiska rodziny, ale byli szlachetnie urodzeni i mieli dom w Athkatli, gdzie mieli zamiar osi¹œæ.~
@1928 = ~Bezpiecznie przeszli przez Prze³êcz Ma³ego Zêba i byli zaraz na pó³noc od Imnescar, kiedy wpadli w pu³apkê, ju¿ drugi raz. Wczeœniej pokonali grupê bandytów, która zaatakowa³a ich, gdy skrêcili na Kupiecki Trakt i tamtego dnia s³usznie spodziewali siê dotrzeæ do Purskal przed zmierzchem.~
@1929 = ~Wspomniana grupa bandytów w jakiœ sposób zwerbowa³a kilku ogrów, by dla nich walczyli. Bogowie wiedz¹, jak uda³o im siê ich przekupiæ, ale tak by³o. Z tego, co ludzie mówi¹, by³a to krótka i brutalna walka, ale w jej trakcie jeden z wozów zosta³ bardzo zniszczony i nie mogli naprawiæ go na drodze.~
@1930 = ~Jakoœ wszystko z powrotem pomieœcili na pozosta³ych wozach i ruszyli w dalsz¹ drogê. Podjêli decyzjê, by opuœciæ Kupiecki Trakt, darowaæ sobie Purskal i zamiast tego kontynuowaæ podró¿ do Athkatli przez Nadbrze¿ny Trakt.~
@1931 = ~Dlaczego? Dlaczego nie poszli dalej do Purskal?~
@1932 = ~Walka nie posz³a ca³kowicie po ich myœli i nieœli rannych stra¿ników, podobnie jak prze³adowane wozy. Jak opowiada³em, pokonali ju¿ dwie grupy bandytów i zdawali sobie sprawê, ¿e s¹ os³abieni – trzeci atak móg³by siê powieœæ. Pamiêtaj, ¿e karawana wioz³a dobra i ruchomoœci z ca³ego bogatego gospodarstwa domowego, a wiêc bardzo zachêcaj¹cy cel.~
@1933 = ~Nie zapominaj, ¿e amnijscy kupcy dopiero od niedawna docieraj¹ tak daleko na po³udnie. Ataki na wszelakie karawany by³y bardzo powszechne w Athkatli, do czasów obecnie w³adaj¹cej Rady Szeœciu. To ona zdecydowa³a. by chroniæ Kupiecki Trakt na po³udniu a¿ do Imnescar i na pó³nocy a¿ do Nashkel.~
@1934 = ~W nieca³y dzieñ po drugim ataku karawana dotar³a tutaj, do Pentyrchu. Mieli nadziejê naprawiæ zepsuty wóz i ruszaæ dalej w komplecie, ale Einion, specjalista od wozów rzuci³ okiem na zniszczenia i pokrêci³ g³ow¹. G³ówne zêbatki by³y pêkniête.~
@1935 = ~Myœla³em, ¿e powiedzia³eœ, i¿ porzucili uszkodzony wóz?~ ~Myœla³am, ¿e powiedzia³eœ, i¿ porzucili uszkodzony wóz?~
@1936 = ~Nie. Zdjêli obci¹¿enie, usunêli uszkodzone przednie ko³o i podnieœli przód na tyln¹ platformê drugiego wozu. W czasie gdy Einion próbowa³ wystaraæ siê o drewno, by zrobiæ nowe zêbatki, rannymi zaj¹³ siê chirurg.~
@1937 = ~Co?! W Pentyrchu jest chirurg?!~
@1938 = ~Niezupe³nie. To by³ brat Einiona, uczy³ siê i podró¿owa³ do Athkatli. Przyjecha³ do domu, by œwiêtowaæ swoje przyjêcie do Gildii Chirurgów. Bedwin, tak mia³ na imiê. Nie s³ysza³em o nim ani nie widzia³em go przez te ostatnie piêæ lat.~
@1939 = ~Otó¿ nadszed³ dzieñ, w którym Einion w koñcu musia³ przyznaæ siê do pora¿ki i wyznaæ, ¿e nie móg³ zdobyæ drewna nadaj¹cego siê na nowe zêbatki. M³ody pan pogodzi³ siê z tym wszystkim i zacz¹³ siê zastanawiaæ, co zostawiæ, a co zabraæ na dalsz¹ drogê.~
@1940 = ~Gdy zauwa¿y³em jego w¹tpliwoœci dotycz¹ce pianina, przypomnia³em sobie têskny wzrok m³odej Aine i zapyta³em, czy zgodzi³by siê z nim rozstaæ za rozs¹dn¹ cenê. Niech Lathander mu sprzyja, poda³ cenê o wiele ni¿sz¹ od rzeczywistej wartoœci pianina, o czym obaj dobrze wiedzieliœmy. Od razu na to przysta³em. Wydaje mi siê, ¿e przy³apa³ m³od¹ Aine, jak któregoœ wieczora próbowa³a graæ na tym instrumencie i zauwa¿y³ determinacjê oraz oczarowanie w oczach tej dziewczyny.~
@1941 = ~I to, moi przyjaciele, jest opowieœæ, jak Aine dosta³a swoje pianino. Wcale nie taka d³uga i tajemnicza.~
@1942 = ~Ale dlaczego nie chcesz jej opowiedzieæ Aine?~
@1943 = ~Po prawdzie, to myœlê, ¿e ona ju¿ j¹ zna, ale nie chce siê do tego przyznaæ. Ta gra toczy siê ju¿ tak d³ugo, ¿e ¿adne z nas nie chce jej zakoñczyæ.~
@1944 = ~Ach, rozumiem. Mogê spytaæ, co masz tu na sprzeda¿?~
@1945 = ~Oto co oferujê.~

