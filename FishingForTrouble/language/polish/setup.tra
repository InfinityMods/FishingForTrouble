// Zakapturzeni Czarodzieje i Ceinwena
@1350 = ~Czego ode mnie chcesz? Twoje zachowanie graniczy z bezczelnoœci¹.~
@1351 = ~Wiesz mo¿e coœ na temat Ceinweny Kruczow³osej?~
@1352 = ~Wiadomo ci coœ na temat kobiety zwanej Ceinwen¹ Kruczow³os¹?~
@1353 = ~Czemu pytasz?~
@1354 = ~Szukam jej. Potrzebna mi jej pomoc.~
@1355 = ~Po prostu odpowiedz na pytanie, czarodzieju.~
@1356 = ~A co powiesz na kilka nocy w wiêzieniu? Albo na podró¿ w jedn¹ stronê do Czarowiêzów? Mogê ci w tym dopomóc. Chocia¿ najlepiej bêdzie, jeœli raz na zawsze wyniesiesz siê z Athkatli.~
@1357 = ~Potrzebna mi twoja pomoc, czarodzieju. Jeœli wiesz, gdzie ona jest, bêdê wdziêczny, jeœli mi to zdradzisz.~ ~Potrzebna mi twoja pomoc, czarodzieju. Jeœli wiesz, gdzie ona jest, bêdê wdziêczna, jeœli mi to zdradzisz.~
@1358 = ~No proszê, potrafisz zachowaæ pozory grzecznoœci, kiedy siê postarasz. Tak. Kobieta, której szukasz, przebywa w Czarowiêzach.~
@1359 = ~Dlaczego j¹ tam zes³ano?~
@1360 = ~Ceinwena Kruczow³osa? Tak, pamiêtam j¹. Przebywa w Czarowiêzach.~
@1361 = ~W Czarowiêzach? Dlaczego tam jest?~
@1362 = ~Z tego samego powodu co wszyscy pensjonariusze. Jest magicznym dewiantem – nielicencjonowanym u¿ytkownikiem magii. Zosta³a tam osadzona dla bezpieczeñstwa Athkatli.~
@1363 = ~Czy jest jakaœ mo¿liwoœæ uwolnienia jej z Czarowiêzów i sprowadzenia z powrotem do Athkatli?~
@1364 = ~Nie ma. Kto raz przest¹pi³ próg Czarowiêzów, nigdy ich nie opuœci. Ma tam dobr¹ opiekê.~
@1365 = ~To twoje ostatnie s³owo? Musisz wiedzieæ, ¿e by³em ju¿ kiedyœ w Czarowiêzach i znam ich po³o¿enie.~ ~To twoje ostatnie s³owo? Musisz wiedzieæ, ¿e by³am ju¿ kiedyœ w Czarowiêzach i znam ich po³o¿enie.~
@1366 = ~Pos³uchaj, czarodzieju, raz ju¿ roznios³em Czarowiêzy na strzêpy i mogê to zrobiæ ponownie.~ ~Pos³uchaj, czarodzieju, raz ju¿ roznios³am Czarowiêzy na strzêpy i mogê to zrobiæ ponownie.~
@1367 = ~Doskonale wiem, kim jesteœ. Twoje groŸby nie robi¹ na nas wra¿enia. Drugi raz nie uda ci siê tak ³atwo wejœæ do Czarowiêzów, nawet jeœli dostaniesz siê na wyspê. Ta rozmowa zmierza donik¹d. ¯yczê dobrego dnia. Z dala ode mnie.~
@1368 = ~Chcê ci tylko zadaæ kilka pytañ na temat tej kobiety.~
@1369 = ~Po prostu odpowiedz na moje pytania, czarodzieju.~
@1370 = ~A co powiesz na kilka nocy w wiêzieniu? Chocia¿ najlepiej bêdzie, jeœli raz na zawsze wyniesiesz siê z Athkatli.~
@1371 = ~Ciekawi mnie, dlaczego trzymacie tu Ceinwenê Kruczow³os¹?~
@1372 = ~No proszê, potrafisz zachowaæ pozory grzecznoœci, kiedy siê postarasz. Tak.~
@1373 = ~Zatem jest tutaj, poniewa¿...?~
@1374 = ~Ale¿ z ciebie uparta osóbka. To nielicencjonowana u¿ytkowniczka magii. Otrzyma³a regulaminowe ostrze¿enie i zlekcewa¿y³a je.~
@1375 = ~I nie mo¿e lub nie chce op³aciæ licencji?~
@1376 = ~I nie mo¿e lub nie chce zap³aciæ wam haraczu... to znaczy op³aciæ licencji?~
@1377 = ~To nielicencjonowana u¿ytkowniczka magii. Otrzyma³a regulaminowe ostrze¿enie i zlekcewa¿y³a je.~
@1378 = ~Twierdzi, ¿e j¹ na to nie staæ. Poniewa¿ nie mo¿e zap³aciæ, musi do³¹czyæ do pozosta³ych dewiantów przetrzymywanych w Czarowiêzach.~
@1379 = ~Co, jeœli zap³acê za jej licencjê?~
@1380 = ~Masz racjê. Niech zgnije w Czarowiêzach.~
@1381 = ~Jak sobie ¿yczysz.~
@1382 = ~Kosztuje 4000 sztuk z³ota. Jeœli wp³acisz ¿¹dan¹ kwotê, kobieta otrzyma licencjê i bêdzie mog³a z tob¹ odejœæ.~
@1383 = ~Nie mam przy sobie takiej iloœci z³ota. Ile mam czasu, ¿eby je zebraæ?~
@1384 = ~Oto z³oto.~
@1385 = ~Oto licencja. Mo¿ecie odejœæ.~
@1386 = ~Tydzieñ. SpóŸnisz siê choæ o minutê, a twoja nielicencjonowana przyjació³ka zamieszka w przytulnej celi w Czarowiêzach.~
@1387 = ~Tydzieñ. Tyle mi wystarczy.~
@1388 = ~Czy masz dla mnie z³oto?~
@1389 = ~Jeszcze nie.~
@1390 = ~Tak.~
@1391 = ~SpóŸni³eœ siê. Twoja „przyjació³ka” jest ju¿ w Czarowiêzach. Sprawa zakoñczona.~ ~SpóŸni³aœ siê. Twoja „przyjació³ka” jest ju¿ w Czarowiêzach. Sprawa zakoñczona.~

//*************************************************************************
// Telther Silnorêki
@1400 = ~*mamrocze do siebie* Ojej, ojej. Nie Lady Ceinwena... to wielka strata, naprawdê. Nie powinno siê do tego dopuœciæ.~
@1401 = ~Co? Co masz na myœli?~
@1402 = ~Naprawdê? Dlaczego szkoda?~
@1403 = ~Co to za brednie?~
@1404 = ~By³bym wdziêczny, gdybyœ zachowywa³ siê uprzejmiej, panie, i zostawi³ nas z naszym smutkiem!~ ~By³bym wdziêczny, gdybyœ zachowywa³a siê uprzejmiej, pani, i zostawi³a nas z naszym smutkiem!~
@1405 = ~Odpowiedz na moje pytania albo porozmawiasz z moim ostrzem. Wybór nale¿y do ciebie.~
@1406 = ~Aaa! Po prostu od³ó¿ broñ!~
@1407 = ~Tak lepiej. A teraz œpiewaj jak grzeczny ptaszek.~
@1408 = ~Zakapturzeni Czarodzieje... zabrali dziœ Lady Ceinwenê. Powiedzieli, ¿e praktykowa³a nielegaln¹ magiê. A ona tylko nios³a pomoc chorym tutaj, w slumsach! Nikt inny siê nami nie przejmowa³... Co teraz zrobimy?~
@1409 = ~Dok¹d j¹ zabrali?~
@1410 = ~S³ysza³em, jak Zakapturzeni Czarodzieje powiedzieli swoim stra¿nikom, by zabrali j¹ do budynku Rady. S¹dzê, ¿e wyœl¹ j¹ stamt¹d do Czarowiêzów.~
@1411 = ~Do Czarowiêzów? Co za parszywe miejsce!~
@1412 = ~Zabrali j¹ niedawno. Jeœli siê pospieszysz, mo¿e ich dogonisz... Ja rozg³oszê po ludziach, by sprawdziæ, czy mo¿emy jakkolwiek pomóc.~

