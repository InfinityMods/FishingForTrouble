//Ailoth Tam – czerwony mag
@1620 = ~Nie! Wstrzymaj siê!~ 
@1621 = ~A kim¿e ty jesteœ, Czerwony Magu, ¿e mia³bym z tob¹ rozmawiaæ?~ ~A kim¿e ty jesteœ, Czerwony Magu, ¿e mia³abym z tob¹ rozmawiaæ?~
@1622 = ~Jestem Ailoth Tam, Czerwony Mag z Thay. By³em cz³onkiem karawany, która zdoby³a twierdzê Cerendor.~ 
@1623 = ~Wiem o tym. Wci¹¿ mnie nie przekona³eœ.~
@1624 = ~To dobry powód, ¿eby ciê zabiæ, a nie oszczêdziæ!~ 
@1625 = ~Mogê ci powiedzieæ, co siê tu wydarzy³o!~
@1626 = ~Nie zabijê ciê – na razie. A teraz mów.~
@1627 = ~Warownia Cerendora jest po³o¿ona tu¿ przy szlakach handlowych miêdzy Thay a Wybrze¿em Mieczy. Mój mistrz potrzebowa³ œrodków na op³acenie armii i zawar³ z pasz¹ Baadilhael¹ umowê na transport czarnego lotosu z Calimportu do Athkatli.~ 
@1628 = ~Pasza Baadilhaela? Kto to jest?~
@1629 = ~Jeden z dwóch zwaœnionych magów w Calimporcie. Ten drugi to Khariyl Skrzydlaty.~ 
@1630 = ~A co jakiœ spór w odleg³ym Calimporcie ma wspólnego z Thay?~
@1631 = ~Pasza Baadilhaela te¿ potrzebuje pieniêdzy na ³apówki, aby utrzymaæ górê w tym zatargu. Mój mistrz dowiedzia³ siê o tym i zaproponowa³ uk³ad. Pasza Baadilhaela mia³ dostarczaæ czarny lotos, a mój mistrz go rozprowadzaæ.~
@1632 = ~Twój mistrz – o kim mowa?~ 
@1633 = ~Jeœli ci to powiem, zginê! B³agam, nie ka¿ mi wyjawiæ jego imienia!~
@1634 = ~Wobec tego ja ci powiem. Homen Odesseiron – czy to imiê, którego nie mo¿esz wyjawiæ?~ 
@1635 = ~Nie! Nie pytaj mnie – podró¿ujesz z Czerwonym Magiem, a jeœli mój mistrz dowie siê, ¿e poda³em jego imiê, bêdê po tysi¹ckroæ ¿a³owa³, ¿e nie zgin¹³em wczeœniej!~
@1636 = ~Wobec tego ja to powiem – Homen Odesseiron.~
@1637 = ~Co on mówi?~
@1638 = ~Zamknij siê, Edwin. Ty! Mów dalej.~ 
@1639 = ~Ja nie powiedzia³em tego imienia! Nie zmusisz mnie, bym siê do tego przyzna³!~
@1640 = ~A zatem Homen Odesseiron wpad³ na pomys³ wykorzystania osamotnionej Warowni Cerendora jako punkt przystankowy, poniewa¿ akurat znajduje siê ona niedaleko g³ównych tras karawan i dróg rzecznych. W jaki sposób transport narkotyku pokonuje rzekê? Na barce?~
@1641 = ~Bêdziesz ¿a³owa³, ¿e tego nie zrobi³eœ... Wiêc albo Homen Odesseiron, albo ten pasza Baadilhaela mia³ genialny pomys³ zorganizowania w Warowni Cerendora punktu przystankowego dla transportu? Który z nich za tym stoi?~ 
@1642 = ~To by³ pomys³ paszy Baadilhaeli.~
@1643 = ~Co to wszystko ma wspólnego z tanar'ri w latarni w Pentyrchu?~ 
@1644 = ~To by³ pomys³ Olrena Dreltaraliana – przyzwaæ czterech tanar'ri, aby strzegli karawan. Nie wiem, co posz³o nie tak.~
@1645 = ~Ach... ale ty mo¿esz pomóc to naprawiæ, prawda?~
@1646 = ~Nie umiem zamkn¹æ portalu, nie wiem jak!~
@1647 = ~A kto wie?~
@1648 = ~Portal wci¹¿ jest otwarty?!~
@1649 = ~Tak przypuszczam.~
@1650 = ~Nie! Nie zmuszaj mnie do tego! Nie mogê... nie mam tyle mocy i nie wiem, jak to zrobiæ!~
@1651 = ~Garalial Geltarath.~
@1652 = ~Garalial Geltarath? Gdzie go znajdê? I kim dla ciebie jest?~
@1653 = ~Wiem tyle, ¿e na pewno nie mo¿na go lekcewa¿yæ.~
@1654 = ~Ach... Harfiarz. Albo raczej by³y Harfiarz. Gdzie go znajdê?~
@1655 = ~O ile mi wiadomo, nadal mieszka w Athkatli. Dla mnie jest tylko informatorem. Wiem, ¿e jest by³ym Harfiarzem i zg³êbia³ wiedzê o nieumar³ych.~
@1656 = ~Gdzie w Athkatli?~
@1657 = ~W okolicach Dzielnicy rz¹dowej.~
@1658 = ~Jak to w okolicach Dzielnicy rz¹dowej?~
@1659 = ~Pamiêtaj, ¿e jeœli go tam nie znajdê, to wrócê po ciebie. Powiedz mi jeszcze, kto przewodzi narkotykowej karawanie?~
@1660 = ~On twierdzi, ¿e to Dzielnica rz¹dowa, ale tak naprawdê to ju¿ Dzielnica graniczna. Mieszka w jednym z domów nieopodal Po³udniowej Bramy.~
@1661 = ~By³eœ tam, nieprawda¿? Mów, jak tam trafiæ... szybko!~
@1662 = ~Tak, tak. Gdy znajdziesz zrujnowany dom – zza niego widaæ Po³udniow¹ Bramê – idŸ na wschód od niego i trafisz do domu Harfiarza.~
@1663 = ~Rozumiem. Pamiêtaj, ¿e jeœli go tam nie znajdê, to wrócê po ciebie. Ostatnie pytanie, Ailoth Tam; kto przewodzi narkotykowej karawanie?~
@1664 = ~Mordaran Skalna Piêœæ; jeden z duergarów. Jego porucznik by³ kiedyœ ¿o³nierzem Amn, zw¹ go Maredudd Bengoch.~
@1665 = ~Duergar? Oraz mieszkaniec wysp Moonshae, s¹dz¹c po nazwisku! Dok¹d oni zmierzaj¹?~
@1666 = ~Skalna Piêœæ podró¿uje z karawan¹, a Bengoch zmierza do Doków, ale nie wiem, czy ma siê tam z kimœ spotkaæ. Nikomu tego nie zdradzi³. Mówi³ tylko, ¿e to punkt przerzutowy do Wrót Baldura.~
@1667 = ~Ha! Bardzo œmieszne. No có¿, Ailoth Tam, wykupi³eœ swoje ¿ycie. Ale nie ruszysz siê st¹d, dopóki nie przyœlê pos³añca z pozwoleniem. A po tym wszystkim wynoœ siê z Wybrze¿a Mieczy i nie chcê o tobie wiêcej s³yszeæ. W przeciwnym razie Homena Odesseirona mo¿e bardzo zainteresowaæ twój udzia³ w tych wydarzeniach.~
@1668 = ~Ha! Bardzo œmieszne. No có¿, Ailoth Tam, wykupi³eœ swoje ¿ycie. Ale nie ruszysz siê st¹d, dopóki nie przyœlê pos³añca z pozwoleniem. A po tym wszystkim wynoœ siê z Wybrze¿a Mieczy. Zarówno ja, jak i Harfiarze bêdziemy mieæ oczy szeroko otwarte, gdybyœ kiedykolwiek próbowa³ wróciæ, tego mo¿esz byæ pewien.~
@1669 = ~Ha! A¿ tak obawiasz siê nazwiska Odesseiron? (Wszyscy rozs¹dni ludzie siê go boj¹).~
@1670 = ~Ale tylko jeœli ten jego nêdzny grzbiet przestanie siê kurczyæ na sam¹ myœl o tym. Tanar'ri mo¿e i odszed³, ale portal, choæ niewidoczny, wci¹¿ pozostaje otwarty. On go musi zamkn¹æ.~
@1671 = ~CO???!!!! Wstrêtna szumowino! Ten pod³y niedorozwiniêty pomiot zara¿onej harpii? Ten... Ten... Och, brak mi s³ów na okreœlenie tego zdradzieckiego Harfiarza! <CHARNAME>, uwa¿aj na niego. On w istocie w³ada potê¿n¹ mroczn¹ magi¹ i pod ¯ADNYM pozorem mu nie ufaj.~

