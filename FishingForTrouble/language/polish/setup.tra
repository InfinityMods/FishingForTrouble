// Bandyci w Warowni Cerendora
@1800 = ~Ty! Stój natychmiast!~
@1801 = ~Mówisz do mnie?~
@1802 = ~Nikogo innego tu nie ma. No, poza moimi kompanami tam, z ty³u. Ha, ha!~
@1803 = ~Dobrze... Mo¿emy to rozwi¹zaæ na dwa sposoby...~
@1804 = ~Naprawdê chcesz walczyæ? Po co psuæ taki piêkny dzieñ?~
@1805 = ~Pozwól, ¿e zgadnê. Chcesz ca³e moje z³oto?~
@1806 = ~Ujmê to nieco inaczej. Ty dasz mi ca³e z³oto, a my w zamian pozwolimy ci ¿yæ.~
@1807 = ~To raczej kiepski wybór, prawda?~
@1808 = ~Nie chcê walczyæ. Wszystko zale¿y od tego, czy wy chcecie.~
@1809 = ~A to zale¿y od...?~
@1810 = ~Pomyœla³em sobie, ¿e mo¿e oddasz mi ca³e z³oto, a w zamian za to my nie bêdziemy z tob¹ walczyæ.~
@1811 = ~Mo¿na tak powiedzieæ, ha, ha!~
@1812 = ~Co, jeœli nie mam z³ota?~
@1813 = ~Co, jeœli odmówiê?~
@1814 = ~To bardzo niedobrze, ha, ha, wyj¹tkowo niedobrze. Widzisz, bêdziemy musieli ciê przeszukaæ, ¿eby sprawdziæ, czy nie ukrywasz ¿adnego z³ota, a naj³atwiej bêdzie to zrobiæ, kiedy bêdziesz trupem.~
@1815 = ~O rety. Spodziewa³em siê takiej odpowiedzi, ech...~ ~O rety. Spodziewa³am siê takiej odpowiedzi, ech...~
@1816 = ~Bêdziemy zmuszeni ciê przeszukaæ, ¿eby sprawdziæ, czy mówisz prawdê, ha, ha.~
@1817 = ~To niezbyt przyjacielska zagrywka.~
@1818 = ~Mo¿esz nam u³atwiæ pracê i udowodniæ, ¿e nie masz z³ota. Rozbierz siê i rzuæ wszystkie ubrania na kupê, ha, ha. To dopiero bêdzie ciekawy widok!~
@1819 = ~Podoba³oby ci siê to, co? Chyba nie skorzystam z propozycji, arogancki draniu!~
@1820 = ~Mo¿esz nam u³atwiæ pracê i udowodniæ, ¿e nie masz z³ota. Rozbierz siê i rzuæ wszystkie ubrania na kupê, ha, ha. Chocia¿ z twoim wygl¹dem pewnie wystraszysz na œmieræ ka¿dego orka w okolicy!~
@1821 = ~Oj tak, na twojej gêbie dobrze to widaæ, arogancki draniu. Jesteœ kopalni¹ pomys³ów.~
@1822 = ~Och! Aleœ ty ³ebski! To walczymy, czy oddajesz z³oto?~ ~Och! Aleœ ty ³ebska! To walczymy, czy oddajesz z³oto?~
@1823 = ~Mam jakiœ inny wybór?~
@1824 = ~To jedyny, jaki dostaniesz, ha, ha.~
@1825 = ~Nie wydaje mi siê. Zatrzymam ¿ycie i z³oto.~
@1826 = ~Dobrze, dobrze! Mam tylko 117 sztuk z³ota. Czy to wystarczy?~
@1827 = ~Tak, wystarczy, ha, ha.~
@1828 = ~Bierz.~
@1829 = ~Ojojoj, chyba pope³ni³eœ swój ostatni b³¹d w ¿yciu, ha, ha. Hej, ch³opcy, on ma ochotê na zabawê!~ ~Ojojoj, chyba pope³ni³aœ swój ostatni b³¹d w ¿yciu, ha, ha. Hej, ch³opcy, ona ma ochotê na zabawê!~

