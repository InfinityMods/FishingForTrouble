// Bran
@4600 = ~Na twoim miejscu nie wchodzi³bym tam.~
@4601 = ~Dlaczego nie?~
@4602 = ~Zamknij siê, g³upcze.~
@4603 = ~Po prostu bym tego nie robi³.~
@4604 = ~Czy to niebezpieczne? Co tam jest?~
@4605 = ~Bêdziesz tego ¿a³owaæ, naprawdê. Po prostu tam nie wchodŸ.~
@4606 = ~No i co znalaz³eœ?~ ~No i co znalaz³aœ?~
@4607 = ~Dwaj obserwatorzy, ale zabi³em je dla ciebie. Najdziwniejsze by³o to, ¿e gdy pierwszy z nich zgin¹³, po prostu zniknê³y i zosta³o po nich cia³o gnoma.~ ~Dwaj obserwatorzy, ale zabi³am je dla ciebie. Najdziwniejsze by³o to, ¿e gdy pierwszy z nich zgin¹³, po prostu zniknê³y i zosta³o po nich cia³o gnoma.~
@4608 = ~Zabi³eœ... je? Zostawi³y... cia³o... gnoma?~ ~Zabi³aœ... je? Zostawi³y... cia³o... gnoma?~
@4609 = ~To by³ mój brat, Adag, zabi³eœ go, ty g³upi kretynie!!! To by³a iluzja!!!~ ~To by³ mój brat, Adag, zabi³aœ go, ty g³upia kretynko!!! To by³a iluzja!!!~
@4610 = ~Ale... ale...~
@4611 = ~Wynocha... z mojego... domu!!!~
@4612 = ~Mówi³em, ¿eby nie wtykaæ nosa, gdzie nie trzeba.~
@4613 = ~Tam jest obserwator! Dwaj przeklêci obserwatorzy! Dlaczego mi nie powiedzia³eœ? Jak siê tam dosta³y?!~
@4614 = ~Obserwator, mówisz? Gdy ostatnio tam zagl¹da³em, by³ lisz. Masz pewnoœæ, ¿e to nie by³ lisz-obserwator?~
@4615 = ~Nie ma czegoœ takiego jak lisz-obserwator, stary g³upcze!~
@4616 = ~Hmmm... mo¿e i jestem g³upi, ale na pewno nie stary. Jeszcze nie. Mo¿e lepiej sam siê temu przyjrzê.~
@4617 = ~Nie... nie widzê ¿adnych obserwatorów. Chyba nie pi³eœ znów bimbru Keldrela, prawda?~ ~Nie... nie widzê ¿adnych obserwatorów. Chyba nie pi³aœ znów bimbru Keldrela, prawda?~
@4618 = ~Nie, nie pi³em bimbru Keldrela! Tu byli dwaj obserwatorzy!~ ~Nie, nie pi³am bimbru Keldrela! Tu byli dwaj obserwatorzy!~
@4619 = ~Nie trzeba zaraz tak wœciekaæ siê i wrzeszczeæ, prawda? Nie widzê ¿adnych obserwatorów, a ty?~
@4620 = ~Jeden by³ o tutaj, a drugi tam. Mówiê ci, w tym pokoju byli dwaj obserwatorzy!~
@4621 = ~Ach, z pewnoœci¹ wypi³eœ za du¿o trunku starego Keldrela i nie chcesz siê przyznaæ. Mocny towar, co nie? Nie martw siê – œmiem twierdziæ, ¿e nie ty pierwszy i nie ostatni.~ ~Ach, z pewnoœci¹ wypi³aœ za du¿o trunku starego Keldrela i nie chcesz siê przyznaæ. Mocny towar, co nie? Nie martw siê – œmiem twierdziæ, ¿e nie ty pierwsza i nie ostatnia.~
@4622 = ~Ale powiedzia³eœ mi, ¿e mam tam nie wchodziæ, bo to niebezpieczne!~
@4623 = ~Naprawdê? Nie przypominam sobie. Jeœli nie masz nic przeciwko, wrócê do pracy.~
@4624 = ~Och... witaj. Jeszcze nie wyszed³eœ?~ ~Och... witaj. Jeszcze nie wysz³aœ?~
@4625 = ~Tak w ogóle, to kim ty na Dziewiêæ Piekie³ jesteœ?~
@4626 = ~Zamknij siê, g³upcze. Mam tego wszystkiego dosyæ i chcê wiedzieæ, o co tutaj chodzi.~
@4627 = ~Wiesz, posiadam imiê. Tak na przysz³oœæ: jestem Bran, z zawodu cieœla i stolarz artystyczny. A teraz, jeœli widzisz rzeczy, których ja nie widzê, sugerujê ci odstawiæ picie. Lub cokolwiek tam bierzesz. Wybacz, ale mam mnóstwo pracy.~
@4628 = ~Jestem Bran, lokalny cieœla. Mi³o mi ciê poznaæ.~
@4629 = ~W porz¹dku, Branie – naprawdê chcia³bym wiedzieæ, co siê tutaj dzieje.~ ~W porz¹dku, Branie – naprawdê chcia³abym wiedzieæ, co siê tutaj dzieje.~
@4630 = ~Nie mogê ci pomóc, przyjacielu. Jeœli widzisz rzeczy, których ja nie widzê, sugerujê ci odstawiæ picie. Lub cokolwiek tam bierzesz. A teraz wybacz, ale mam mnóstwo pracy.~ ~Nie mogê ci pomóc, przyjació³ko. Jeœli widzisz rzeczy, których ja nie widzê, sugerujê ci odstawiæ picie. Lub cokolwiek tam bierzesz. A teraz wybacz, ale mam mnóstwo pracy.~
@4631 = ~Mówi³em ci, ¿eby tam nie wchodziæ, ale po co mia³byœ mnie s³uchaæ, co? A jak¿e.~ ~Mówi³em ci, ¿eby tam nie wchodziæ, ale po co mia³abyœ mnie s³uchaæ, co? A jak¿e.~

