@3993 = ~Nie twój interes, szmaciarzu.~
@3994 = ~Jestem stra¿nikiem tego miejsca, ukrytego tam, gdzie nie siêga spojrzenie s³oñca. Pytam ponownie, czego tu szukasz?~
@3995 = ~To 'coœ' to zapewne Tygrysie oko, nieprawda¿, z³odzieju? Co zaproponujesz stra¿nikowi jako rekompensatê?~ ~To 'coœ' to zapewne Tygrysie oko, nieprawda¿, z³odziejko? Co zaproponujesz stra¿nikowi jako rekompensatê?~
@3996 = ~Zamiast niej chcia³bym zadaæ ci pytanie.~ ~Zamiast niej chcia³abym zadaæ ci pytanie.~
@3997 = ~Mo¿e œmieræ?~
@3998 = ~Ju¿ jestem martwy, wiêc twoja oferta jest dla mnie bezwartoœciowa. Próbuj dalej, z³odzieju.~ ~Ju¿ jestem martwy, wiêc twoja oferta jest dla mnie bezwartoœciowa. Próbuj dalej, z³odziejko.~
@3999 = ~Mo¿e wiêc zamiast tego zadam ci pytanie?~
@4000 = ~Doœæ ju¿ pytañ! Nadszed³ czas zamieniæ ciê w kupê nieruchomych koœci, i to na sta³e!~
@4001 = ~Jak sobie ¿yczysz.~
@4002 = ~Jak sobie ¿yczysz. Rozwa¿ jednak, ¿e w tym miejscu mo¿na zadaæ tylko jedno pytanie, pytaj wiêc rozwa¿nie.~
@4003 = ~Dlaczego tu jesteœ?~
@4004 = ~Od jak dawna tu jesteœ?~
@4005 = ~Dlaczego strze¿esz Tygrysiego oka?~
@4006 = ~Co to za miejsce?~
@4007 = ~Kto ciê tu zes³a³?~
@4008 = ~Czy mo¿esz mi daæ Tygrysie oko?~
@4009 = ~Przyszed³em tu po Tygrysie oko, które pomo¿e mi uzdrowiæ przyjaciela. Pozwolisz mi je zabraæ?~ ~Przysz³am tu po Tygrysie oko, które pomo¿e mi uzdrowiæ przyjaciela. Pozwolisz mi je zabraæ?~
@4010 = ~Co jest takiego niezwyk³ego w Tygrysim oku?~
@4011 = ~Dlaczego Tygrysie oko roœnie tylko w tym miejscu?~
@4012 = ~Chcia³bym ciê poprosiæ o rêkê.~ ~Chcia³abym ciê poprosiæ o rêkê.~
@4013 = ~To niew³aœciwe pytanie, z³odzieju. Nie przemyœla³eœ tego wystarczaj¹co.~ ~To niew³aœciwe pytanie, z³odziejko. Nie przemyœla³aœ tego wystarczaj¹co.~
@4014 = ~To w³aœciwe pytanie, by³y z³odzieju. Tylko jeden spoœród st¹paj¹cych pod s³oñcem jest godzien. Ten, który nie po¿¹da kwiatu dla siebie. Mo¿esz go wzi¹æ. By³y z³odzieju, chcê ciê prosiæ o przys³ugê.~ ~To w³aœciwe pytanie, by³a z³odziejko. Tylko jedna spoœród st¹paj¹cych pod s³oñcem jest godna. Ta, która nie po¿¹da kwiatu dla siebie. Mo¿esz go wzi¹æ. By³a z³odziejko, chcê ciê prosiæ o przys³ugê.~
@4015 = ~S³ucham.~
@4016 = ~Nie mam czasu na kolejne misje. Muszê zanieœæ ten kwiat potrzebuj¹cemu tak szybko, jak to mo¿liwe.~
@4017 = ~Tkwiê tu jako nieumar³y od wielu lat, przestaj¹c tylko z tymi, którzy przychodz¹ skraœæ Tygrysie oko lub podziwiaæ jego piêkno. Marzê o prawdziwej œmierci. Czy dasz mi prawdziw¹ œmieræ, œmieræ godn¹ wojownika? Zabij mnie i pozwól mi do³¹czyæ do moich pobratymców!~
@4018 = ~Jeœli rzeczywiœcie tego pragniesz, spe³niê twoje ¿yczenie.~
@4019 = ~Ktoœ musi staæ na stra¿y Tygrysiego oka. Od dawna godnie pe³ni³eœ tê s³u¿bê i uwa¿am, ¿e powinno tak pozostaæ.~
@4020 = ~W takim razie przyst¹pmy do dzie³a, z³odzieju.~ ~W takim razie przyst¹pmy do dzie³a, z³odziejko.~
@4021 = ~Rozumiem. ¯yczê ci powodzenia w twojej misji, by³y z³odzieju.~ ~Rozumiem. ¯yczê ci powodzenia w twojej misji, by³a z³odziejko.~

//*************************************************************************
// Elminster
@4050 = ~Ghul! I to na tyle œmia³y, ¿eby odwa¿yæ siê tu wejœæ. Ale nie jesteœ zwyczajnym ghulem, prawda, <CHARNAME>?~
@4051 = ~Tak, to ja w ca³ej swojej szkaradnoœci.~
@4052 = ~Jestem zaskoczony, ¿e w ogóle mnie rozpozna³eœ.~ ~Jestem zaskoczona, ¿e w ogóle mnie rozpozna³eœ.~
@4053 = ~Nie stój tak! Zrób coœ!~
@4054 = ~Widzê, ¿e uci¹³eœ sobie pogawêdkê z Ceinwen¹ Kruczow³os¹. Tak, ja te¿ z ni¹ rozmawia³em. Wejœcie w Pu³apki ¯yj¹cych by³o czynem brawurowym, choæ g³upim, i to pomimo licznych ostrze¿eñ Ceinweny. Oto efekt – sta³eœ siê nieumar³ym, tak jak ca³a wioska.~ ~Widzê, ¿e uciê³aœ sobie pogawêdkê z Ceinwen¹ Kruczow³os¹. Tak, ja te¿ z ni¹ rozmawia³em. Wejœcie w Pu³apki ¯yj¹cych by³o czynem brawurowym, choæ g³upim, i to pomimo licznych ostrze¿eñ Ceinweny. Oto efekt – sta³aœ siê nieumar³¹, tak jak ca³a wioska.~
@4055 = ~Ceinwena twierdzi, ¿e to sta³a przemiana.~
@4056 = ~Mo¿esz coœ zrobiæ, ¿eby to odwróciæ?~
@4057 = ~Na tym œwiecie nie ma niczego sta³ego, <CHARNAME>. Dotyczy to nawet mnie czy Mystry. Poza tym spodziewa³em siê ciebie. Zaczekaj chwilê...~
@4058 = ~Co...?~
@4059 = ~Proszê bardzo, <CHARNAME>. Mo¿esz ponownie wêdrowaæ po œwiecie w swej zwyk³ej postaci. OdwiedŸ mnie, kiedy bêdziesz mieæ nowe wieœci.~
@4060 = ~Hmm. A wiêc nawet ta gorzka lekcja nie dotar³a do twojego zakutego ³ba?~
@4061 = ~S³uchaj, po prostu zrób coœ z tym, dobrze?~
@4062 = ~Czy wielki Elminster ma dla mnie jak¹œ m¹dr¹ radê dotycz¹c¹ usuniêcia tej wstrêtnej kl¹twy?~
@4063 = ~Pomogê ci, ale tylko dlatego, ¿e czujê siê po czêœci odpowiedzialny za ca³¹ sytuacjê. Zaczekaj chwilê...~
@4064 = ~Zrobione. Teraz proszê ciê o niezw³oczne opuszczenie tego miejsca. Wróæ, kiedy zdobêdziesz jakieœ wieœci na temat Pentyrchu albo nauczysz siê dobrych manier. A najlepiej jedno i drugie.~
@4065 = ~Radzê ci nauczyæ siê z tym ¿yæ. Ostrzegano ciê, ¿e efekt bêdzie trwa³y.~
@4066 = ~Nie mówisz powa¿nie!? Musisz coœ z tym zrobiæ!~
@4067 = ~Nie.~
@4068 = ~Chcesz powiedzieæ, ¿e mo¿esz, ale nie chcesz?~
@4069 = ~Tak.~
@4070 = ~Ale...!~
@4071 = ~<CHARNAME>, jesteœ jednym z najgorzej wychowanych ¿yj¹cych Dzieci Bhaala. Z wielk¹ przyjemnoœci¹ pozostawi³bym ciê z tej postaci, jednak jestem czêœciowo odpowiedzialny za twoje nieszczêœcie, gdy¿ to ja poprosi³em ciê o zbadanie Pentyrchu. Zatem... ~
@4072 = ~Zrobione. Teraz proszê ciê o niezw³oczne opuszczenie tego miejsca. Wróæ, kiedy zdobêdziesz jakieœ wieœci na temat Pentyrchu albo nauczysz siê dobrych manier. Choæ co do tego drugiego nie robiê sobie nadziei.~
@4073 = ~Oto powrót mego wêdrowca! Masz dla mnie jakieœ informacje?~
@4074 = ~Twoja wioska jest martwa, starcze. Zbuntowany Harfiarz Geltarath pokpi³ sprawê z kontrzaklêciem.~
@4075 = ~Dosz³y do mnie nieco inne wieœci.~
@4076 = ~Wierzysz s³owu k³amliwego by³ego Harfiarza i jego popleczników?~
@4077 = ~Stajesz siê dla mnie coraz mniej wiarygodny, <CHARNAME>. Zaczynam siê te¿ zastanawiaæ, co takiego widzia³ w tobie Gorion.~ ~Stajesz siê dla mnie coraz mniej wiarygodna, <CHARNAME>. Zaczynam siê te¿ zastanawiaæ, co takiego widzia³ w tobie Gorion.~
@4078 = ~Twój wybór, starcze. Co do mnie, w przysz³oœci chcia³bym mieæ z tob¹ jak najmniej do czynienia.~ ~Twój wybór, starcze. Co do mnie, w przysz³oœci chcia³abym mieæ z tob¹ jak najmniej do czynienia.~
@4079 = ~Niestety moje odczucia s¹ podobne. ¯yczê ci spokoju, <CHARNAME>, aczkolwiek ju¿ nie szczêœcia.~
@4080 = ~Mam wieœci, ale nie s¹ one dobre i to wszystko moja wina. Garalial Geltarath ostrzega³ mnie przed wizyt¹ w Pentyrchu przed up³yniêciem okreœlonego czasu, ale nie pos³ucha³em go. Teraz mieszkañcy zostali zaklêci w zombie, a latarnia jest nawiedzana przez tanar'ri. Gdybym tylko móg³ naprawiæ jakoœ ten g³upi b³¹d, zrobi³bym to.~ ~Mam wieœci, ale nie s¹ one dobre i to wszystko moja wina. Garalial Geltarath ostrzega³ mnie przed wizyt¹ w Pentyrchu przed up³yniêciem okreœlonego czasu, ale nie pos³ucha³am go. Teraz mieszkañcy zostali zaklêci w zombie, a latarnia jest nawiedzana przez tanar'ri. Gdybym tylko mog³a naprawiæ jakoœ ten g³upi b³¹d, zrobi³abym to.~
@4081 = ~To rzeczywiœcie niedobre wieœci, zw³aszcza dla tych nieszczêsnych wieœniaków. Co sobie myœla³ ten Olren z Thay?! Ech, nie ma co p³akaæ nad rozlanym mlekiem. Niech to bêdzie dla ciebie gorzka lekcja, ¿e nale¿y s³uchaæ innych! Ca³a wieœ potêpiona przez g³upi¹ nierozwagê!~
@4082 = ~W takim razie nie ma potrzeby, ¿ebym dalej tu przebywa³. ChodŸ, Lief, czeka nas d³uga droga do Calimshanu. Mieszka tam pewien chciwy mag, z którym chcia³bym zamieniæ kilka s³ów.~
@4083 = ~Twoja wioska uratowana, starcze. Zrobi³em to dla ciebie. Pozby³em siê te¿ przeklêtego tanar'ri.~ ~Twoja wioska uratowana, starcze. Zrobi³am to dla ciebie. Pozby³am siê te¿ przeklêtego tanar'ri.~
@4084 = ~Dosz³y mnie nieco inne wieœci. Tak, Pentyrch zosta³ uratowany, a tanar'ri odes³any do swej ojczystej sfery, jednak wiem, ¿e nie dokona³eœ tego samodzielnie. Muszê powiedzieæ, ¿e coraz trudniej mi wierzyæ twoim s³owom bez uzyskania potwierdzenia z niezale¿nego Ÿród³a, <CHARNAME>. Zaczynam siê te¿ zastanawiaæ, co takiego widzia³ w tobie Gorion.~ ~Dosz³y mnie nieco inne wieœci. Tak, Pentyrch zosta³ uratowany, a tanar'ri odes³any do swej ojczystej sfery, jednak wiem, ¿e nie dokona³aœ tego samodzielnie. Muszê powiedzieæ, ¿e coraz trudniej mi wierzyæ twoim s³owom bez uzyskania potwierdzenia z niezale¿nego Ÿród³a, <CHARNAME>. Zaczynam siê te¿ zastanawiaæ, co takiego widzia³ w tobie Gorion.~
@4085 = ~Twój wybór, starcze. Rozwi¹za³em twój problem i nie rozumiem, o co ci chodzi. Co do mnie, w przysz³oœci chcia³bym mieæ z tob¹ jak najmniej do czynienia.~ ~Twój wybór, starcze. Rozwi¹za³am twój problem i nie rozumiem, o co ci chodzi. Co do mnie, w przysz³oœci chcia³abym mieæ z tob¹ jak najmniej do czynienia.~
@4086 = ~Pentyrch zosta³ uratowany, a tanar'ri odes³any do swojej ojczystej sfery. Wszystko dziêki Garalialowi Geltarathowi!~
@4087 = ~Garalial Geltarath? Ten by³y Harfiarz?~
@4088 = ~Dokona³ tego z pomoc¹ Eildareny Colver i jeszcze Angharady Ogniow³osej.~
@4089 = ~Aach! Od dawna podejrzewa³em, ¿e sprawa z Garalialem i Eildaren¹ nie jest taka, na jak¹ z pozoru wygl¹da. I z Ceinwen¹. By³ wzorowym Harfiarzem i osob¹, na której mo¿na by³o polegaæ, do czasu kiedy sta³o siê coœ, co go zniechêci³o. Wygl¹da na to, ¿e muszê z³o¿yæ wizytê naszemu wspólnemu znajomemu... Dobra robota, <CHARNAME>! ¯yczê ci pokoju i szczêœcia. ChodŸ, Lief, czeka nas d³uga droga do Calimshanu. Mieszka tam pewien chciwy mag, z którym chcia³bym zamieniæ klika s³ów.~
@4090 = ~Co! Och, <CHARNAME>! Co ciê tu sprowadza? Wygl¹dasz wyj¹tkowo ponuro.~
@4091 = ~Eee... Musisz udaæ siê do Pentyrchu osobiœcie, Elminsterze. Trzeba przyznaæ, ¿e narobi³em tam tylko k³opotów.~ ~Eee... Musisz udaæ siê do Pentyrchu osobiœcie, Elminsterze. Trzeba przyznaæ, ¿e narobi³am tam tylko k³opotów.~
@4092 = ~IdŸ do tej cuchn¹cej rybami wioski i sam rozwi¹¿ swoje problemy, starcze. Ja z ni¹ skoñczy³em.~ ~IdŸ do tej cuchn¹cej rybami wioski i sam rozwi¹¿ swoje problemy, starcze. Ja z ni¹ skoñczy³am.~
@4093 = ~Pójdê, skoro na tym siê koñczy twoja determinacja, ale spodziewa³em siê po tobie czegoœ wiêcej. Jeœli taka jest twoja decyzja, to nie mamy sobie nic wiêcej do powiedzenia.~
@4094 = ~Ale¿ odczep siê, staruchu. Doœæ mam ju¿ tego.~
@4095 = ~Tak, wiem o tym. Przed chwil¹ by³a u mnie Ceinwena i opowiedzia³a mi o problemie. Có¿, wygl¹da na to, ¿e bêdê musia³ osobiœcie zamieniæ kilka s³ów z tym tanar'ri. IdŸ w pokoju, <CHARNAME>. Nauczy³eœ siê przynajmniej, ¿e nie zawsze wszystko musi uk³adaæ siê po twojej myœli. ¯ycie ma paskudny zwyczaj wbijania ci no¿a w plecy w chwili, w której najmniej siê tego spodziewasz.~ ~Tak, wiem o tym. Przed chwil¹ by³a u mnie Ceinwena i opowiedzia³a mi o problemie. Có¿, wygl¹da na to, ¿e bêdê musia³ osobiœcie zamieniæ kilka s³ów z tym tanar'ri. IdŸ w pokoju, <CHARNAME>. Nauczy³aœ siê przynajmniej, ¿e nie zawsze wszystko musi uk³adaæ siê po twojej myœli. ¯ycie ma paskudny zwyczaj wbijania ci no¿a w plecy w chwili, w której najmniej siê tego spodziewasz.~
@4096 = ~Tak, wiem o tym. Przed chwil¹ by³ u mnie Garaliel Geltarath i opowiedzia³ mi o problemie. Wskutek twojej biernoœci Eildarena Colver umar³a nied³ugo po tym, jak go opuœci³eœ. Nie tego siê po tobie spodziewa³em!~ ~Tak, wiem o tym. Przed chwil¹ by³ u mnie Garaliel Geltarath i opowiedzia³ mi o problemie. Wskutek twojej biernoœci Eildarena Colver umar³a nied³ugo po tym, jak go opuœci³aœ. Nie tego siê po tobie spodziewa³em!~
@4097 = ~Wygl¹da na to, ¿e bêdê musia³ osobiœcie zamieniæ kilka s³ów z tym tanar'ri. OdejdŸ, <CHARNAME>. Przez ciebie straci³ ¿ycie dobry kap³an, który prawie na pewno by³ cz³onkiem Harfiarzy. Mam nadziejê, ¿e jesteœ z siebie zadowolony.~ ~Wygl¹da na to, ¿e bêdê musia³ osobiœcie zamieniæ kilka s³ów z tym tanar'ri. OdejdŸ, <CHARNAME>. Przez ciebie straci³ ¿ycie dobry kap³an, który prawie na pewno by³ cz³onkiem Harfiarzy. Mam nadziejê, ¿e jesteœ z siebie zadowolona.~ 
@4098 = ~Co? <CHARNAME>! Przybywasz z Pentyrchu? Odkry³eœ, na czym polega problem?~ ~Co? <CHARNAME>! Przybywasz z Pentyrchu? Odkry³aœ, na czym polega problem?~
@4099 = ~Mam wieœci, ale bynajmniej nie s¹ one dobre.~
@4100 = ~Tak. Pewnie chcesz siê dowiedzieæ, co tam zasz³o?~
@4101 = ~By³oby to pomocne.~
@4102 = ~W takim razie chyba muszê ci powiedzieæ. A mia³em ciê za wszystkowiedz¹cego Elminstera.~ ~W takim razie chyba muszê ci powiedzieæ. A mia³am ciê za wszystkowiedz¹cego Elminstera.~
@4103 = ~Spodziewa³em siê podobnej odpowiedzi. Proszê, opowiedz mi wszystko od pocz¹tku do koñca.~
@4104 = ~*opowiedz historiê tanar'ri i Ceinweny Kruczow³osej*~
@4105 = ~Czarowiêzy. Zakapturzeni Czarodzieje zaczynaj¹ przechodziæ samych siebie. A wiêc nie uda³o ci siê przebyæ Pu³apek ¯yj¹cych, a bez Ceinweny nie ma innego wyjœcia. *wzdycha*~
@4106 = ~Tak twierdzi tanar'ri.~
@4107 = ~Wiêc mówisz, ¿e Ceinwena Kruczow³osa przebywa w Czarowiêzach? Nie zas³u¿y³a na taki los. Nie mogê na to pozwoliæ. Wygl¹da na to, ¿e muszê udaæ siê do Brynnlaw osobiœcie i to szybko. Spodziewaj siê mojego powrotu za, powiedzmy, trzy dni.~
@4108 = ~Dobrze.~
@4109 = ~Witaj, <CHARNAME>. Widzê, ¿e plotki okaza³y siê prawdziwe. Narobi³eœ niez³ego ba³aganu w Czarowiêzach.~ ~Witaj, <CHARNAME>. Widzê, ¿e plotki okaza³y siê prawdziwe. Narobi³aœ niez³ego ba³aganu w Czarowiêzach.~
@4110 = ~Ale Irenicus uciek³.~
@4111 = ~Zgadza siê. Gdzie ta kobieta, Kruczow³osa?~
@4112 = ~Tak, niestety uda³o mu siê. Nie wiem, dlaczego Zakapturzeni s¹dzili, ¿e mog¹ utrzymaæ w ryzach kogoœ takiego. ¯yczê ci powodzenia w polowaniu na niego, ale, uprzedzaj¹c twoje pytanie, nie mogê pomóc. Gdybym mia³ na to czas, mia³bym czas równie¿ na osobiste rozwi¹zanie problemów Pentyrchu.~
@4113 = ~Gdzie jest Ceinwena Kruczow³osa?~
@4114 = ~Przypuszczam, ¿e w jej domu w Dzielnicy granicznej. Mówi³a mi, ¿e niedawno przemalowa³a go na czerwono.~
@4115 = ~Dziêkujê, Elminsterze.~
@4116 = ~Pff! Nie mog³eœ jej przyprowadziæ tutaj?~
@4117 = ~Na twoim miejscu uwa¿a³bym na s³owa, <CHARNAME>. Ceinwena nie jest znana z cierpliwoœci.~
@4118 = ~Dam sobie radê z ni¹ i z ka¿dym innym, kto stanie mi na drodze.~
@4119 = ~Có¿, ¿yczê ci powodzenia.~
@4120 = ~No, <CHARNAME>, masz jakieœ wieœci o Pentyrchu?~
@4121 = ~Jeszcze nie. Wci¹¿ siê rozgl¹dam.~
@4122 = ~Wszystko w swoim czasie, szarobrody.~
@4123 = ~Lepiej by by³o, gdybyœ siê tym zaj¹³. Nie mogê tu czekaæ wiecznie i Pentyrch te¿ nie!~ ~Lepiej by by³o, gdybyœ siê tym zajê³a. Nie mogê tu czekaæ wiecznie i Pentyrch te¿ nie!~
@4124 = ~Udam siê tam tak szybko, jak to mo¿liwe.~
@4125 = ~Zastanowiê siê nad tym, starcze. A teraz zamknij siê i daj mi spokój.~
@4126 = ~Ach, <CHARNAME>! Ten obwo³ywacz jest doœæ ha³aœliwy, nieprawda¿? I czêsto siê powtarza. Hmm. Przemyœla³eœ moj¹ proœbê?~ ~Ach, <CHARNAME>! Ten obwo³ywacz jest doœæ ha³aœliwy, nieprawda¿? I czêsto siê powtarza. Hmm. Przemyœla³aœ moj¹ proœbê?~
@4127 = ~Przykro mi, Elminsterze, ale nie.~
@4128 = ~Tak, przemyœla³em. Czego ode mnie oczekujesz?~ ~Tak, przemyœla³am. Czego ode mnie oczekujesz?~
@4129 = ~Hola, wêdrowcze! Zatrzymaj siê, gdy ciê prosi starzec. [yselm01]~
@4130 = ~Elminster!~
@4131 = ~Czy my siê znamy?~
@4132 = ~Elminster!!! Jak mi³o ciê znowu widzieæ!~
@4133 = ~*wzdycha* Naprawdê mam wierzyæ, ¿e mnie nie rozpoznajesz? Nie spotka³o mnie coœ takiego od bardzo dawna. Naprawdê tak wiele czasu up³ynê³o od naszego ostatniego spotkania, <CHARNAME>?~
@4134 = ~*œmieje siê* Warto by³o spróbowaæ, choæby po to, ¿eby zobaczyæ twoj¹ reakcjê! Bardzo mi³o ciê znowu widzieæ, Elminsterze.~
@4135 = ~Ciebie równie¿. Ta sprawa z twoim bratem Sarevokiem by³a bardzo przykra, ale przyznam, ¿e jestem zadowolony, ¿e to ty wyszed³eœ z niej obronn¹ rêk¹, a nie on. Naprawdê nie mia³bym ochoty rozwi¹zywaæ jej osobiœcie, gdyby sprawy potoczy³y siê inaczej... Teraz jednak pojawi³y siê inne problemy *wzdycha*.~ ~Ciebie równie¿. Ta sprawa z twoim bratem Sarevokiem by³a bardzo przykra, ale przyznam, ¿e jestem zadowolony, ¿e to ty wysz³aœ z niej obronn¹ rêk¹, a nie on. Naprawdê nie mia³bym ochoty rozwi¹zywaæ jej osobiœcie, gdyby sprawy potoczy³y siê inaczej... Teraz jednak pojawi³y siê inne problemy *wzdycha*.~
@4136 = ~K³opoty z Sarevokiem mam dawno za sob¹, a wspominanie ich nie sprawia mi przyjemnoœci. Jeœli chodzi o inne problemy nêkaj¹ce Wybrze¿e Mieczy, równie¿ jestem nimi zainteresowany.~ ~K³opoty z Sarevokiem mam dawno za sob¹, a wspominanie ich nie sprawia mi przyjemnoœci. Jeœli chodzi o inne problemy nêkaj¹ce Wybrze¿e Mieczy, równie¿ jestem nimi zainteresowana.~
@4137 = ~Jednak esencja Pomiotu Bhaala wci¹¿ jest czêœci¹ ciebie. Jak dot¹d radzisz sobie z ni¹ dobrze, lecz nie mam pewnoœci, czy najtrudniejsze próby nie s¹ jeszcze przed tob¹.~
@4138 = ~Mo¿liwe. Przekonamy siê. W tej chwili bardziej interesuje mnie, kim jest ten Jon Irenicus i gdzie jest Imoen.~
@4139 = ~Bêdê siê tym przejmowa³, kiedy przyjdzie czas. W tej chwili najbardziej interesuje mnie najbli¿sza przysz³oœæ.~ ~Bêdê siê tym przejmowa³a, kiedy przyjdzie czas. W tej chwili najbardziej interesuje mnie najbli¿sza przysz³oœæ.~
@4140 = ~Tak siê sk³ada, ¿e mnie równie¿. Mam rozleg³¹ sieæ informatorów w Athkatli i Amnie. Wszyscy wypatruj¹ k³opotów lub ich oznak. Wiêkszoœæ informacji w koñcu do mnie trafia w ten czy inny sposób.~
@4141 = ~W takim razie ja te¿ bêdê mia³ oczy otwarte. Jestem ci to winien!~ ~W takim razie ja te¿ bêdê mia³ oczy otwarte. Jestem ci to winna!~
@4142 = ~Nie w¹tpiê!~
@4143 = ~Bêdê jeszcze przez krótki czas w Targowie. A teraz, <CHARNAME>, jeœli mi wybaczysz, naprawdê muszê ju¿ iœæ.~
@4144 = ~Przepraszam, ¿e nie mogê poœwiêciæ ci wiêcej czasu, ale s³ysza³em plotki o problemach w okolicy Twierdzy Stra¿nika. Mo¿e s³ysza³eœ coœ na ten temat w trakcie swoich podró¿y? Jestem za stary, ¿eby uganiaæ siê po ca³ym Amnie za b³êdnymi ognikami.~ ~Przepraszam, ¿e nie mogê poœwiêciæ ci wiêcej czasu, ale s³ysza³em plotki o problemach w okolicy Twierdzy Stra¿nika. Mo¿e s³ysza³aœ coœ na ten temat w trakcie swoich podró¿y? Jestem za stary, ¿eby uganiaæ siê po ca³ym Amnie za b³êdnymi ognikami.~
@4145 = ~*œmieje siê* Nie zdarzy³o siê jeszcze, ¿eby brakowa³o ci energii! Sam nie jestem guzdra³¹, a zazwyczaj nie da³bym rady za tob¹ nad¹¿yæ. Mam jednak dla ciebie list od maga, którego spotka³em przed gospod¹ „Pod Krzywym ¿urawiem” w bramach Athkatli. Bardzo nalega³, ¿eby ci go dostarczyæ bez wzglêdu na przeszkody, wiêc byæ mo¿e ma coœ wspólnego z t¹ spraw¹.~ ~*œmieje siê* Nie zdarzy³o siê jeszcze, ¿eby brakowa³o ci energii! Sama nie jestem guzdra³¹, a zazwyczaj nie da³abym rady za tob¹ nad¹¿yæ. Mam jednak dla ciebie list od maga, którego spotka³am przed gospod¹ „Pod Krzywym ¿urawiem” w bramach Athkatli. Bardzo nalega³, ¿eby ci go dostarczyæ bez wzglêdu na przeszkody, wiêc byæ mo¿e ma coœ wspólnego z t¹ spraw¹.~
@4146 = ~*Czyta szybko, po czym g³êboko wzdycha.* Hmm, tak. Sprawy majœ siê du¿o gorzej, ni¿ myœla³em. Lief ma racjê, informacje zawarte w tym liœcie s¹ bardzo istotne.~
@4147 = ~Ale bêdziesz w stanie nad wszystkim zapanowaæ, prawda?~
@4148 = ~Jestem pewien, ¿e nie bêdziesz mia³ wiêkszych problemów, ¿eby dojœæ z nimi do ³adu.~
@4149 = ~Có¿... Tym razem by³bym wdziêczny za twoj¹ pomoc. Znalaz³byœ czas, ¿eby zbadaæ informacje zebrane przez Liefa?~ ~Có¿... Tym razem by³bym wdziêczny za twoj¹ pomoc. Znalaz³abyœ czas, ¿eby zbadaæ informacje zebrane przez Liefa?~
@4150 = ~Oczywiœcie! Czego dok³adnie potrzebujesz?~
@4151 = ~Nie tym razem. Mam za ma³o czasu i zbyt wiele rzeczy do zrobienia. Mo¿e kiedy indziej?~
@4152 = ~Trochê szpiegowskiej roboty, nic wielkiego. Lief pisze, ¿e ma³e nadmorskie miasteczko na po³udnie st¹d zaczê³o siê dziwnie zachowywaæ. To znaczy jego mieszkañcy, nie sama miejscowoœæ! Wygl¹da na to, ¿e wszyscy jednoczeœnie odeszli, porzucaj¹c swe domy bez wyraŸnego powodu! Jeœli nie masz nic przeciwko ma³emu rekonesansowi, by³bym wdziêczny za rozejrzenie siê i doniesienie mi, co siê tam dzieje.~
@4153 = ~Myœlê, ¿e dam sobie z tym radê. Gdzie ciê póŸniej znajdê?~
@4154 = ~Kiedy ostatnio udzieli³eœ mi „pomocy”, wpad³em w straszliwe k³opoty i skoñczy³em, walcz¹c o ¿ycie z moim bratem. Tym razem podziêkujê!~ ~Kiedy ostatnio udzieli³eœ mi „pomocy”, wpad³am w straszliwe k³opoty i skoñczy³am, walcz¹c o ¿ycie z moim bratem. Tym razem podziêkujê!~
@4155 = ~Hmm. Nie sposób odmówiæ ci racji. Mia³em zostaæ w Targowie, ale w zwi¹zku z takim obrotem spraw bêdê zmierzaæ do Athkatli, ¿eby spotkaæ siê z Liefem. Znaj¹c go, pewnie siedzi w Norze Siedmiu Dolin. Przypuszczam, ¿e zabawiê w mieœcie kilka tygodni.~
@4156 = ~„W Athkatli” – pewnie nie otrzymam od ciebie bardziej precyzyjnych informacji, hê? Na twoim miejscu zatrzyma³bym siê w Norze Siedmiu Dolin. Kiedy ostatnio tam by³em, otworzyli w³aœnie bary³kê bardzo przyjemnej Zimowej Gorza³ki. To powinno zaj¹æ ciebie i Liefa na jakiœ czas, a mnie u³atwi znalezienie was w razie potrzeby.~ ~„W Athkatli” – pewnie nie otrzymam od ciebie bardziej precyzyjnych informacji, hê? Na twoim miejscu zatrzyma³abym siê w Norze Siedmiu Dolin. Kiedy ostatnio tam by³am, otworzyli w³aœnie bary³kê bardzo przyjemnej Zimowej Gorza³ki. To powinno zaj¹æ ciebie i Liefa na jakiœ czas, a mnie u³atwi znalezienie was w razie potrzeby.~
@4157 = ~Jeœli ciê znajdê, nie ma sprawy. Jeœli nie, nie bêdê ciê œcigaæ.~
@4158 = ~Och, jestem pewien, ze znów gdzieœ na siebie wpadniemy. Do tego czasu niech Mystra nad tob¹ czuwa. A teraz, <CHARNAME>, wybacz, ale naprawdê muszê ju¿ iœæ.~
@4159 = ~No có¿, niewa¿ne. Jestem pewien, ze znów gdzieœ na siebie wpadniemy. Do tego czasu niech Mystra nad tob¹ czuwa. A teraz, <CHARNAME>, wybacz, ale naprawdê muszê ju¿ iœæ.~
@4160 = ~No có¿, niewa¿ne. To pewnie nic takiego. Jestem pewien, ze znów gdzieœ na siebie wpadniemy. Bywaj.~
@4161 = ~Trochê szpiegowskiej roboty, nic wielkiego. Lief pisze, ¿e ma³e nadmorskie miasteczko na pó³noc od Twierdzy Stra¿nika zaczê³o siê dziwnie zachowywaæ. To znaczy jego mieszkañcy, nie sama miejscowoœæ! Wygl¹da na to, ¿e wszyscy jednoczeœnie odeszli, porzucaj¹c swe domy bez wyraŸnego powodu! Jeœli nie masz nic przeciwko ma³emu rekonesansowi, by³bym wdziêczny za rozejrzenie siê i doniesienie mi, co siê tam dzieje.~
@4162 = ~Bêdê z Liefem w Norze Siedmiu Dolin. Tam mo¿esz mnie znaleŸæ.~
@4163 = ~Przyznajê, ¿e mog³em siê bardzo pomyliæ co do Garaliala Geltaratha. Jeœli rzeczywiœcie tak by³o, mam mu wiele do wynagrodzenia.~

//*************************************************************************
// Maredudd Bengoch
@4200 = ~Kim ty jesteœ, na Dziewiêæ Piekie³? Nie, czekaj, nawet nie chcê wiedzieæ. Po prostu wynoœ siê st¹d.~ 
@4201 = ~Coœ s³abe to powitanie, nie s¹dzisz?~
@4202 = ~Za kogo ty siê uwa¿asz, ¿e tak siê do mnie odzywasz?~ 
@4203 = ~Ja nie jestem od powitañ, tylko od po¿egnañ – takich raz na zawsze.~
@4204 = ~Szukam Maredudda Bengocha – czy to ty?~ 
@4205 = ~To niezbyt sympatyczne.~
@4206 = ~Bo nie jestem sympatycznym goœciem. Gadaj, o co ci chodzi, a potem znikaj.~
@4207 = ~Chcê kupiæ trochê czarnego lotosu.~ 
@4208 = ~Przychodzisz do niew³aœciwej osoby. Nie wiem, o czym mówisz.~
@4209 = ~Powiedziano mi, ¿e znajdê tu Maredudda Bengocha. Czy to ty?~ 
@4210 = ~Och, powiedziano mi, ¿e bêdziesz móg³ mi z tym pomóc.~
@4211 = ~A kto chce wiedzieæ?~
@4212 = ~Jestem <CHARNAME>. Szukam Maredudda Bengocha – czy to ty?~ 
@4213 = ~Jestem <CHARNAME>. Powiedziano mi, ¿e bêdzie móg³ mi pomóc.~
@4214 = ~Nigdy nie s³ysza³em tego nazwiska. Dlaczego chcesz z nim rozmawiaæ?~ 
@4215 = ~Podobno mo¿e mi pomóc.~
@4216 = ~Kto by³ na tyle g³upi, ¿eby ci to powiedzieæ?~
@4217 = ~Mordaran Skalna Piêœæ.~
@4218 = ~Megred Darlesson.~ 
@4219 = ~Ailoth Tam.~
@4220 = ~Wiedzia³em, ¿e temu nêdznemu robakowi nie mo¿na ufaæ! Tak, jestem Maredudd Bengoch. A teraz mów, o co ci chodzi, zanim naprawdê stracê cierpliwoœæ.~ 
@4221 = ~Cieszê siê, ¿e wreszcie ciê znalaz³em. Mam dla ciebie wiadomoœæ.~ ~Cieszê siê, ¿e wreszcie ciê znalaz³am. Mam dla ciebie wiadomoœæ.~ 
@4222 = ~O co mi chodzi? To tak... Te wszystkie zaka³y zajmuj¹ce Warowniê Cerendora pad³y. Megred Darlesson nie ¿yje. Karawana zosta³a zniszczona. Twoje ¿a³osne namiastki stra¿ników te¿ le¿¹ martwe, a ostatni ³adunek czarnego lotosu ju¿ butwieje. Ca³kiem nieŸle posprz¹tane, choæ to tylko moje zdanie. Czy to odpowiada na twoje pytanie?~
@4223 = ~A wiêc to tak, panie wygadany? Chyba dorobiê ci drugi uœmiech kilka centymetrów poni¿ej oryginalnego!~ ~A wiêc to tak, pani wygadana? Chyba dorobiê ci drugi uœmiech kilka centymetrów poni¿ej oryginalnego!~ 
@4224 = ~Wyksztuœ to z siebie. Tracê cierpliwoœæ.~
@4225 = ~Nie bêdzie wiêcej transportów czarnego lotosu na Wybrze¿e Mieczy przez Warowniê Cerendora. Megred Darlesson odszed³ na „emeryturê”, podobnie jak Mordaran Skalna Piêœæ. Ostatnia karawana nie przekroczy³a Chmurnych Szczytów, jej podró¿ zakoñczy³a siê stosem pogrzebowym dla pewnego ca³kiem drogiego towaru.~
@4226 = ~CO?! Kto przekaza³ ci tak¹ wiadomoœæ? Odpowiadaj, zanim poder¿nê gard³o twoje, jak i tego kogoœ!~
@4227 = ~Ja sam.~ ~Ja sama.~
@4228 = ~Nie, nie – chyba Ÿle us³ysza³em. Powiedzia³eœ, ¿e sam sobie przekaza³eœ wiadomoœæ?~ ~Nie, nie – chyba Ÿle us³ysza³em. Powiedzia³aœ, ¿e sama sobie przekaza³aœ wiadomoœæ?~
@4229 = ~Zgadza siê. Twoje dni szmuglowania czarnego lotosu na Wybrze¿e Mieczy dobieg³y koñca. Ca³a linia zaopatrzenia zosta³a zerwana. Warownia Cerendora nie jest ju¿ w rêkach twoich ludzi, a wiêkszoœæ uczestników tej ca³ej dzia³alnoœci zaginê³a, nie ¿yje lub lada chwila zginie. Masz dwie mo¿liwoœci: wróciæ na wyspy Moonshae albo oddaæ siê w rêce tutejszego wymiaru sprawiedliwoœci.~
@4230 = ~Tak siê sk³ada, ¿e mia³em swój udzia³ w tych wszystkich wydarzeniach, a wytropienie ciebie kosztowa³o mnie du¿o czasu i wysi³ku. Twoje dni szmuglowania czarnego lotosu na Wybrze¿e Mieczy dobieg³y koñca. Ca³a linia zaopatrzenia zosta³a zerwana. Warownia Cerendora nie jest ju¿ w rêkach twoich ludzi, a wiêkszoœæ uczestników tej narkotykowej dzia³alnoœci zaginê³a, nie ¿yje lub lada chwila zginie. Osobiœcie mam ju¿ doœæ tego bezsensownego rozlewu krwi, wiêc dajê ci dwie mo¿liwoœci: mo¿esz wróciæ na wyspy Moonshae albo oddaæ siê w rêce tutejszego wymiaru sprawiedliwoœci. ~ ~Tak siê sk³ada, ¿e mia³am swój udzia³ w tych wszystkich wydarzeniach, a wytropienie ciebie kosztowa³o mnie du¿o czasu i wysi³ku. Twoje dni szmuglowania czarnego lotosu na Wybrze¿e Mieczy dobieg³y koñca. Ca³a linia zaopatrzenia zosta³a zerwana. Warownia Cerendora nie jest ju¿ w rêkach twoich ludzi, a wiêkszoœæ uczestników tej narkotykowej dzia³alnoœci zaginê³a, nie ¿yje lub lada chwila zginie. Osobiœcie mam ju¿ doœæ tego bezsensownego rozlewu krwi, wiêc dajê ci dwie mo¿liwoœci: mo¿esz wróciæ na wyspy Moonshae albo oddaæ siê w rêce tutejszego wymiaru sprawiedliwoœci. ~
@4231 = ~Zapomnia³eœ o trzeciej mo¿liwoœci, ty cuchn¹cy padalcu!~ ~Zapomnia³aœ o trzeciej mo¿liwoœci, ty cuchn¹ca gnido!~
@4232 = ~Chcesz powiedzieæ, ¿e WSZYSTKO zniszczone? Wszystko? Thay? Calimport? Homen Odesseiron? Pasza Baadilhaela? Oni te¿ nie ¿yj¹? Nie wierzê, ¿e zabi³eœ maga z Thay. To po prostu niemo¿liwe!~ ~Chcesz powiedzieæ, ¿e WSZYSTKO zniszczone? Wszystko? Thay? Calimport? Homen Odesseiron? Pasza Baadilhaela? Oni te¿ nie ¿yj¹? Nie wierzê, ¿e zabi³aœ maga z Thay. To po prostu niemo¿liwe!~
@4233 = ~Wiem z pierwszej rêki, ¿e Elminster jest w drodze do Calimportu, ¿eby uci¹æ sobie d³u¿sz¹ pogawêdkê z pasz¹ Baadilhael¹. A co potem, nie wiem. Ciekawe, jak d³ugo Odesseiron pozostanie jednym z tharchionów Thay.~
@4234 = ~Homen Odesseiron dosta³ porz¹dnego prztyczka w nos. Przypuszczam, ¿e zechce zemœciæ siê na Calimporcie. Bêdzie przekonany, ¿e to pasza Baadilhaela go oszuka³ i raczej nikt nie zaryzykuje w³asnego ¿ycia, by wyprowadziæ go z tego b³êdu.~
@4235 = ~A wiêc stajesz przede mn¹ i bezczelnie oznajmiasz, ¿e zniszczy³eœ mój bardzo dochodowy interes, a po tym wszystkim liczysz, ¿e odejdziesz w jednym kawa³ku? Wiesz co? Sam w to nie wierzê, ale w³aœnie tak siê stanie. Wieœci o Warowni Cerendora dosta³em kilka dni temu, a jeden z moich ludzi znalaz³ wczoraj szcz¹tki karawany.~ ~A wiêc stajesz przede mn¹ i bezczelnie oznajmiasz, ¿e zniszczy³aœ mój bardzo dochodowy interes, a po tym wszystkim liczysz, ¿e odejdziesz w jednym kawa³ku? Wiesz co? Sam w to nie wierzê, ale w³aœnie tak siê stanie. Wieœci o Warowni Cerendora dosta³em kilka dni temu, a jeden z moich ludzi znalaz³ wczoraj szcz¹tki karawany.~
@4236 = ~Wiêc to przez ciebie wszystko tak siê posypa³o. Zastanawia³em siê, kto móg³ byæ tak potê¿ny, ¿e zdo³a³ zniszczyæ wszystko, co tak d³ugo organizowa³em, a teraz poznajê ciê. Jesteœ tym po trzykroæ przeklêtym pomiotem Bhaala, który narobi³ tyle zamieszania na ca³ym Wybrze¿u Mieczy – st¹d a¿ po Wrota Baldura.~
@4237 = ~Od³ó¿cie broñ, ch³opcy. Wiem, kiedy warto walczyæ, a kiedy nale¿y siê poddaæ. Tylko dlatego tak d³ugo uda³o mi siê przetrwaæ w tym przemytniczym fachu. Powrót na wyspy Moonshae sobie darujê, choæ mam wra¿enie, ¿e tutejszy sêdzia nie bêdzie bardziej wyrozumia³y. Ale tu przynajmniej ocalê g³owê, w domu nie by³oby na to szansy.~
@4238 = ~Co do ciebie, jakkolwiek siê tam nazywasz, w innych okolicznoœciach znalaz³bym dla ciebie robotê w mojej organizacji. Jesteœ zbyt niebezpieczny, by tak ciê puœciæ samopas.~ ~Co do ciebie, jakkolwiek siê tam nazywasz, w innych okolicznoœciach znalaz³bym dla ciebie robotê w mojej organizacji. Jesteœ zbyt niebezpieczna, by tak ciê puœciæ samopas.~
@4239 = ~Oddaj siê w rêce w³adz, Bengoch. Za parê dni bêdê siê dopytywaæ o ciebie, a jeœli spróbujesz uciec, znów pod¹¿ê twoim tropem.~
@4240 = ~Ailoth Tam – tak, pamiêtasz go? – powiedzia³ mi, ¿e próbujesz szmuglowaæ czarny lotos wzd³u¿ i wszerz Wybrze¿a Mieczy. Nie podoba mi siê to. Nie podoba mi siê takie rujnowanie ludzkiego ¿ycia tylko dla w³asnego zysku.~
@4241 = ~Ailoth Tam powiedzia³ mi, ¿e próbujesz szmuglowaæ czarny lotos wzd³u¿ i wszerz Wybrze¿a Mieczy. Nie podoba mi siê to. Nie widzi mi siê rujnowanie czyjegoœ ¿ycia dla wype³nienia twojej sakiewki.~
@4242 = ~Nie podoba ci siê? Jaka szkoda. I pewnie chcesz coœ z tym zrobiæ, co?~
@4243 = ~Taki mam zamiar. Twoje dni szmuglowania czarnego lotosu na Wybrze¿e Mieczy dobieg³y koñca. Ca³a linia zaopatrzenia zosta³a zerwana. Warownia Cerendora nie jest ju¿ w rêkach twoich ludzi, a wiêkszoœæ uczestników tej dzia³alnoœci zaginê³a, nie ¿yje lub lada chwila zginie, w³¹czaj¹c w to karawanê, na której przybycie czekasz. Dajê ci dwie mo¿liwoœci: mo¿esz wróciæ na wyspy Moonshae albo oddaæ siê w rêce tutejszego wymiaru sprawiedliwoœci.~
@4244 = ~W zasadzie tak, zw³aszcza ¿e wytropienie ciebie kosztowa³o mnie du¿o czasu i wysi³ku. Twoje dni szmuglowania czarnego lotosu na Wybrze¿e Mieczy dobieg³y koñca. Ca³a linia zaopatrzenia zosta³a zerwana. Warownia Cerendora nie jest ju¿ w rêkach twoich ludzi, a wiêkszoœæ uczestników tej narkotykowej dzia³alnoœci zaginê³a, nie ¿yje lub lada chwila zginie, w³¹czaj¹c w to karawanê, na której przybycie czekasz. Osobiœcie mam ju¿ doœæ tego bezsensownego rozlewu krwi, wiêc dajê ci dwie mo¿liwoœci: mo¿esz wróciæ na wyspy Moonshae albo oddaæ siê w rêce tutejszego wymiaru sprawiedliwoœci.~
@4245 = ~Wiêc to przez ciebie wszystko tak siê posypa³o. Zastanawia³em siê, kto móg³ byæ tak potê¿ny, ¿e zdo³a³ zniszczyæ wszystko, co tak d³ugo organizowa³em, a teraz poznajê ciê. Jesteœ tym po trzykroæ przeklêtym pomiotem Bhaala, który narobi³ tyle zamieszania na ca³ym Wybrze¿u Mieczy – st¹d a¿ po Wrota Baldura. A teraz stajesz przede mn¹ i bezczelnie oznajmiasz, ¿e zniszczy³eœ mój bardzo dochodowy interes, a po tym wszystkim liczysz, ¿e odejdziesz w jednym kawa³ku?~ ~Wiêc to przez ciebie wszystko tak siê posypa³o. Zastanawia³em siê, kto móg³ byæ tak potê¿ny, ¿e zdo³a³ zniszczyæ wszystko, co tak d³ugo organizowa³em, a teraz poznajê ciê. Jesteœ tym po trzykroæ przeklêtym pomiotem Bhaala, który narobi³ tyle zamieszania na ca³ym Wybrze¿u Mieczy – st¹d a¿ po Wrota Baldura. A teraz stajesz przede mn¹ i bezczelnie oznajmiasz, ¿e zniszczy³aœ mój bardzo dochodowy interes, a po tym wszystkim liczysz, ¿e odejdziesz w jednym kawa³ku?~
@4246 = ~Wiesz co? Sam w to nie wierzê, ale w³aœnie tak siê stanie. Mogê mieæ tylko nadziejê na to, ¿e Mordaran Skalna Piêœæ i jego ch³opcy jakoœ ciê dorw¹, ale jakoœ mi siê to nie widzi.~
@4247 = ~Od³ó¿cie broñ, ch³opcy. Wiem, kiedy warto walczyæ, a kiedy nale¿y siê poddaæ. Tylko dlatego tak d³ugo uda³o mi siê przetrwaæ w tym przemytniczym fachu. Powrót na wyspy Moonshae sobie darujê, choæ mam wra¿enie, ¿e tutejszy sêdzia nie bêdzie bardziej wyrozumia³y. Ale tu przynajmniej ocalê g³owê, w domu nie by³oby na to szansy.~
@4248 = ~Co do ciebie, pomiocie Bhaala, jakkolwiek siê tam nazywasz, w innych okolicznoœciach znalaz³bym dla ciebie robotê w mojej organizacji. Jesteœ zbyt niebezpieczny, by tak ciê puœciæ samopas.~ ~Co do ciebie, pomiocie Bhaala, jakkolwiek siê tam nazywasz, w innych okolicznoœciach znalaz³bym dla ciebie robotê w mojej organizacji. Jesteœ zbyt niebezpieczna, by tak ciê puœciæ samopas.~
@4249 = ~Oddaj siê w rêce w³adz, Bengoch. A jeœli dowiem siê, ¿e uciek³eœ, to znów pod¹¿ê twoim tropem i tym razem ju¿ nie ujdziesz z ¿yciem.~

//*************************************************************************
// Karim
@4260 = ~Znowu ty! Nie mam ochoty z tob¹ rozmawiaæ.~
@4261 = ~Jehano.... *wzdycha*.... Jehano.... *mamrocze coœ pod nosem i ignoruje ciê*~
@4262 = ~Och... Co-co...?!~
@4263 = ~Spokojnie. Nie mam wrogich zamiarów.~
@4264 = ~Hê?~
@4265 = ~Co-co? Jesteœ jakimœ ma³ym zwierz¹tkiem?~
@4266 = ~Bardzo przepraszam, ale wystraszy³eœ mnie, a kiedy siê bojê, myœlenie nie wychodzi mi najlepiej.~ ~Bardzo przepraszam, ale wystraszy³aœ mnie, a kiedy siê bojê, myœlenie nie wychodzi mi najlepiej.~
@4267 = ~Kim jesteœ?~
@4268 = ~NajwyraŸniej myœlami by³eœ daleko st¹d.~
@4269 = ~Jestem Karim, syn Tahira.~
@4270 = ~Syn Tahira, tak? Có¿, Karimie, jestem <CHARNAME>. Powiedz, dlaczego tak bardzo ciê wystraszy³em? Nie s³ysza³eœ moich kroków? By³em doœæ g³oœny.~ ~Syn Tahira, tak? Có¿ Karimie, jestem <CHARNAME>. Powiedz, dlaczego tak bardzo ciê wystraszy³am? Nie s³ysza³eœ moich kroków? By³am doœæ g³oœna.~
@4271 = ~Wcale nie tak daleko, nie. W³aœciwie to w zasiêgu wzroku. Proszê, wybacz ten brak taktu. Jestem Karim, syn Tahira.~
@4272 = ~Powiem ci, jeœli obiecasz, ¿e nie bêdziesz siê œmiaæ. Wszyscy siê œmiej¹ poza moim ojcem. On tylko robi ponur¹ minê i krêci g³ow¹ z dezaprobat¹.~
@4273 = ~Obiecujê, ¿e nie bêdê siê œmiaæ.~
@4274 = ~Nie wiem, czy mogê ci to obiecaæ, Karimie.~
@4275 = ~Có¿, wygl¹dasz na honorow¹ osobê, wiêc ci powiem. Rozmyœlam o Jehanie, mojej ukochanej.~
@4276 = ~Jehana? Kim ona jest?~
@4277 = ~No taaak. Chyba wiem, dok¹d to zmierza. ¯egnaj, Karimie. Mam nadziejê, ze wkrótce zdobêdziesz obiekt swych pragnieñ.~
@4278 = ~W tym w³aœnie problem. Jehana jest córk¹ Mukhtara, a Mukhtar jest praw¹ rêk¹ Qadira, przywódcy Pustynnych Wêdrowców. Jest warta wielu koni i wiele z³ota, znacznie wiêcej ni¿ posiada i bêdzie w stanie kiedykolwiek zdobyæ mój ojciec. Ona mnie kocha, a ja kocham j¹. Jehana... Jehana.... sam dŸwiêk jej imienia jest dla mych uszu piêkn¹ muzyk¹. „Piêkny kwiat” – takie jest znaczenie jej imienia. Wiedzia³eœ o tym?~ ~W tym w³aœnie problem. Jehana jest córk¹ Mukhtara, a Mukhtar jest praw¹ rêk¹ Qadira, przywódcy Pustynnych Wêdrowców. Jest warta wielu koni i wiele z³ota, znacznie wiêcej ni¿ posiada i bêdzie w stanie kiedykolwiek zdobyæ mój ojciec. Ona mnie kocha, a ja kocham j¹. Jehana... Jehana.... sam dŸwiêk jej imienia jest dla mych uszu piêkn¹ muzyk¹. „Piêkny kwiat” – takie jest znaczenie jej imienia. Wiedzia³aœ o tym?~
@4279 = ~Nie, Karimie, nie wiedzia³em.~ ~Nie, Karimie, nie wiedzia³am.~
@4280 = ~Tak, Karimie, wiedzia³em.~ ~Tak, Karimie, wiedzia³am.~
@4281 = ~Nauczy³eœ siê zatem czegoœ nowego, czegoœ piêknego. Jak kwiat... Jehana... *wzdycha*.~ ~Nauczy³aœ siê zatem czegoœ nowego, czegoœ piêknego. Jak kwiat... Jehana... *wzdycha*.~
@4282 = ~Co masz zamiar z tym zrobiæ?~
@4283 = ~Dziêkujê za opowieœæ o Jehanie, Karimie; wydaje siê naprawdê wspania³a. Teraz jednak muszê pomówiæ z twoim ojcem. Do widzenia.~
@4284 = ~„Piêkny kwiat” *wzdycha*. ~
@4285 = ~Dziêkujê za opowieœæ o Jehanie, Karimie, ale naprawdê muszê ju¿ iœæ. Mam nadziejê, ¿e wkrótce zdobêdziesz obiekt swoich pragnieñ.~
@4286 = ~*Karim spogl¹da w dal i ignoruje ciê*~
@4287 = ~Emm... eee... mo¿e móg³byœ...?~ ~Emm... eee... mo¿e mog³abyœ...?~
@4288 = ~Co takiego?~
@4289 = ~Chyba wiem, dok¹d do zmierza. ¯egnaj, Karimie. Mam nadziejê, ze wkrótce zdobêdziesz obiekt swych pragnieñ.~
@4290 = ~Czy... móg³byœ porozmawiaæ z Mukhtarem w moim imieniu? Proszê. Zrobi³bym wszystko, ¿eby zdobyæ Jehanê. Wszystko!!!~ ~Czy... mog³abyœ porozmawiaæ z Mukhtarem w moim imieniu? Proszê. Zrobi³bym wszystko, ¿eby zdobyæ Jehanê. Wszystko!!!~
@4291 = ~„Wszystko”, Karimie? Wszystko to bardzo du¿o.~
@4292 = ~Co mam powiedzieæ Mukhtarowi?~
@4293 = ~Wszystko!!!!~
@4294 = ~Co mam wiêc powiedzieæ Mukhtarowi?~
@4295 = ~Zapytaj go, jaka jest cena za narzeczon¹!~
@4296 = ~Cena za narzeczon¹? Nie jesteœ trochê za m³ody na ma³¿eñstwo?~
@4297 = ~Zgoda. Dowiem siê, co Mukhtar ma na ten temat do powiedzenia.~
@4298 = ~Jestem starszy ni¿ mój ojciec, kiedy zap³aci³ za moj¹ matkê. Jestem w odpowiednim wieku.~
@4299 = ~Mnie nie wydajesz siê dostatecznie dojrza³y, Karimie. Nie, nie mogê tego zrobiæ. Nie bez pozwolenia Tahira.~
@4300 = ~Mój ojciec nie da mi swojej zgody! IdŸ st¹d i zostaw mnie w spokoju!~
@4301 = ~Jestem Karim, syn Tahira, a ty – kimkolwiek jesteœ – najlepiej zostaw mnie w spokoju!~
@4302 = ~Tak? Rozmawia³eœ Mukhtarem? Jaka jest cena za jego córkê?~ ~Tak? Rozmawia³aœ Mukhtarem? Jaka jest cena za jego córkê?~
@4303 = ~Rozmawia³em z Mukhtarem. Mówi, ¿e nie ¿yczy sobie, ¿ebyœ zaleca³ siê do jego córki. W³aœciwie nie by³oby z twojej strony najrozs¹dniejsze krêciæ siê w pobli¿u obozu Wêdrowców, jeœli chcesz zachowaæ wszystkie czêœci cia³a.~ ~Rozmawia³am z Mukhtarem. Mówi, ¿e nie ¿yczy sobie, ¿ebyœ zaleca³ siê do jego córki. W³aœciwie nie by³oby z twojej strony najrozs¹dniejsze krêciæ siê w pobli¿u obozu Wêdrowców, jeœli chcesz zachowaæ wszystkie czêœci cia³a.~
@4304 = ~Niemo¿liwe... Naprawdê tak powiedzia³?~
@4305 = ~By³ bardzo powa¿ny. Zagrozi³, ¿e obetnie ci to i owo, jeœli siê tam pojawisz.~
@4306 = ~Nieee! Jehana, moja Jehana, moja ukochana Jehana. Jak mogê ¿yæ bez ciebie? *chlip* Jehana! *chlip*~
@4307 = ~Rozmawia³em z Mukhtarem. Nie ustali³ na razie ceny. Zamiast tego postanowi³, ¿e przez rok nie masz prawa spotykaæ siê i rozmawiaæ z Jehan¹. Jeœli po tym czasie wasze uczucia pozostan¹ niezmienne, wyznaczy cenê.~ ~Rozmawia³am z Mukhtarem. Nie ustali³ na razie ceny. Zamiast tego postanowi³, ¿e przez rok nie masz prawa spotykaæ siê i rozmawiaæ z Jehan¹. Jeœli po tym czasie wasze uczucia pozostan¹ niezmienne, wyznaczy cenê.~
@4308 = ~I tak nie da³byœ rady zap³aciæ, wiêc zapomnij o tym.~
@4309 = ~Ca³y rok...! Umrê przez ten czas! Och, co siê ze mn¹ stanie bez Jehany? Mojej Jehany? *chlip*~
@4310 = ~Rozmawia³em z Mukhtarem, a on rozmawia³ z Jehan¹.~ ~Rozmawia³am z Mukhtarem, a on rozmawia³ z Jehan¹.~
@4311 = ~Tak? Tak? Co ci powiedzia³?~
@4312 = ~Przykro mi, Karimie, ale Jehana powiedzia³a, ¿e nie mo¿e za ciebie wyjœæ.~
@4313 = ~Jehana powiedzia³a, ¿e nie mo¿e na ciebie patrzeæ.~
@4314 = ~Nie! Nie wierzê ci! Nie powiedzia³aby tak... Ja j¹ kocham! *chlip*~
@4315 = ~Taki jest œwiat, Karimie.~
@4316 = ~Ty...! Ty...! Nienawidzê ciê! Ok³amujesz mnie! Zostaw mnie w spokoju!~
@4317 = ~Och, doroœnij i przestañ skamleæ. Morze jest pe³ne ryb... a pustynia wielb³¹dów, jeœli wiesz, gdzie szukaæ.~
@4318 = ~Ty...! Ty k³amco! Nienawidzê ciê! Zostaw mnie w spokoju!~
@4319 = ~Och, doroœnij i przestañ skamleæ.~

//*************************************************************************
// Mukhtar
@4330 = ~Tak?~
@4331 = ~Jesteœ Mukhtar, ojciec Jehany?~
@4332 = ~Wybacz, nie chcia³em ciê niepokoiæ.~ ~Wybacz, nie chcia³am ciê niepokoiæ.~
@4333 = ~Nic.~
@4334 = ~Jestem. Co z tego?~
@4335 = ~Rozmawia³em z Karimem, synem Tahira. Wygl¹da na to, ¿e zakocha³ siê w twojej córce.~ ~Rozmawia³am z Karimem, synem Tahira. Wygl¹da na to, ¿e zakocha³ siê w twojej córce.~
@4336 = ~Nic, chcia³em siê tylko upewniæ.~ ~Nic, chcia³am siê tylko upewniæ.~
@4337 = ~S³ysza³em o tym. Moja córka nie poœlubi nikogo spoza Ludzi pustyni. To moje ostatnie s³owo. Jeœli siê do niej choæ zbli¿y, bêdzie wraca³ do domu, trzymaj¹c swoje przyrodzenie w zêbach. Powtórz mu to.~
@4338 = ~Jak sobie ¿yczysz.~
@4339 = ~S³ysza³em. Co tym razem wymyœli³?~
@4340 = ~Chce, ¿ebyœ wyznaczy³ cenê za jej rêkê.~
@4341 = ~Niewa¿ne. Niech sam rozwi¹zuje swoje problemy.~
@4342 = ~Cechujesz siê pewn¹ m¹droœci¹ jak na przybysza z Pó³nocy. Powiedz mu, ¿e moja córka nie poœlubi nikogo spoza Ludzi pustyni. To moje ostatnie s³owo. Jeœli choæby zbli¿y siê do niej, bêdzie wraca³ do domu, targaj¹c swoje przyrodzenie w zêbach. Powtórz mu to.~
@4343 = ~Cenê za narzeczon¹, tak? Rzeczywiœcie nabra³ odwagi! Dlaczego s¹dzi, ¿e jest wystarczaj¹co dobry dla mojej córki?~
@4344 = ~Ech. Nie jestem pewien, czy jest wystarczaj¹co dojrza³y, ¿eby rozumieæ, o co prosi. Co Jehana myœli o tym wszystkim?~ ~Ech. Nie jestem pewna, czy jest wystarczaj¹co dojrza³y, ¿eby rozumieæ, o co prosi. Co Jehana myœli o tym wszystkim?~
@4345 = ~Wierzy, ¿e jest jej godny.~
@4346 = ~Jest tak samo og³upia³a na jego punkcie, jak on na jej. Ale zgadzam siê z tob¹, s¹ zbyt m³odzi. Co do zasady nie jestem przeciwny temu zwi¹zkowi. Tahir to dobry cz³owiek, a jego syn zosta³ wychowany zgodnie z tradycj¹ pustyni. Powiedz mu, ¿e musi zaczekaæ rok. To powinno ostudziæ obie te gor¹ce g³owy.~
@4347 = ~Tak zrobiê.~
@4348 = ~Nie mam zamiaru oddawaæ córki mieszczuchowi, a ju¿ na pewno nie takiemu m³okosowi, nawet jeœli jego ojciec jest bogatszy od wiêkszoœci mieszkañców Imradim. SprawdŸmy jednak, co Jehana ma do powiedzenia na ten temat. Czego pragniesz, córko?~
@4349 = ~I co ty na to, przybyszu z Pó³nocy?~ ~I co ty na to, przybyszko z Pó³nocy?~
@4350 = ~Wygl¹da mi na zdecydowan¹ odpowiedŸ. Przeka¿ê twe s³owa Karimowi.~
@4351 = ~Wyjœæ za Karima, ojcze? Nie chcia³abym, ¿eby moje martwe cia³o przebywa³o w tym samym pomieszczeniu, co on! Jest taki pró¿ny i... b³eee! Okropny cz³owiek!~

//*************************************************************************
// Przenoœny portal
@4360 = ~Unosisz przenoœny portal i ogl¹dasz go dok³adnie.~
@4361 = ~U¿yj portalu.~
