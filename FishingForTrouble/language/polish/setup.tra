@1500 = ~TY!!!~
@1501 = ~Tak, ja. I co z tego? Jestem tu, by ciê uratowaæ.~
@1502 = ~Wys³a³eœ mnie, bym zgni³a tu jak jakiœ niewydarzony Z³odziej Cienia, a teraz spodziewasz siê wdziêcznoœci? Niech ciê Dziewiêæ Piekie³ poch³onie, zanim sama ciê tam poœlê!~ ~Wys³a³aœ mnie, bym zgni³a tu jak jakiœ niewydarzony Z³odziej Cienia, a teraz spodziewasz siê wdziêcznoœci? Niech ciê Dziewiêæ Piekie³ poch³onie, zanim sama ciê tam poœlê!~
@1503 = ~Przyby³em tu, by zabraæ ciê z powrotem do Athkatli... po tym jak rozprawi³em siê tym Jonem Irenicusem.~ ~Przyby³am tu, by zabraæ ciê z powrotem do Athkatli... po tym jak rozprawi³am siê tym Jonem Irenicusem.~
@1504 = ~Sama znajdê drogê powrotn¹ do Athkatli, mê¿czyzno! Mam nadziejê, ¿e nigdy ju¿ nie ujrzê twojej twarzy!~ ~Sama znajdê drogê powrotn¹ do Athkatli, kobieto! Mam nadziejê, ¿e nigdy ju¿ nie ujrzê twojej twarzy!~
@1505 = ~Mo¿e tak, mo¿e nie.~
@1506 = ~Ty! Je-jesteœ tu, by mnie st¹d zabraæ?~
@1507 = ~Tak... i by ciê odprowadziæ do Athkatli, po tym jak rozprawi³em siê z tym Jonem Irenicusem.~ ~Tak... i by ciê odprowadziæ do Athkatli, po tym jak rozprawi³am siê z tym Jonem Irenicusem.~
@1508 = ~Irenicus. Wielki lalkarz. Wiêzieñ rz¹dz¹cy przytu³kiem. Czeka na ciebie, wiesz?~
@1509 = ~Wiem. Wykorzysta³ moj¹ siostrê, Imoen, jako przynêtê, ¿eby mnie tu przyci¹gn¹æ; a teraz sprawiê, ¿e bêdzie za to cierpia³.~
@1510 = ~I co z tego? Niech czeka, jestem wystarczaj¹co silny, by go pokonaæ.~ ~I co z tego? Niech czeka, jestem wystarczaj¹co silna, by go pokonaæ.~
@1511 = ~Có¿ za arogancja! Có¿ za duma! Czemu myœlisz, ¿e mo¿esz z nim siê równaæ?~
@1512 = ~Przetrwa³em jego najgorsze mêczarnie i „testy”, a teraz jestem tu, by siê zemœciæ. On to wie – pragnie mojej duszy, ale to ja zdobêdê jego!~ ~Przetrwa³am jego najgorsze mêczarnie i „testy”, a teraz jestem tu, by siê zemœciæ. On to wie – pragnie mojej duszy, ale to ja zdobêdê jego!~
@1513 = ~Wiêc mówi prawdê – jesteœ Dzieckiem Bhaala.~
@1514 = ~Tak – i jestem z tego dumny. Ty tutaj zostañ i dalej dygocz ze strachu, ja idê rozprawiæ siê z tym upad³ym elfem. Wrócê po ciebie póŸniej.~ ~Tak – i jestem z tego dumna. Ty tutaj zostañ i dalej dygocz ze strachu, ja idê rozprawiæ siê z tym upad³ym elfem. Wrócê po ciebie póŸniej.~
@1515 = ~Sama znajdê drogê powrotn¹ do Athkatli, mê¿czyzno! Mam nadziejê, ¿e nigdy ju¿ nie ujrzê twojej twarzy, ale coœ mi mówi, ¿e bêdê rozczarowana!~ ~Sama znajdê drogê powrotn¹ do Athkatli, kobieto! Mam nadziejê, ¿e nigdy ju¿ nie ujrzê twojej twarzy, ale coœ mi mówi, ¿e bêdê rozczarowana!~
@1516 = ~Twoja siostra – czy ona jeszcze ¿yje?~
@1517 = ~Z pewnoœci¹ – wiedzia³bym, gdyby by³o inaczej.~ ~Z pewnoœci¹ – wiedzia³abym, gdyby by³o inaczej.~
@1518 = ~Czy ON ma racjê? Czy... czy jesteœ Dzieckiem Bhaala?~
@1519 = ~Tak.~
@1520 = ~Ale teraz jest w tobie coœ innego – wiele lat temu spotka³am inne Dzieci Bhaala, wiêkszoœæ mia³a piekielne ci¹goty do siania œmierci i zniszczenia – ale nie wszyscy, ty równie¿ nie.~
@1521 = ~Te¿ mogê tak czyniæ, jeœli muszê, Lady Ceinweno, ale nie bêdzie to mój pierwszy wybór.~
@1522 = ~Nie, widzê, ¿e nie. Zobaczymy siê znów w Athkatli?~
@1523 = ~Spotkamy siê tam.~
@1524 = ~Jeœli zechcesz zaczekaæ, pomogê ci siê wydostaæ z tego miejsca.~
@1525 = ~¯egnaj, <CHARNAME>.~
@1526 = ~Do zobaczenia w Athkatli.~
@1527 = ~Nie bêdê czekaæ, <CHARNAME>. Z nielicznych kontaktów, które tutaj mam, wiem, ¿e dziœ wyp³ywa statek do Athkatli. Zamierzam siê nañ dostaæ.~
@1528 = ~¯egnaj, Lady Ceinweno. Do zobaczenia w Athkatli.~
@1529 = ~Kim jesteœ? Czego chcesz?~
@1530 = ~Czy to ty jesteœ niejaka Lady Ceinwena Kruczow³osa?~
@1531 = ~Chcia³bym wiedzieæ, czy jesteœ Ceinwena Kruczow³osa?~ ~Chcia³abym wiedzieæ, czy jesteœ Ceinwena Kruczow³osa?~
@1532 = ~Trzymaj jêzyk za zêbami i tylko odpowiedz na moje pytanie. Jesteœ Ceinwena Kruczow³osa?~
@1533 = ~Lady, co? Dawno ju¿ nikt mnie tak nie nazywa³.~
@1534 = ~Jeœli rzeczywiœcie jesteœ Lady Kruczow³osa, chcia³bym z tob¹ pomówiæ.~ ~Jeœli rzeczywiœcie jesteœ Lady Kruczow³osa, chcia³abym z tob¹ pomówiæ.~
@1535 = ~Dlaczego?~
@1536 = ~Potrzebujê jej pomocy, a dano mi do zrozumienia, ¿e tu j¹ znajdê.~
@1537 = ~Mo¿esz wyjœæ przez te same drzwi, przez które wszed³eœ. Teraz.~ ~Mo¿esz wyjœæ przez te same drzwi, przez które wesz³aœ. Teraz.~
@1538 = ~W porz¹dku – PROSZÊ, odpowiedz na moje pytanie.~
@1539 = ~Mocne s³owa, panienko. Mozesz je powtórzyæ?~
@1540 = ~Jestem Ceinwena Kruczow³osa, Pani Bia³ej Doliny. To znaczy, by³a Pani Bia³ej Doliny. Co mogê dla ciebie zrobiæ?~
@1541 = ~Jestem <CHARNAME> – Elminster poprosi³ mnie, bym zbada³ sprawê zaginiêæ mieszkañców wioski Pentyrch. Gdy tam dotarliœmy, natknêliœmy siê na tanar'ri uwiêzionego w latarni morskiej przez maga Olrena z Thay. Olren nie ¿yje; zabi³o go to samo zaklêcie, dziêki któremu schwyta³ tanar'ri.~ ~Jestem <CHARNAME> – Elminster poprosi³ mnie, bym zbada³a sprawê zaginiêæ mieszkañców wioski Pentyrch. Gdy tam dotarliœmy, natknêliœmy siê na tanar'ri uwiêzionego w latarni morskiej przez maga Olrena z Thay. Olren nie ¿yje; zabi³o go to samo zaklêcie, dziêki któremu schwyta³ tanar'ri.~
@1542 = ~No i?~
@1543 = ~Mieliœmy pewne problemy w sieci jaskiñ pod wiosk¹. Tanar'ri powiedzia³, by z tob¹ porozmawiaæ, jako ¿e jesteœ jedyn¹ osob¹, której kiedykolwiek uda³o siê zwiedziæ jaskinie.~
@1544 = ~Tak powiedzia³? A po co tanar'ri mia³by mnie obserwowaæ?~
@1545 = ~Powiedzia³, ¿e jesteœ jedyn¹ osob¹, która kiedykolwiek przesz³a przez Pu³apki ¯yj¹cych.~
@1546 = ~Nie lubiê ³ajdaków. Tam s¹ drzwi – u¿yj ich.~
@1547 = ~*kaszle* Uuuch... ty i tamten tanar'ri jesteœcie *kaszle* z tej samej gliny. Na Talosa! Kobiety i demony – czy jest miêdzy nimi jakaœ ró¿nica?~
@1548 = ~Tanar'ri? Wiêc by³eœ w Pentyrchu, prawda? Za³o¿ê siê, ¿e znalaz³eœ tanar'ri w latarni?~ ~Tanar'ri? Wiêc by³aœ w Pentyrchu, prawda? Za³o¿ê siê, ¿e znalaz³aœ tanar'ri w latarni?~
@1549 = ~Wiêc to ty jesteœ t¹ Ceinwen¹ Kruczow³os¹. Powiedzia³, ¿e zdradzisz nam, jak przebyæ przez Pu³apki ¯yj¹cych.~
@1550 = ~Pu³apki ¯yj¹cych? Masz pojêcie, o co pytasz?~
@1551 = ~NajwyraŸniej nie. Dlaczego?~
@1552 = ~Poniewa¿ musisz byæ martwy, by przez nie przejœæ. Martwy. Rozumiesz? Martwy!~ ~Poniewa¿ musisz byæ martwa, by przez nie przejœæ. Martwa. Rozumiesz? Martwa!~
@1553 = ~Ale przecie¿ tobie siê uda³o.~
@1554 = ~I nie masz ¯ADNEGO pojêcia, ile mnie to kosztowa³o. To by³a NAJG£UPSZA rzecz, jak¹ kiedykolwiek zrobi³am – na DARMO. Czego chcia³ ten tanar'ri?~
@1555 = ~Powiedzia³, ¿e w jednym z dalszych grobowców znajduje siê klucz, który pozwoli mu wróciæ na jego w³asn¹ sferê egzystencji.~
@1556 = ~Chce wróciæ do domu, prawda? – na jego miejscu te¿ bym chcia³a. Mo¿e na zawsze pozostaæ uwiêziony w tej bañce czasowej, nie chcia³abym znaleŸæ siê w takiej sytuacji. Dobrze, bêdê musia³a siê nad tym zastanowiæ. Wróæ za dwadzieœcia cztery godziny, <CHARNAME>, a zobaczê co da siê zrobiæ.~
@1557 = ~Do jutra, Lady Ceinweno.~
@1558 = ~Chce wróciæ do domu, prawda? Dobrze, bêdê musia³a siê nad tym zastanowiæ. Wróæ za dwadzieœcia cztery godziny – a w miêdzyczasie naucz siê dobrych manier, mê¿czyzno!~ ~Chce wróciæ do domu, prawda? Dobrze, bêdê musia³a siê nad tym zastanowiæ. Wróæ za dwadzieœcia cztery godziny – a w miêdzyczasie naucz siê dobrych manier, kobieto!~
@1559 = ~Byæ mo¿e. Do jutra wiêc.~
@1560 = ~Powiedzia³am dwadzieœcia cztery godziny! A teraz wyjdŸ!~
@1561 = ~Powiedzia³am dwa dni! A teraz wyjdŸ!~
@1562 = ~Porozmawiaj z tymi idiotami – mo¿e tobie powiedz¹ coœ bardziej sensownego ni¿ mi.~
@1563 = ~Chyba powinnam ci za to podziêkowaæ – cztery tysi¹ce sztuk z³ota to sporo pieniêdzy.~
@1564 = ~Hmm... to raczej spory szanta¿.~
@1565 = ~I bêdê chcia³ je z powrotem, jeœli kiedyœ uda ci siê tyle zdobyæ.~ ~I bêdê chcia³a je z powrotem, jeœli kiedyœ uda ci siê tyle zdobyæ.~
@1566 = ~Z pewnoœci¹. Mo¿e pewnego dnia ktoœ zdo³a coœ z tym zrobiæ, ale to nieprêdko nast¹pi. Oni s¹ po prostu zbyt potê¿ni.~
@1567 = ~I aroganccy.~
@1568 = ~I aroganccy. Nawet nie masz pojêcia, jak bardzo jestem ci wdziêczna za to, ¿e nie trafi³am do Czarowiêzów. Ostatnim razem, gdy rozmawialiœmy, pyta³eœ o Pu³apki ¯yj¹cych w jaskiniach pod Pentyrchem?~ ~I aroganccy. Nawet nie masz pojêcia, jak bardzo jestem ci wdziêczna za to, ¿e nie trafi³am do Czarowiêzów. Ostatnim razem, gdy rozmawialiœmy, pyta³aœ o Pu³apki ¯yj¹cych w jaskiniach pod Pentyrchem?~
@1569 = ~Tak. Chcia³em siê dowiedzieæ, jak przez nie przejœæ.~ ~Tak. Chcia³am siê dowiedzieæ, jak przez nie przejœæ.~
@1570 = ~Wiêc spotkajmy siê w moim domu za jak¹œ godzinê – muszê siê zaj¹æ paroma rzeczami, zanim dam ci odpowiedŸ.~
@1571 = ~Ha! Wygl¹da na to, ¿e ka¿dy ma swoj¹ cenê. Œmiem twierdziæ, ¿e twoj¹ cen¹ jest wskazówka, jak przejœæ przez Pu³apki ¯yj¹cych, prawda, mê¿czyzno?~ ~Ha! Wygl¹da na to, ¿e ka¿dy ma swoj¹ cenê. Œmiem twierdziæ, ¿e twoj¹ cen¹ jest wskazówka, jak przejœæ przez Pu³apki ¯yj¹cych, prawda, kobieto?~
@1572 = ~By³by to dobry pocz¹tek.~
@1573 = ~Wiêc spotkajmy siê w moim domu za jak¹œ godzinê – muszê siê wczeœniej zaj¹æ paroma rzeczami. I w miêdzyczasie naucz siê dobrych manier, mê¿czyzno, albo siê przekonasz, ¿e te cztery tysi¹ce sztuk z³ota posz³o na zmarnowanie.~ ~Wiêc spotkajmy siê w moim domu za jak¹œ godzinê – muszê siê wczeœniej zaj¹æ paroma rzeczami. I w miêdzyczasie naucz siê dobrych manier, kobieto, albo siê przekonasz, ¿e te cztery tysi¹ce sztuk z³ota posz³o na zmarnowanie.~
@1574 = ~Wydaje mi siê, i¿ powiedzia³am, ¿e nie chcê ju¿ ogl¹daæ twojej twarzy, mê¿czyzno – nigdy!~ ~Wydaje mi siê, i¿ powiedzia³am, ¿e nie chcê ju¿ ogl¹daæ twojej twarzy, kobieto – nigdy!~
@1575 = ~Có¿, pani, zdaje siê, ¿e ani ty ani ja nie mamy wielkiego wyboru. Elminster wci¹gn¹³ mnie w to, a ja g³upio siê zgodzi³em.~ ~Có¿, pani, zdaje siê, ¿e ani ty ani ja nie mamy wielkiego wyboru. Elminster wci¹gn¹³ mnie w to, a ja g³upio siê zgodzi³am.~
@1576 = ~Elminster? Dlaczego wczeœniej tego nie mówi³eœ?~ ~Elminster? Dlaczego wczeœniej tego nie mówi³aœ?~
@1577 = ~Wydawa³o mi siê, ¿e to mówi³em – ale najwyraŸniej tylko mi siê wydawa³o. I nazywam siê <CHARNAME>, pani, a nie „mê¿czyzna”.~ ~Wydawa³o mi siê, ¿e to mówi³am – ale najwyraŸniej tylko mi siê wydawa³o. I nazywam siê <CHARNAME>, pani, a nie „kobieta”.~
@1578 = ~W porz¹dku, <CHARNAME>, musisz przejœæ przez Pu³apki ¯yj¹cych, a ¿eby tego dokonaæ, musisz byæ martwy. Aby byæ ¿ywym i martwym jednoczeœnie, musisz staæ siê nieumar³ym. Czy wyrazi³am siê jasno? Czy rozumiesz, dok¹d to prowadzi?~ ~W porz¹dku, <CHARNAME>, musisz przejœæ przez Pu³apki ¯yj¹cych, a ¿eby tego dokonaæ, musisz byæ martwa. Aby byæ ¿yw¹ i martw¹ jednoczeœnie, musisz staæ siê nieumar³¹. Czy wyrazi³am siê jasno? Czy rozumiesz, dok¹d to prowadzi?~
@1579 = ~Na razie tak.~
@1580 = ~Raz to zrobi³am – to ju¿ wiesz – i na Mystrê, wci¹¿ tego ¿a³ujê. Przejœcie Pu³apek ¯yj¹cych, by zobaczyæ to, co by³o za nimi, sta³o siê dla mnie obsesj¹, a kiedy pewnego dnia uda³o mi siê przekraœæ do Wie¿y Durlaga i powróciæ z ksiêg¹ zaklêæ nekromanty, myœla³am, ¿e uda³o mi siê.~
@1581 = ~Kim by³ ten nekromanta?~
@1582 = ~Nie wiem – to ktoœ od dawna martwy, nie zostawi³ swego imienia na ksiêdze. Byæ mo¿e ukrad³ j¹ komuœ innemu. To nieistotne, wa¿ne ¿e mia³am j¹ w rêkach i nie mog³am uwierzyæ w³asnemu szczêœciu, gdy znalaz³am zapisane w niej zaklêcie zwane £o¿em Ghula. Sposób na bycie nieumar³ym przez pewien czas – O ILE przygotujesz je poprawnie.~
@1583 = ~A ty przygotowa³aœ je poprawnie?~
@1584 = ~Nie. Lub tak. Zale¿y jak na to spojrzeæ. Z mojego punktu widzenia nie wykona³am go dobrze. Wiele miesiêcy zajê³o mi zebranie i oczyszczenie sk³adników na miksturê niezbêdn¹ do zaklêcia, potem pospieszy³am z powrotem do Pentyrchu, zesz³am do jaskiñ, przeœlizgnê³am siê miêdzy stra¿nikami na dole i rzuci³am zaklêcie.~
@1585 = ~Nekromanta zaznaczy³, i¿ zaklêcie sprawi, ¿e bêdziesz nieumar³ym bez efektów ubocznych do dwóch godzin. Potem choroba siê rozwinie i w przeci¹gu szeœciu godzin ju¿ na sta³e zostaniesz nieumar³ym. ¯adnego powrotu, ¿adnej œmierci, nic....~
@1586 = ~Och, myœla³am, ¿e jestem taka sprytna. Przesz³am przez Pu³apki do grobowca w³adcy krasnoludów – wpad³am prosto na jego stra¿ników. Ci¹gle przeœladuje mnie pytanie, dlaczego myœla³am, ¿e w³adca krasnoludów za Pu³apkami nie bêdzie mia³ innej ochrony. Miecz trafi³ mnie w ¿ebra – cios by³ œmiertelny, tylko jak na ironiê przecie¿ by³am ju¿ martwa.~
@1587 = ~By³ to ból, jakiego nigdy wczeœniej nie doœwiadczy³am; nikt nie móg³by doœwiadczyæ tego i prze¿yæ. Nikt, rozumiesz? Zawróci³am i uciek³am – potknê³am siê – uderzy³am – upad³am – czo³ga³am siê – z powrotem za pu³apki; nieumar³a istota, umieraj¹ca. Och, w ostatniej chwili dotar³am do antidotum. W ostatniej chwili.~
@1588 = ~Zanim antidotum przywróci³o mnie do normalnoœci, le¿a³am tam przez trzy dni, uratowana tylko dziêki wodzie z rzeki, przy której le¿a³am. Musia³am znosiæ ból przez dwa dni, zanim £o¿e Ghula przesta³o dzia³aæ na tyle, bym mog³a u¿yæ mikstury leczenia. Potem, wróci³am do domu, pokonana w duchu i z lekcj¹ pokory, której nie sposób zapomnieæ. ¯adnej nekromancji – nigdy. Nigdy. Teraz dzia³am tylko dla Mystry.~
@1589 = ~Ale nadal mo¿esz nam pomóc?~
@1590 = ~Niechêtnie – ale tak. Ciê¿ko w to uwierzyæ, ale zachowa³am ksiêgê zaklêæ, miksturê £o¿a Ghula i antidotum, by przypomina³y mi, do czego zdolna jest pycha – jakbym w ogóle potrzebowa³a przypomnienia.~
@1591 = ~Wiêc mo¿emy je wzi¹æ?~
@1592 = ~To nie takie proste. Brak mi jednego sk³adnika, który znów aktywuje £o¿e Ghula: krwi wampira.~
@1593 = ~Och. Gdzie mo¿na j¹ znaleŸæ?~
@1594 = ~W wampirze, g³upcze. Plotka g³osi, ¿e sabat czarownic obj¹³ rezydencjê pod Cmentarzem. Nie, to nie plotka – wiem, ¿e tam s¹ – Czujê je. Jak s¹dzê, dziedzictwo £o¿a Ghula; albo to, albo dziedzictwo nieumar³ej rany.~
@1595 = ~Musi tu chodziæ o coœ wiêcej. Gdy zabijesz wampira, to zmieni siê w gazowy kszta³t.~
@1596 = ~Masz racjê. Wampir musi byæ dzieckiem.~
@1597 = ~Wampirze dziecko? Jest coœ takiego?~
@1598 = ~Jedno sta³o siê nim w tym tygodniu – wydarzenie tak rzadkie, ¿e przypuszczam, i¿ to esencja Dziecka Bhaala mia³a tu swój wp³yw, poniewa¿ to zbyt osobliwe, by mog³o byæ zwyk³ym przypadkiem. Teraz wiesz, dlaczego ci pomagam: chcê, abyœ pozwoli³ tej duszy z powrotem spocz¹æ. WeŸ to ostrze i u¿yj go do zabicia wampira. Jest stworzone ze wzmocnionego srebra, specjalnie utwardzone i wydr¹¿one, by zebraæ krew, zanim wampir zmieni siê w gazowy kszta³t. Srebro jest œmiertelne dla nowych wampirów; cios, który zbiera krew, równie¿ zniszczy wampira.~ ~Jedno sta³o siê nim w tym tygodniu – wydarzenie tak rzadkie, ¿e przypuszczam, i¿ to esencja Dziecka Bhaala mia³a tu swój wp³yw, poniewa¿ to zbyt osobliwe, by mog³o byæ zwyk³ym przypadkiem. Teraz wiesz, dlaczego ci pomagam: chcê, abyœ pozwoli³a tej duszy z powrotem spocz¹æ. WeŸ to ostrze i u¿yj go do zabicia wampira. Jest stworzone ze wzmocnionego srebra, specjalnie utwardzone i wydr¹¿one, by zebraæ krew, zanim wampir zmieni siê w gazowy kszta³t. Srebro jest œmiertelne dla nowych wampirów; cios, który zbiera krew, równie¿ zniszczy wampira.~
@1599 = ~Damy temu dziecku spokój – ¿adne dziecko nie zas³uguje na taki los.~
@1600 = ~Tak, poczu³am œmieræ dziecka i jestem ci wdziêczna – dobra robota. Ale nie zabi³eœ jej no¿em, który ci da³am, a bez krwi wampira, nie mogê stworzyæ mikstury £o¿a Ghula. Tu koñczy siê moja pomoc dla ciebie.~ ~Tak, poczu³am œmieræ dziecka i jestem ci wdziêczna – dobra robota. Ale nie zabi³aœ jej no¿em, który ci da³am, a bez krwi wampira, nie mogê stworzyæ mikstury £o¿a Ghula. Tu koñczy siê moja pomoc dla ciebie.~
@1601 = ~Dziêkujê – dziecko ju¿ zazna³o spokoju. Przyznajê, ¿e nie chcê tego robiæ, ale da³am s³owo. Pytam jeszcze raz – czy naprawdê rozumiesz, na co siê porywasz? Czy rozumiesz, co ci siê mo¿e staæ, jeœli coœ siê nie powiedzie? Nie mo¿esz zrzuciæ tego na barki któregoœ z twoich towarzyszy – zaklêcie bêdzie dzia³a³o tylko i wy³¹cznie na ciebie.~
@1602 = ~Rozumiem, Lady Ceinweno. Zobowi¹za³em siê, by to zrobiæ.~ ~Rozumiem, Lady Ceinweno. Zobowi¹za³em siê, by to zrobiæ.~
@1603 = ~Po prostu zrób to, pani – poradzê sobie.~
@1604 = ~Dobrze, <CHARNAME> – wróæ za dwa dni, do tego czasu wszystko przygotujê.~
@1605 = ~Nadal jesteœ zdecydowany, by to zrobiæ? Pomimo moich ostrze¿eñ?~ ~Nadal jesteœ zdecydowana, by to zrobiæ? Pomimo moich ostrze¿eñ?~
@1606 = ~Po prostu daj mi to.~
@1607 = ~Proszê wiêc – £o¿e Ghula i antidotum na nie. Zaczekaj, a¿ bêdziesz na skraju Pu³apek ¯yj¹cych; nastêpnie musisz wypiæ miksturê, by przejœæ przez pu³apki. Pamiêtaj: masz tylko dwie godziny na za¿ycie antidotum albo na zawsze pozostaniesz nieumar³ym. Kiedy weŸmiesz antidotum, jego efekty bêd¹ trwa³y do trzech dni. Nie bêdê ¿yczy³a ci szczêœcia, w¹tpiê, ¿e szczêœcie coœ tu da.~
@1608 = ~Dziekujê, Lady Ceinweno. Niech Mystra ciê prowadzi.~
@1609 = ~Proszê wiêc – £o¿e Ghula i antidotum na nie. Zaczekaj, a¿ bêdziesz na skraju Pu³apek ¯yj¹cych; nastêpnie musisz wypiæ miksturê, by przejœæ przez pu³apki. Pamiêtaj: masz tylko dwie godziny na za¿ycie antidotum albo na zawsze pozostaniesz nieumar³ym. Efekty antidotum bêd¹ trwa³y do trzech dni. Wype³ni³am swój obowi¹zek wzglêdem ciebie i nie chcê ciê ju¿ nigdy wiêcej widzieæ. Teraz odejdŸ.~
@1610 = ~Agh...! Czekaj... znam ciê. Nie s³ucha³eœ, prawda? Tak ciê ostrzega³am, ale nie s³ucha³eœ. Nie potrafiê ci pomóc, <CHARNAME>, i nikt inny te¿ nie zdo³a.~ ~Agh...! Czekaj... znam ciê. Nie s³ucha³aœ, prawda? Tak ciê ostrzega³am, ale nie s³ucha³aœ. Nie potrafiê ci pomóc, <CHARNAME>, i nikt inny te¿ nie zdo³a.~
@1611 = ~ Chyba, ¿e... chyba, ¿e... mo¿e.. ale gdzie...?~
@1612 = ~„Gdzie” co, Lady Ceinweno?~
@1613 = ~Wyduœ to z siebie, g³upia wiedŸmo!~
@1614 = ~Jeden z Wybranych mo¿e bêdzie w stanie ci pomóc, ale nie wiem, gdzie znaleŸæ któregokolwiek z nich. O ile wiem, mog¹ byæ rozproszeni po ca³ym Faerunie.~
@1615 = ~Ach! Ale myœlê, ¿e wiem gdzie znaleŸæ Elminstera. Dziêkujê, Lady Ceinweno.~
@1616 = ~Masz czelnoœæ przychodziæ tu obra¿aæ mnie i domagaæ siê ode mnie pomocy po tym, jak ca³kowicie zignorowa³eœ wszystkie moje instrukcje? Twoja arogancja jest niewiarygodna!~ ~Masz czelnoœæ przychodziæ tu obra¿aæ mnie i domagaæ siê ode mnie pomocy po tym, jak ca³kowicie zignorowa³aœ wszystkie moje instrukcje? Twoja arogancja jest niewiarygodna!~
@1617 = ~Powiedz mi, gdzie mogê znaleŸæ pomoc, wiedŸmo, zanim oderwê ci g³owê od szyi!~
@1618 = ~G³upiec. Idiota. Nie bojê siê œmierci – i tak ju¿ ¿yjê na kredyt. Jeden z Wybrañców Mystry mo¿e mieæ odpowiedŸ na twoj¹ g³upotê, ale ja nie mam, a na dodatek, nie wiem, gdzie oni s¹! A teraz zje¿d¿aj st¹d; smród, który ze sob¹ przynosisz, jest gorszy ni¿ zapach grobu.~
@1619 = ~Ha! Wybraniec Mystry, co? Tak siê sk³ada, ¿e wiem, gdzie jest ten wœcibski g³upiec Elminster. Bez w¹tpienia znowu schlany jak bela. Mo¿esz zatrzymaæ swoj¹ g³owê, Ceinweno Kruczow³osa – przynajmniej na razie.~

