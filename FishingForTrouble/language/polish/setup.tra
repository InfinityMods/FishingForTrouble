// Zarz¹dca karawan
@2100 = ~Tak?~ 
@2101 = ~Czy ty jesteœ zarz¹dc¹ karawan?~
@2102 = ~Kim jesteœ?~ 
@2103 = ~Jestem zarz¹dc¹ karawan Warowni Cerendora. Czego chcesz?~
@2104 = ~Ach! Szuka³em ciê. Czy to ty odpowiadasz za karawany, które przybywaj¹ do warowni?~ ~Ach! Szuka³am ciê. Czy to ty odpowiadasz za karawany, które przybywaj¹ do warowni?~ 
@2105 = ~Gdzie znajduje siê karawana, z któr¹ przybyli Czerwoni Magowie?~
@2106 = ~A czemu chcesz to wiedzieæ?~
@2107 = ~W jej ³adunku jest coœ, co mnie interesuje.~ 
@2108 = ~Karawana przewozi znaczny ³adunek czarnego lotosu, a ja zamierzam zatrzymaæ ten przemyt.~
@2109 = ~Tak, to ja. W czym mogê ci pomóc?~ 
@2110 = ~Próbujê zlokalizowaæ karawanê, która niedawno przyby³a z Calimshanu. Podró¿owa³o z ni¹ szeœciu Czerwonych Magów.~
@2111 = ~Szukam karawany, której pilnowa³o szeœciu Czerwonych Magów, a która najprawdopodobniej przewozi znaczny ³adunek czarnego lotosu.~
@2112 = ~Ostatnio faktycznie przyby³a tu taka karawana. Co chcesz o niej wiedzieæ?~ 
@2113 = ~Mam powa¿ne podejrzenia, ¿e przewozi ona znaczny ³adunek czarnego lotosu.~
@2114 = ~Po prostu powiedz mi, czy tutaj jest.~ 
@2115 = ~Nie mogê udzieliæ takiej informacji bez powodu. Naprawdê dobrego powodu.~
@2116 = ~Milcz, jeœli nie chcesz straciæ ¿ycia! Sk¹d mam wiedzieæ, ¿e nie jesteœcie szpiegami Czerwonych Magów?~
@2117 = ~Aha, wiêc by³a tutaj!~
@2118 = ~Nie mówiê tak, nie mówiê nie. Nie ufam ci.~ 
@2119 = ~Elminster poleci³ nam zbadaæ sprawê Pentyrchu. Rozmawialiœmy tam z tanar'ri, który powiedzia³ nam o tej karawanie.~
@2120 = ~Czy imiê Elminster coœ ci mówi, zarz¹dco? Jest moim przyjacielem i nie by³by zadowolony, gdyby dowiedzia³ siê, ¿e utrudniasz mi zadanie przez niego zlecone.~ 
@2121 = ~Elminster? Pentyrch? Tanar'ri? Znam Elminstera dobrze, tak samo jak wiem o nieumar³ych wa³êsaj¹cych siê po Pentyrchu, ale nie wiem nic o tanar'ri. Niech bêdzie – chodŸmy do mojego pokoju na pierwszym piêtrze. Tam mo¿emy spokojnie porozmawiaæ.~ 
@2122 = ~Spotkamy siê tam.~
@2123 = ~Wci¹¿ ci nie ufam, ale znam Elminstera i wiem, ¿e mo¿na na nim polegaæ, rozumiesz? Tylko i wy³¹cznie ze wzglêdu na niego zgodzê siê z tob¹ porozmawiaæ. Bêdê czeka³ w pokoju na pierwszym piêtrze.~ 
@2124 = ~Nie ufam tobie, ani twoim intencjom. Przecie¿ towarzyszy ci Czerwony Mag.~
@2125 = ~Edwin Odesseiron podró¿uje ze mn¹ od d³u¿szego czasu i nawet Elminster zgodzi³ siê mu zaufaæ.~
@2126 = ~Eddy jest w porz¹dku. Trochê niecierpliwy i czasem mamrocze sam do siebie, ale poza tym nie sprawia k³opotów.~
@2127 = ~Odesseiron? S³ysza³em wczeœniej to nazwisko i w niezbyt przyjemnych okolicznoœciach!~
@2128 = ~Czy¿by?~
@2129 = ~S³ysza³eœ? Kiedy i gdzie?~
@2130 = ~Skoro tak mówisz. Wci¹¿ nie ufam Czerwonym Magom i mam ku temu powody.~
@2131 = ~Co to za powody?~
@2132 = ~Gadaj teraz albo po¿a³ujesz.~
@2133 = ~GroŸby nic tu nie dadz¹. Bywali tu gorsi od ciebie i ju¿ nie opuszczali tego miejsca.~
@2134 = ~W imiê Mystry i Elminstera, powiedz¿e wreszcie!~
@2135 = ~Niewa¿ne! Ten tutaj jeszcze ciê nie odwróci³ przeciw tobie – poczekaj trochê, a sam siê przekonasz.~ ~Niewa¿ne! Ten tutaj jeszcze ciê nie odwróci³ przeciw tobie – poczekaj trochê, a sama siê przekonasz.~
@2136 = ~Wci¹¿ nie mam powodów, ¿eby ci ufaæ – nie powiem nic wiêcej.~
@2137 = ~Na Elminstera, zarz¹dco – jesteœmy tu, ¿eby ci pomóc!~
@2138 = ~Elminstera? Co ma do tego Elminster?~
@2139 = ~A wiêc imiê Elminster coœ ci mówi, zarz¹dco? On jest moim przyjacielem i nie by³by zadowolony, gdyby dowiedzia³ siê, ¿e utrudniasz mi zadanie przez niego zlecone.~
@2140 = ~Wci¹¿ ci nie ufam, ale znam Elminstera i wiem, ¿e mo¿na na nim polegaæ, rozumiesz? Tylko i wy³¹cznie ze wzglêdu na niego zgodzê siê z tob¹ porozmawiaæ. Bêdê czeka³ w pokoju na pierwszym piêtrze. Jeœli jednak wcale dla niego NIE pracujesz, niech bogowie maj¹ ciê w swojej opiece, gdy on siê o tym dowie.~
@2141 = ~Ach, jesteœ wreszcie. Tu mo¿emy porozmawiaæ bez wiêkszych obaw, ¿e ktoœ nas pods³ucha.~
@2142 = ~Co jest problemem?~
@2143 = ~Czego siê boisz? Cieni?~
@2144 = ~Czerwonych Magów, jeœli mam byæ szczery. I ich tak zwanych stra¿ników.~
@2145 = ~Dlaczego? Co takiego oni zrobili?~
@2146 = ~Przejêli Warowniê Cerendora. Wozy pe³ne czarnego lotosu przyby³y wczoraj i nie to nie pierwsza taka karawana.~
@2147 = ~Nie pierwszy raz?~
@2148 = ~Ha! Ktoœ znalaz³ Ÿród³o niez³ego dochodu.~
@2149 = ~Kosztem ludzkiej krzywdy... rzeczywiœcie niez³y dochód. Czy ty te¿ czerpiesz zysk z nieszczêœcia innych?~
@2150 = ~Phi! S¹ zyski i „zyski”, i w niektórych nie chcê mieæ ani trochê swojego udzia³u!~
@2151 = ~To ju¿ trzecia karawana w ci¹gu ostatnich tygodni, wszystkie dobrze strze¿one, ale ta ostatnia mia³a ju¿ niemal ma³¹ armiê. Wiêkszoœæ ¿o³nierzy zosta³a tutaj razem z czterema Czerwonymi Magami.~
@2152 = ~Szybko wysz³o na jaw, ¿e – wbrew ich s³owom – nie zamierzaj¹ jedynie zaczekaæ tu na powrotn¹ karawanê, ale ¿e planuj¹ z Warowni Cerendora zrobiæ swoj¹ w³asn¹ warowniê.~
@2153 = ~W ¿aden sposób nie zak³ócaj¹ pracy w warowni, ani nawet nie zmuszali ludzi do pozostania tutaj, ale warownia teraz nale¿y do nich i ja nie mam nic do gadania.~
@2154 = ~Czy próbowa³eœ coœ z tym zrobiæ?~
@2155 = ~Dlaczego z nimi nie walczyliœcie?~
@2156 = ~Nie mamy tu zbyt wiele wojsk; moglibyœmy stawiæ czo³a zbrojnym, ale bez obstawy Czerwonych Magów.~
@2157 = ~Jeœli chcesz, mo¿emy ci pomóc.~
@2158 = ~Ja te¿ nie zamierzam walczyæ z Czerwonymi Magami. Musisz radziæ sobie sam.~
@2159 = ~Umowa stoi! Zanim wydam rozkaz ataku, musisz otrzymaæ zgodê od hrabiego Wultheofa. PrzyjdŸ do mnie, gdy to za³atwisz; w miêdzyczasie po kryjomu poinformujê naszych ¿o³nierzy, by byli w pogotowiu. Och, i weŸ to ze sob¹. To klucz do lochów warowni. Mój sier¿ant i kilku ¿o³nierzy jest tam przetrzymywanych pod piecz¹ Czerwonych Stra¿ników. Pewnie bêdzie ich ca³kiem sporo.~
@2160 = ~Zmieni³eœ zdanie?~ ~Zmieni³aœ zdanie?~
@2161 = ~Tak, uwolniê twoich zbrojnych.~
@2162 = ~Nie.~
@2163 = ~Jesteœ gotowy? Czy masz zgodê hrabiego Wultheofa?~ ~Jesteœ gotowa? Czy masz zgodê hrabiego Wultheofa?~
@2164 = ~Tak, mo¿esz daæ rozkaz.~
@2165 = ~Nie, jeszcze nie.~
@2166 = ~Dobrze. Wróæ do mnie po wszystkim – i uwa¿aj na siebie.~
@2167 = ~Zobacz, co znaleŸliœmy w ustêpie! Jeden z moich ludzi zobaczy³ go, jak próbowa³ przeczo³gaæ siê kana³ami – niestety musisz jakoœ wytrzymaæ ten smród. Z pewnoœci¹ zechcesz zamieniæ s³owo z tym m³odym cz³owiekiem.~
@2168 = ~Nawet wiêcej ni¿ s³owo.~
@2169 = ~Skoro tak twierdzisz. A zatem: przekonajmy siê, co ten mag mo¿e nam powiedzieæ.~
@2170 = ~I to ca³a historia? Od teraz bêdziemy mieæ na oku wszystkie karawany z Calimshanu maj¹ce przesadn¹ obstawê! Pos³uchaj: ta karawana przewozi³a ³adunek dla Athkatli i musi przebyæ star¹, górsk¹ drogê. Jeœli ruszysz skrótem na pó³noc od rzeki, a potem na zachód, zdo³asz dogoniæ karawanê gdzieœ w Chmurnych Szczytach. Powodzenia – na pewno ci siê przyda!~
@2171 = ~I to ca³a historia? Od teraz bêdziemy mieæ na oku wszystkie karawany z Calimshanu maj¹ce przesadn¹ obstawê! Pos³uchaj: ta karawana przewozi³a ³adunek dla Athkatli i musi przebyæ star¹, górsk¹ drogê. Jeœli ruszysz skrótem na pó³noc od rzeki, a potem na zachód, zdo³asz dogoniæ karawanê gdzieœ w Chmurnych Szczytach. Powodzenia – na pewno ci siê przyda! A zanim wyruszysz, chyba hrabia Wultheof chcia³by zamieniæ z tob¹ s³owo.~
@2172 = ~Magowie z Thay dobrze siê zastanowi¹, zanim spróbuj¹ ponownie przerzuciæ swój towar przez Warowniê Cerendora. <CHARNAME>, pamiêtaj, ¿e zawsze bêdziesz tu mile widzianym goœciem.~
@2173 = ~Musisz siê pospieszyæ, jeœli chcesz dogoniæ karawanê.~
@2174 = ~Rozmawia³am z kapitanem warowni. Mówi³, ¿e to dziêki tobie uda³o siê utrzymaæ Cerendor we wzglêdnym porz¹dku po jej przejêciu.~
@2175 = ~To zas³uga wszystkich tutaj, pani Nalio. Kapitan nic nam o tym nie mówi³.~
@2176 = ~Niemniej jednak moja matka sowicie ciê wynagrodzi za twoj¹ lojalnoœæ.~
@2177 = ~Jeœli takie jest jej ¿yczenie. Ale te pieni¹dze bardziej przydadz¹ siê ludziom, którzy stracili dziœ swoich bliskich.~
@2178 = ~Zapewne nasz racjê. Przeka¿ê jej to.~
@2179 = ~Wci¹¿ musimy dogoniæ karawanê i zniszczyæ jej œmiercionoœny ³adunek. Czas, ¿ebyœmy ruszali w drogê.~
@2180 = ~Dziêkujê ci za ocalenie maj¹tku rodu D'Arnise.~
@2181 = ~To zas³uga wszystkich tutaj, pani Nalio, nie tylko moja.~
@2182 = ~O, Boo mówi, ¿e ten czarodziej wcale nie pachnie magi¹! Boo uwa¿a, ¿e przyda³aby mu siê porz¹dna k¹piel w studni.~
@2183 = ~Uch!!! Co.. Co TO jest???~
@2184 = ~Boo jest miniaturowym Gigantycznym Kosmicznym Chomikiem i jest przyjacielem Minsca po wieki wieków. Tylko Minsc potrafi z nim rozmawiaæ, prawda, Boo?~
@2185 = ~Zaufaj mi, NAPRAWDÊ nie chcesz wiedzieæ, o co mu chodzi.~
@2186 = ~To brzmi jak œwietna zabawa dla Boo!~
@2187 = ~Zamknij siê, Edwin.~
@2188 = ~(Eddy? EDDY?! Ostatnia osoba, która mnie tak nazwa³a, ma teraz d³ug¹ kitê i ca³ymi dniami bawi siê orzeszkami!)~
@2189 = ~(Ach! Nie jest tak g³upi jak na to wygl¹da. Moim rodakom nigdy nie nale¿y ufaæ).~
@2190 = ~Edwin, ZAMKNIJ SIÊ!~

//*************************************************************************
// Hrabia Wultheof
@2200 = ~Kim jesteœ?~ 
@2201 = ~Jestem <CHARNAME>, hrabio Wultheof. Rozmawia³em ostatnio z zarz¹dc¹ karawan o ma³ym problemie Warowni Cerendora.~ ~Jestem <CHARNAME>, hrabio Wultheof. Rozmawia³am ostatnio z zarz¹dc¹ karawan o ma³ym problemie Warowni Cerendora.~
@2202 = ~Jestem <CHARNAME>, hrabio Wultheof.~ 
@2203 = ~Czy tak? A o jakim dok³adnie problemie rozmawialiœcie?~
@2204 = ~O tym, który ciê trapi – nag³ym wzroœcie populacji gryzoni i problemach, które wywo³a³y w warowni.~ 
@2205 = ~O czarnym lotosie, który jest przemycany przez to miejsce.~
@2206 = ~Ach, o tym. Co on ci powiedzia³ na ten temat?~
@2207 = ~Mówi³, ¿e potrzebuje twojej zgody na wypêdzenie szczurów z tej nory, w której siê tu zalêg³y.~ 
@2208 = ~I zamierzasz mu w tym pomóc, tak? A jak¹ masz pewnoœæ, ¿e te szczury naprawdê siê wynios¹?~
@2209 = ~Jeœli same siê nie wynios¹, to potraktujemy je tak samo jak wszystkie inne szczury w warowni.~ 
@2210 = ~Szczerze mówi¹c szczerze, to wcale nie oczekujê, ¿e w tym poœpiechu znajd¹ wyjœcie.~
@2211 = ~Czarny lotos? Wydaje mi siê, ¿e handluj¹ calishyckim jedwabiem, a nie czarnym lotosem.~
@2212 = ~Calishyckiego jedwabiu nie przewozi siê w ma³ych, zawiniêtych paczkach. Ani te¿ nie daje siê do takiego transportu obstawy piêædziesiêciu stra¿ników i szeœciu Czerwonych Magów.~ 
@2213 = ~Do czego zmierzasz?~
@2214 = ~Elminster zleci³ mi pewn¹ misjê i tak dotar³em tutaj.~ ~Elminster zleci³ mi pewn¹ misjê i tak dotar³am tutaj.~ 
@2215 = ~Elminster, co? Mów dalej.~
@2216 = ~*Opowiedz mu wszystko, co wiesz*.~
@2217 = ~Wiêc uwa¿asz, ¿e mo¿esz to powstrzymaæ?~
@2218 = ~Nie podoba mi siê ten handel, nie podobaj¹ mi siê jego skutki, ani fakt, ¿e stoi za tym Homen Odesseiron. W zasadzie to samego Homena Odesseirona te¿ raczej nie lubiê, ale jest on poza moim zasiêgiem.~ 
@2219 = ~Jeœli jesteœ pewien... Ale nie by³byœ tutaj, gdybyœ nie by³ tego pewien. Dlaczego chcesz to zrobiæ?~ ~Jeœli jesteœ pewna... Ale nie by³abyœ tutaj, gdybyœ nie by³a tego pewna. Dlaczego chcesz to zrobiæ?~
@2220 = ~Chcê po prostu wykonaæ swoj¹ misjê.~ 
@2221 = ~Dla pieniêdzy.~ 
@2222 = ~To misja, któr¹ zleci³ mi Elminster.~
@2223 = ~A co to za misja?~ 
@2224 = ~No, przynajmniej wiemy, na czym stoimy. IdŸ, zrób to, o czym mówisz, a dostaniesz swoj¹ nagrodê.~
@2225 = ~Chyba zgodzê siê z moim zarz¹dc¹ karawan: z twoj¹ pomoc¹ zdo³amy wykurzyæ te SZCZURY z warowni na dobre. Tak, powiedz mu, ¿e ma moj¹ zgodê, a ja wam w tym pomogê.~
@2226 = ~Zrobi³eœ, jak obieca³eœ. W warowni nie osta³y siê ¿adne szczury. Oto twoja nagroda.~ ~Zrobi³aœ, jak obieca³aœ. W warowni nie osta³y siê ¿adne szczury. Oto twoja nagroda.~
@2227 = ~Có¿, <CHARNAME>, jestem teraz bardzo zajêty. Mo¿e porozmawiamy innym razem.~

//*************************************************************************
// Stra¿nik wrót
@2230 = ~S³ysza³em, ¿e chcesz pod¹¿yæ za t¹ calishyck¹ karawan¹. Czy to prawda?~
@2231 = ~Tak.~
@2232 = ~Czemu pytasz? Mów prêdko, nie mam czasu ani cierpliwoœci.~
@2233 = ~Jeœli pohamujesz na chwilê swój poœpiech, mam dla ciebie bardzo wa¿n¹ informacjê. Je¿eli, oczywiœcie, zechcesz mnie wys³uchaæ?~
@2234 = ~Ech... O co chodzi?~
@2235 = ~Pos³uchaj – kiedy opuœcisz warowniê, przejdŸ przez rzekê i, kiedy dojdziesz do urwiska, skrêæ na zachód, trzymaj¹c siê jego œciany. Trafisz na niepozorn¹ œcie¿kê, wydaj¹c¹ siê prowadziæ donik¹d. Poprowadzi ciê przez Chmurne Szczyty a¿ do starego szlaku handlowego Crimmor-Nashkel. Tamtêdy bêdzie pod¹¿aæ karawana.~
@2236 = ~Jesteœ pewien?~
@2237 = ~Ca³kowicie. S³ysza³em, jak krasnolud Skalna Piêœæ omawia trasê z tym potulnym czarodziejem.~
@2238 = ~Potulny czarodziej? Wiêc podró¿uje z nimi Czerwony Mag? Ha! Dziêkujê ci za informacjê, przyjacielu!~

//*************************************************************************
// Wiêcej populacji – mê¿czyŸni
@2250 = ~Hej, nie jesteœcie przypadkiem tymi ludŸmi, którzy dopiero co usunêli tych nieumar³ych? Wydaje mi siê, ¿e ktoœ z was to <CHARNAME>? Có¿, muszê wam podziêkowaæ. To co zrobiliœcie, uratowa³o nasz¹ spo³ecznoœæ.~
@2251 = ~Wiecie co us³ysza³em? S³ysza³em, ¿e jakieœ dzielne dusze przyby³y do naszej wioski i da³y tym nieumar³ym naprawdê niez³e lanie! Mam nadziejê, ¿e to prawda!~
@2252 = ~W istocie to prawda, bo to ja, <CHARNAME>, tego dokona³em!~ ~W istocie to prawda, bo to ja, <CHARNAME>, tego dokona³am!~
@2253 = ~Jeœli to prawda, to w sumie wszystkie wasze problemy siê rozwi¹za³y, czy¿ nie?~
@2254 = ~Ty i ka¿dy inny. Ju¿ spotka³em trzech takich, co to przyw³aszczyli sobie te dokonania, wiêc lepiej stañ w kolejce. ¯e niby bohaterowie bêd¹ takimi bufonami. Eee, tam.~
@2255 = ~Do tego to jeszcze daleko. To, ¿e jesteœmy bezpieczni, nie ma znaczenia, skoro bandyci kontroluj¹ drogi na pó³nocy i po³udniu. Do tego wszyscy ci¹gle myœl¹, ¿e to Calimshan stoi za tym wszystkim. Jeœli to prawda, wojna z Calimshanem wisi na w³osku, a Tethyr te¿ jest w to zamieszany. Nie mamy wiêcej k³opotów? Akurat.~
@2256 = ~To dobry dzieñ na zmianê. Demon zosta³ pokonany i dla wielu ludzi oznacza to powrót do ³owienia ryb.~
@2257 = ~To dobre wieœci dla wszystkich zmartwionych. Wiadomo, kto jest za to odpowiedzialny?~
@2258 = ~A wiêc wszystko wróci do normalnoœci?~
@2259 = ~Masz na myœli bohaterów? Pewnie! S³ysza³em wymieniane imiê <CHARNAME>. Ale nie wiem, czy to prawda, czy te¿ nie. Historia rozrasta siê w miarê opowiadania. Jak dot¹d us³ysza³em, ci bohaterowie byli wysocy na dziesiêæ stóp, u¿ywali pni drzew jako kijów i rozrywali nieumar³ych ich go³ymi rêkoma.~
@2260 = ~Có¿, mo¿e i jest lepiej, ale daleko nam do normalnoœci. Znów mo¿emy ³owiæ, ale minie sporo czasu zanim nasze po³owy znów obejm¹ ca³y region. Plotka g³osi, ¿e bandyci nadal trzymaj¹ drogi na pó³noc, wiêc kupcy nigdzie siê nie wybieraj¹, niewa¿ne czy maj¹ towar na sprzeda¿, czy nie.~
@2261 = ~Ty... z jakiegoœ powodu wygl¹dasz znajomo. Trochê jak ta grupa co kiedyœ odbi³a kopalnie w Nashkel. A przynajmniej kogoœ podobnego opisywa³ mój brat, Emerson. Do licha, nawet jeœli to nie ty, to muszê komuœ podziêkowaæ za uporanie siê z tym starym ¿elaznym kryzysem. Dobra robota tam na dole!~
@2262 = ~Twoje podziêkowania s¹ mile widziane, chocia¿ mo¿e nagroda wyrazi³aby to lepiej.~
@2263 = ~To by³a przyjemnoœæ ci pomóc, prosty cz³owieku. Nie móg³bym trzymaæ siê z dala, gdy dzia³y siê takie nikczemne rzeczy!~ ~To by³a przyjemnoœæ ci pomóc, prosty cz³owieku. Nie mog³abym trzymaæ siê z dala, gdy dzia³y siê takie nikczemne rzeczy!~
@2264 = ~Zrobi³em jedynie to, co nale¿a³o. Ka¿dy by tak post¹pi³.~ ~Zrobi³am jedynie to, co nale¿a³o. Ka¿dy by tak post¹pi³.~
@2265 = ~Ale masz tupet! Mo¿e i pomog³eœ Wybrze¿u Mieczy, ale nie wszystko jest teraz wspania³e. Jutro wracam do pracy, ale to nie ma znaczenia. Dopóki wszyscy myœl¹, ¿e Calimshan stoi za ostatnimi naszymi problemami, Pentyrch mo¿e znaleŸæ siê na linii frontu podczas wojny. Jak mo¿na spokojnie spaæ w nocy, kiedy dzieje siê coœ takiego!~ ~Ale masz tupet! Mo¿e i pomog³aœ Wybrze¿u Mieczy, ale nie wszystko jest teraz wspania³e. Jutro wracam do pracy, ale to nie ma znaczenia. Dopóki wszyscy myœl¹, ¿e Calimshan stoi za ostatnimi naszymi problemami, Pentyrch mo¿e znaleŸæ siê na linii frontu podczas wojny. Jak mo¿na spokojnie spaæ w nocy, kiedy dzieje siê coœ takiego!~ 
@2266 = ~Nic dziwnego, ¿e zszed³eœ do tych kopalñ. Jesteœ zupe³nym szaleñcem. Có¿, skoro robota zosta³a wykonana, to chyba nie ma znaczenia jak bardzo masz nierówno pod sufitem. Hej, a mo¿e tak skieruj ten swój prawy gniew na bandytów ze po³udnia? Móg³byœ coœ zrobiæ z handlarzami czarnym lotosem, którzy ponoæ stamt¹d przybywaj¹.~ ~Nic dziwnego, ¿e zesz³aœ do tych kopalñ. Jesteœ zupe³nym szaleñcem. Có¿, skoro robota zosta³a wykonana, to chyba nie ma znaczenia jak bardzo masz nierówno pod sufitem. Hej, a mo¿e tak skieruj ten swój prawy gniew na bandytów ze po³udnia? Mog³abyœ coœ zrobiæ z handlarzami czarnym lotosem, którzy ponoæ stamt¹d przybywaj¹.~
@2267 = ~Ba, oczywiœcie, ¿e móg³by to byæ ka¿dy. Ludzie siê bali, wiêkszoœæ nadal siê boi. Nie zrozum mnie Ÿle, wszyscy s¹ ci wdziêczni. Po prostu chodzi o to, ¿e sprawy nie bardzo siê zmieni¹. Ci¹gle chodz¹ plotki o calishyckich knowaniach i agentach z Thay, a my nie bêdziemy w stanie nale¿ycie ³owiæ. A przynajmniej do czasu, a¿ szlaki handlowe zostan¹ oczyszczone z bandytów.~
@2268 = ~Wkrótce wiêkszoœæ z nas wróci do pracy. To dobre wieœci, ale nadal pozostaje zagadk¹, kto zorganizowa³ ca³y spisek. Rada Szeœciu nie ulegnie presji Tethyru, by przepuœciæ ich armie do Calimshanu, dopóki siê to nie wyjaœni.~

//*************************************************************************
// Wiêcej populacji – kobiety
@2270 = ~Hej, czy nie nazywasz siê przypadkiem <CHARNAME>? To ty zabi³eœ demona! Musisz byæ naprawdê dzielny. Rety, prawdziwi bohaterowie, tutaj, w Pentyrchu.~ ~Hej, czy nie nazywasz siê przypadkiem <CHARNAME>? To ty zabi³aœ demona! Musisz byæ naprawdê dzielna. Rety, prawdziwi bohaterowie, tutaj, w Pentyrchu.~
@2271 = ~To wspania³e, ¿e mê¿czyŸni znowu id¹ ³owiæ ryby. Cieszê siê, ¿e mê¿uœ mo¿e wyjœæ z domu, naprawdê. Ju¿ wariowa³ od braku roboty. Przypuszczam, ¿e teraz to mo¿emy siê martwiæ tylko... có¿... bandytami napadaj¹cymi na nasze kupieckie karawany.~
@2272 = ~Ale mo¿liwoœæ wznowienia po³owów z pewnoœci¹ roz³aduje pewne napiêcia w okolicy, czy¿ nie?~
@2273 = ~Jakie problemy mog¹ spowodowaæ jacyœ marni bandyci? Dziêki wznowieniu po³owów wioska znów bêdzie têtniæ ¿yciem!~
@2274 = ~Och, na pewno! Tylko odk¹d bandyci atakuj¹ wszystkie karawany kupieckie, nikt nie œmie przewoziæ towarów bez uzbrojonej amnijskiej eskorty. A najwyraŸniej s¹ wyj¹tkowo zajadli, jeœli zdaje im siê, ¿e handlujesz pewnymi... specjalnymi dobrami. Mo¿emy ³owiæ ryby, ale nikt nie œmie wyjœæ na drogi.~
@2275 = ~Có¿, zapewne wszyscy rozluŸniliby siê bardziej, gdyby wiedzieli, kto sta³ za ca³¹ spraw¹. Po tych gadkach o agentach z Thay, zhentarimskich szpiegach czy calishyckiej polityce nikt ju¿ nie wie, komu mo¿na ufaæ.~
@2276 = ~Przykro mi, ale nie mam czasu na rozmowê. Znów mo¿emy ³owiæ, ale moje ¿ycie nie jest ³atwiejsze. Bandyci napadaj¹ ka¿d¹ karawanê, któr¹ wysy³amy do miasta, wiêc nie ma znaczenia, czy mamy ryby. Nikt ich nie otrzyma.~
@2277 = ~Wiêc jesteœcie tymi wielkimi, potê¿nymi bohaterami, którzy uratowali Pentyrch, co? Wybaczcie mi, jeœli nie zacznê skakaæ z radoœci, ale jedyn¹ rzecz¹, któr¹ przyniós³ mi wasz wysi³ek, by³a szansa na uratowanie cia³a mego mê¿a. Chyba powinnam byæ za to wdziêczna, ale nie mam teraz raczej nastroju na œwiêtowanie.~
@2278 = ~Czy nie nazywasz siê przypadkiem <CHARNAME>? Wygl¹dasz podobnie do osoby, która prawdopodobnie uratowa³a nasz¹ wioskê.~
@2279 = ~Tak, to ja, ale naprawdê nie chcê robiæ z tego powodu wielkiego szumu.~
@2280 = ~Owszem, jestem bohaterem, który ocali³ wasze domostwa.~ ~Owszem, jestem bohaterk¹, która ocali³a wasze domostwa.~
@2281 = ~Mia³am zamiar ci podziêkowaæ, ale wygl¹da na to, ¿e ju¿ dostatecznie sam sobie pogratulowa³eœ. Co nie zmienia faktu, ¿e wspaniale przys³u¿y³eœ siê naszej wiosce. Kiedy za³atwimy problemy na drogach, ca³a okolica równie¿ na tym skorzysta.~ ~Mia³am zamiar ci podziêkowaæ, ale wygl¹da na to, ¿e ju¿ dostatecznie sama sobie pogratulowa³aœ. Co nie zmienia faktu, ¿e wspaniale przys³u¿y³aœ siê naszej wiosce. Kiedy za³atwimy problemy na drogach, ca³a okolica równie¿ na tym skorzysta.~
@2282 = ~Przesadzasz z t¹ skromnoœci¹. Dziêki twoim czynom, ta wioska jest bêdzie mog³a znów normalnie funkcjonowaæ. Nie ¿eby wszyscy mogli od razu odetchn¹æ. Miejmy nadziejê, ¿e ktokolwiek za tym sta³, wkrótce zostanie odkryty, zanim Amn i Calimshan rozpoczn¹ wojnê z tego powodu.~
@2283 = ~Jesteœcie tymi poszukiwaczami przygód, którzy uratowali wioskê, prawda? Powinnam byæ wdziêczna i w ogóle, ale uwa¿am, ¿e jest jeszcze tyle do zrobienia. £odzie znów ³owi¹ ryby, ale bandyci rz¹dz¹ drogami na po³udniu, a stosunki pomiêdzy Amn i Calimshanem nadal s¹ bardzo napiête. Jest jeszcze sporo do zrobienia.~

//*************************************************************************
// Gibri'al Stopionorêki
@2300 = ~Nic wiêcej nie mog³em uczyniæ, <CHARNAME>. Nic wiêcej.~
@2301 = ~Gdzie ona jest? Gdzie ta pó³elfka?~
@2302 = ~Eildarena Colver? Zosta³a zabrana przez Garaliala Geltaratha do miejsca, gdzie mog³aby siê skuteczniej uleczyæ. Nie powiedzia³ dok¹d, ale ma on reputacjê jako uzdrowiciel, wiêc nie mam wyrzutów z powodu jego dzia³añ.~
@2303 = ~Dlaczego go nie powstrzyma³eœ?~
@2304 = ~Dlaczego mia³bym to robiæ?~
@2305 = ~Shar, strze¿ mnie od g³upich kap³anów i zdradzieckich Harfiarzy!~
@2306 = ~Witaj w tych skromnych progach. Jak mogê ci pomóc?~
@2307 = ~Kim jesteœ?~
@2308 = ~Jestem Gibri'al Stopionorêki z Esmeltaram, kap³an Eldath. A ty...?~
@2309 = ~Jestem znany jako <CHARNAME>.~ ~Jestem znana jako <CHARNAME>.~
@2310 = ~Jam jest Dzieciê Bhaala, postrach Wybrze¿a Mieczy i zabójca kap³anów.~ ~Jam jest Dzieciê Bhaala, postrach Wybrze¿a Mieczy i zabójczyni kap³anów.~
@2311 = ~W rzeczy samej. Wielu jest takich jak ty – czy posiadasz imiê, które wyró¿nia ciê od pozosta³ych?~
@2312 = ~A zatem, <CHARNAME>, jak mogê ci pomóc? Potrzebujesz uzdrowienia?~
@2313 = ~Czy znajduje siê tutaj elfka lub pó³elfka, Harfiarz o imieniu Eildarena Colver?~
@2314 = ~Co to za miejsce?~
@2315 = ~Tak.~
@2316 = ~Nie.~
@2317 = ~To enklawa Eldath, bogini rzek i strumieni.~
@2318 = ~Myœla³em, ¿e czciciele Eldath stroni¹ od miast? Co tutaj robisz?~ ~Myœla³am, ¿e czciciele Eldath stroni¹ od miast? Co tutaj robisz?~
@2319 = ~Historia o tym, jak znalaz³em siê tu, w Athkatli, jest d³uga i nie bêdê ciê ni¹ zanudza³. Wystarczy powiedzieæ, ¿e gdy tu jestem, odnajdujê spokój w leczeniu chorych. Utrzymujê tê ma³¹ enklawê, gdzie przybywaj¹ podró¿ni, gdy s¹ zbyt daleko od domu, by tam mogli zostaæ uzdrowieni. Potrzebujesz leczenia, <CHARNAME>?~
@2320 = ~W istocie, jest tutaj. Przyniesiono j¹ tu wczoraj z Piwnego Dworu.~
@2321 = ~Muszê z ni¹ pomówiæ.~
@2322 = ~To niemo¿liwe. Ona jest nieprzytomna, ma gor¹czkê i obawiam siê, ¿e umrze.~
@2323 = ~Co?! Gdzie ona jest?~
@2324 = ~ChodŸ ze mn¹.~
@2325 = ~Jak widzisz, le¿y tutaj z wysok¹ gor¹czk¹.~
@2326 = ~Czy nic nie mo¿esz zrobiæ?~
@2327 = ~Nie. Potrzeba kogoœ potê¿niejszego ni¿ ja. Kogoœ, kto rzeczywiœcie wie, w czym mo¿e tkwiæ problem – na przyk³ad innego Harfiarza.~
@2328 = ~Ach. Chyba wiem, gdzie mo¿na znaleŸæ pomoc.~
@2329 = ~Wczoraj, póŸnym popo³udniem. By³a ju¿ nieprzytomna. Widzisz kolor jej twarzy i skóry? ¯ó³ta jak p³atki Jasnej gwiazdy. Z pocz¹tku myœla³em, ¿e zosta³a otruta, ale teraz nie mam pewnoœci; przez te wszystkie lata jako kap³an Eldath nigdy nie widzia³em, by czyjaœ skóra przybra³a taki kolor. W¹tpiê, czy zdo³a przetrwaæ choæby trzy noce.~
@2330 = ~Muszê zatem zostawiæ to w twojej gestii; bêdê dba³ o ni¹ najlepiej jak potrafiê, dopóki nie wrócisz.~
@2331 = ~Niech spojrzê... hmm... Kiedy zosta³a przyniesiona, zacny Gibri'alu? W jakim by³a stanie? Mówi³a coœ?~
@2332 = ~Widzia³am to ju¿ kiedyœ i niestety tamta ofiara nie wróci³a do zdrowia. Ta choroba – o ile to w ogóle choroba – przerasta moje zdolnoœci, Gibri'alu. Musimy szukaæ pomocy gdzie indziej, <CHARNAME>.~

//*************************************************************************
//Angharada Ognistow³osa
@2350 = ~Ghu...! Nie, zaraz. To nie ghul – wyczuwam z³y urok. Wyczuwam... ach!~ 
@2351 = ~Co?~
@2352 = ~Nie, nie odpowiem na twoje pytania. Musisz porozmawiaæ z Garalialem.~ 
@2353 = ~Musisz porozmawiaæ z Garalialem. Ja nie odpowiem na twoje pytania.~
@2354 = ~Znalaz³eœ kulê krasnoludzkiego w³adcy?~ ~Znalaz³aœ kulê krasnoludzkiego w³adcy?~ 
@2355 = ~Jeszcze nie.~
@2356 = ~Zgodzisz siê zrobiæ to, o co proszê?~
@2357 = ~To zale¿y... Zdecydujê, kiedy mi powiesz, o co chodzi.~ 
@2358 = ~Wydajê mi siê, ¿e nie mam wielkiego wyboru, prawda?~
@2359 = ~Có¿, wczeœniej mia³eœ wybór – 30 000 sztuk z³ota. Teraz musisz zdecydowaæ o tym, jak bardzo potrzebujesz pomocy Garaliala.~ ~Có¿, wczeœniej mia³aœ wybór – 30 000 sztuk z³ota. Teraz musisz zdecydowaæ o tym, jak bardzo potrzebujesz pomocy Garaliala.~ 
@2360 = ~Do rzeczy.~
@2361 = ~Jest pewien przedmiot, którego pragnê – znajduje siê w krasnoludzkich podziemiach pod Pentyrchem. Tylko tyle.~
@2362 = ~Pani, by³em w tych jaskiniach pod wiosk¹ i zapewniam ciê, ¿e zbada³em wszystkie zakamarki.~ ~Pani, by³am w tych jaskiniach pod wiosk¹ i zapewniam ciê, ¿e zbada³am wszystkie zakamarki.~ 
@2363 = ~Czy¿by? Jaki jest haczyk?~
@2364 = ~Nie powiedzia³am jaskinie, tylko krasnoludzkie podziemia. Obok wejœcia do jaskiñ s¹ ukryte drzwi, które ka¿dy wprawny z³odziej potrafi znaleŸæ, ale wymagaj¹ one klucza.~
@2365 = ~A ty oczywiœcie masz ten klucz?~
@2366 = ~Mam go, ale haczyk jest taki, ¿e nie mam pojêcia, co jest za tymi drzwiami. S³ysza³am tylko plotki o nieumar³ych, rycerzach œmierci i pu³apkach – nic, z czym sobie nie poradzisz.~
@2367 = ~To dlaczego sama nie pójdziesz i tego nie weŸmiesz, cokolwiek to jest?~
@2368 = ~Nie jestem z³odziejem...~ 
@2369 = ~A ja jestem?~
@2370 = ~...i nie mam umiejêtnoœci, by pokonaæ wszystkie przeszkody w krasnoludzkich podziemiach. Ty natomiast...~ 
@2371 = ~Tak?~ 
@2372 = ~Tak, tak. Mogê to zrobiæ. Czego stamt¹d chcesz?~
@2373 = ~Twoja reputacja ciê wyprzedza. Imponuje mi, jak przekona³eœ Ceinwenê Kruczow³os¹ do wspó³pracy – to by³o genialne zagranie.~ ~Twoja reputacja ciê wyprzedza. Imponuje mi, jak przekona³eœ Ceinwenê Kruczow³os¹ do wspó³pracy – to by³o genialne zagranie.~
@2374 = ~Czego stamt¹d chcesz?~
@2375 = ~Chcê kulê z ber³a króla krasnoludów.~
@2376 = ~¯e co?! I gdzie ona ma byæ?~
@2377 = ~Ze wszystkich badañ, które przeprowadzi³am wynika, ¿e grobowiec króla krasnoludów znajduje siê na samym koñcu podziemi. Wszêdzie czyta³am, ¿e grobowiec jest dobrze strze¿ony, ale ¿adne Ÿród³a nie zgadzaj¹ siê, co do rodzaju tych zabezpieczeñ. Mogê ciê jedynie ostrzec, nie zdo³am ciê na nic przygotowaæ.~
@2378 = ~Co takiego specjalnego jest w tej kuli?~
@2379 = ~Jasne. Czyli szukasz kolejnych idiotów, którzy dadz¹ siê zabiæ?~
@2380 = ~Tylko jeœli sam chcesz siê zabiæ. Ja wola³abym, byœ wróci³ tutaj w jednym kawa³ku i z kul¹ w d³oni.~ ~Tylko jeœli sama chcesz siê zabiæ. Ja wola³abym, byœ wróci³a tutaj w jednym kawa³ku i z kul¹ w d³oni.~
@2381 = ~Nie mam pojêcia i w³aœnie dlatego j¹ chcê. Ponoæ ta kula jest Ÿród³em wielkiej magicznej mocy. Nawet Khelben Czarnokij wyrazi³ w tym swoje zainteresowanie.~
@2382 = ~Znasz Khelbena Czarnokija?~
@2383 = ~Nie. Nie znam tego Harfiarza, choæ czasem bardzo tego ¿a³ujê. W¹tpiê, by on w ogóle wiedzia³ o moim istnieniu.~
@2384 = ~Skoro zna Geltaratha, to i o tobie zapewne wie. Tak, wezmê ten klucz i zobaczê, co uda mi siê znaleŸæ.~
@2385 = ~Có¿, przynajmniej wie o MOIM istnieniu! Daj mi klucz, a przyniosê ci tê kulê.~
@2386 = ~Proszê. Radzê, byœ porozmawia³ z Garalialem, zanim odejdziesz, mo¿e on wie coœ wiêcej.~
@2387 = ~Jeœli chodzi ci o kulê Breaki, to tak, mam j¹.~
@2388 = ~Mówisz o tej ³adnej zabawce?~
@2389 = ~To nie jest jakaœ tam „³adna zabawka”, prostaku. Jeœli chcesz, by Garaliala ci pomóg³, to zap³aæ cenê i daj mi tê kulê – ju¿.~
@2390 = ~Cierpliwoœci, kobieto, cierpliwoœci. Zmieniam warunki umowy: najpierw Garalial uwolni wioskê, a dopiero potem rozstanê siê z kul¹. Sk¹d mam mieæ pewnoœæ, ¿e mogê ufaæ zdradzieckiemu Harfiarzowi?~
@2391 = ~Dwie rzeczy, Pomiocie Bhaala. Po pierwsze, kula równa siê uwolnieniu wioski. Po drugie, NAJPIERW kula, potem uwolnienie wioski. Czy wyra¿am siê jasno?~
@2392 = ~Jak s³oñce. B¹dŸ jednoczeœnie pewna, ¿e jeœli twój przyjaciel nie uwolni wioski, przyjdê tutaj po niego, a jego œmieræ nie bêdzie szybka bezbolesna.~
@2393 = ~Myœlê, ¿e zatrzymam kulê, póki robota nie bêdzie wykonana.~
@2394 = ~Drzwi s¹ tutaj, Pomiocie Bhaala. Wróæ, kiedy sobie to przemyœlisz.~
@2395 = ~Kula Breaki – w rzeczy samej, to ona. Nie chcia³am wspominaæ jej nazwy, by nie zawieœæ siê jak wiele razy wczeœniej. Powiedz, trudno by³o j¹ zdobyæ?~
@2396 = ~Mia³aœ racjê, pani, by³y tam pu³apek i nieumarli – i inne okropieñstwa te¿. Wiedzia³aœ o rycerzach œmierci, którzy samych siebie zw¹ „Trójka”?~
@2397 = ~Nie, <CHARNAME>, nie wiedzia³am. Co z nimi?~
@2398 = ~Strzeg¹ wejœcia do grobu Meilira z Meilirionu. To niezwyk³e zobaczyæ razem trzech rycerzy œmierci. Zdaje mi siê, ¿e nie byli wcale tym, na co wygl¹dali. Ale ostatecznie pozwolili nam przejœæ.~
@2399 = ~Strzeg¹ wejœcia do grobu Meilira z Meilirionu. To niezwyk³e zobaczyæ razem trzech rycerzy œmierci. Zdaje mi siê, ¿e nie byli wcale tym, na co wygl¹dali. Kiedy zaatakowali, przez chwilê myœla³em, ¿e ju¿ zginêliœmy. Nigdy przedtem nie widzia³em ani nie s³ysza³em o rycerzach œmierci u¿ywaj¹cych magii.~ ~Strzeg¹ wejœcia do grobu Meilira z Meilirionu. To niezwyk³e zobaczyæ razem trzech rycerzy œmierci. Zdaje mi siê, ¿e nie byli wcale tym, na co wygl¹dali. Kiedy zaatakowali, przez chwilê myœla³am, ¿e ju¿ zginêliœmy. Nigdy przedtem nie widzia³am ani nie s³ysza³am o rycerzach œmierci u¿ywaj¹cych magii.~
@2400 = ~Ja te¿ nie, <CHARNAME>. S¹ ju¿ zniszczeni?~
@2401 = ~Tak. Ledwie uda³o nam siê prze¿yæ.~
@2402 = ~A co z mieszkañcem tego grobowca? Kto to by³? Powiedzia³eœ: Meilir z Meilirion, tak?~ ~A co z mieszkañcem tego grobowca? Kto to by³? Powiedzia³aœ: Meilir z Meilirion, tak?~
@2403 = ~Myœlê, ¿e znajdziesz to imiê w zwojach historycznych dotycz¹cych Przesmyku Vilhon. Opowiedzia³ nam niezwyk³¹ historiê o „szczêœciu i g³upocie”, jak to okreœli³. Przez g³upota zosta³ uwiêziony, ale jego szczêœcie ostatecznie zwyciê¿y³o – jego dusza teraz znalaz³a spokój.~
@2404 = ~Myœlê, ¿e znajdziesz to imiê w zwojach historycznych dotycz¹cych Przesmyku Vilhon. Ostatecznie postanowi³ z nami walczyæ, choæ mi to nie by³o na rêkê. Nawet nie wiem, czy jego dusza znalaz³a prawdziwy spokój.~
@2405 = ~Co z kul¹?~
@2406 = ~Powiedzia³, ¿e pochodzi z legowiska zielonego smoka w górach Potoku Giganta. Gdzie by³a wczeœniej, tylko bogowie wiedz¹. A podziemia pod Pentyrchem, Lady Angharado? Mia³y kiedyœ swe miano – on nazywa³ je „Meldorarth”.~
@2407 = ~Znalaz³em j¹ na jego grobowcu – wcale nie by³a czêœci¹ jego miecza.~
@2408 = ~„Meldorarth”? Tak, pamiêtam, ¿e Garalial wymieni³ tê nazwê, gdy mówi³ o swoim spotkaniu z krasnoludzkim w³adc¹ wiele lat temu. Tylko ¿e on nie wiedzia³, jak blisko by³ zdobycia kuli – czasem ma za d³ugi jêzyk, co nie jest zbyt komfortowe. No dobrze, <CHARNAME>, twoja czêœæ umowy spe³niona. Teraz my musimy wype³niæ nasz¹. Proszê, porozmawiaj z Garalialem – on ci powie, co musimy teraz zrobiæ.~
@2409 = ~Po prostu le¿a³a tam? No dobrze, <CHARNAME>, twoja czêœæ umowy wykonana. Teraz my musimy wype³niæ nasz¹. Proszê, porozmawiaj z Garalialem – on ci powie, co musimy teraz zrobiæ.~
@2410 = ~Przemyœla³eœ to sobie, co?~ ~Przemyœla³aœ to sobie, co?~
@2411 = ~Tak. WeŸ kulê i pamiêtaj, co mówi³em. Znajdê was oboje.~ ~Tak. WeŸ kulê i pamiêtaj, co mówi³am. Znajdê was oboje.~
@2412 = ~Nie.~
@2413 = ~Zna³em swego czasu Khelbena Arunsuna. Bardzo dawno temu i tak, by³ tu kiedyœ.~

//*************************************************************************
// El¿bieta Pavaral
@2450 = ~Piwny Dwór zapewnia doskona³¹ obs³ugê i spokojn¹ atmosferê. Wola³abym siê im nie odwdziêczaæ zak³óceniem spokoju goœci i krwi¹ na dywanach. Dlatego te¿ proszê ciê o opuszczenie mojego pokoju, zanim bêdê zmuszona wezwaæ stra¿e.~
@2451 = ~Przykro mi, paniusiu, ale przyszliœmy po twoje pieni¹dze albo twoje ¿ycie. Wybór nale¿y do ciebie i lepiej dokonaj go szybko.~
@2452 = ~Przepraszamy za k³opot. Ju¿ nas tu nie ma.~
@2453 = ~A kim ty jesteœ, ¿e stra¿ pos³ucha twojego wezwania?~
@2454 = ~Nie mam ci nic wiêcej do powiedzenia.~
@2455 = ~Œwietnie. Nie wracaj! Nie... zaczekaj...~
@2456 = ~Tak?~
@2457 = ~Nie wiesz, co robisz! Przybywam z wielkiego miasta Waterdeep i jestem goœciem Athkatli. WeŸ moje pieni¹dze, ale wiedz, ¿e nie ujdzie ci to na sucho.~
@2458 = ~Jestem Lady El¿bieta Pavaral, wys³anniczka z Waterdeep. Wys³ano mnie do tego barbarzyñskiego miasta z misj¹ wyjaœnienia nieporozumieñ pomiêdzy naszymi ludami. Skoro ju¿ wiesz, kim jestem, wynoœ siê z mojego pokoju!! Nie... Zaczekaj...~
@2459 = ~Poznajê twoj¹ twarz! Jesteœ Pomiotem Bhaala, który sprawi³ tyle k³opotów ¯elaznemu Tronowi. By³eœ jednak wtedy znacznie m³odszy, tak mi siê przynajmniej wydaje. Twoja twarz znacznie siê postarza³a. To na balu inauguracyjnym nowego ksiêcia Sarevoka sprawy przybra³y z³y obrót i pojawili siê ci krwio¿erczy zmiennokszta³tni.~ ~Poznajê twoj¹ twarz! Jesteœ Pomiotem Bhaala, który sprawi³ tyle k³opotów ¯elaznemu Tronowi. By³aœ jednak wtedy znacznie m³odsza, tak mi siê przynajmniej wydaje. Twoja twarz znacznie siê postarza³a. To na balu inauguracyjnym nowego ksiêcia Sarevoka sprawy przybra³y z³y obrót i pojawili siê ci krwio¿erczy zmiennokszta³tni.~
@2460 = ~Co z tego?~
@2461 = ~Ha! ¯elazny Ksi¹¿ê Sarevok! No có¿, on nie ¿yje, a ja jestem tutaj. To chyba mówi samo za siebie, nieprawda¿?~
@2462 = ~Có¿, pomimo twojej arogancji, nie mo¿na odmówiæ ci odwagi.~
@2463 = ~W rzeczy samej.~
@2464 = ~Do pewnego czasu mogê tolerowaæ arogancjê, ale ty naprawdê nie znasz umiaru. Zmieni³am zdanie. Nie mam ochoty z tob¹ rozmawiaæ. Wynoœ siê st¹d!!!~
@2465 = ~Udowodni³eœ wtedy swoj¹ determinacjê i niezawodnoœæ. Dziêki tobie umknê³am rzezi. Jeœli zgodzisz siê mnie wys³uchaæ, chcia³abym ciê prosiæ o przys³ugê.~ ~Udowodni³aœ wtedy swoj¹ determinacjê i niezawodnoœæ. Dziêki tobie umknê³am rzezi. Jeœli zgodzisz siê mnie wys³uchaæ, chcia³abym ciê prosiæ o przys³ugê.~
@2466 = ~Wys³ucham ciê, Lady Pavaral. Na czym polega twój problem?~
@2467 = ~Przykro mi, ale nie mam czasu. ¯egnaj.~
@2468 = ~W drodze tutaj zgubi³am siê i trafi³am do najgorszej czêœci miasta. Niemal od razu mnie okradziono. Z³odzieje zaszli moich stra¿ników od ty³u i nie dali im szansy na obronê. PóŸniej zniknêli we w³azie do kana³ów!~
@2469 = ~Wœród skradzionych mi rzeczy by³ pierœcieñ, który dosta³am w darze od ojca. Nie zale¿y mi na klejnotach i z³ocie, ale ten pierœcieñ ma dla mnie wielk¹ wartoœæ.~
@2470 = ~Poinformowa³aœ stra¿ miejsk¹?~
@2471 = ~S¹ bezradni. Obiecuj¹ mi jedno, a robi¹ co innego. Chcia³abym ciê prosiæ o odzyskanie mojego pierœcienia. Zrobisz to?~
@2472 = ~Jak wygl¹da ten pierœcieñ?~
@2473 = ~Co bêdê z tego mia³?~ ~Co bêdê z tego mia³a?~
@2474 = ~Nie zrobiê tego, moja pani. Twój pierœcieñ zosta³ skradziony przez Z³odziei Cienia, a ja nie nale¿ê do ich faworytów.~
@2475 = ~Wygl¹da jak zwyk³y pierœcieñ tañcz¹cego p³omienia, jednak g³ówny p³omieñ zosta³ zast¹piony przez ciemnoczerwony granat. Ojciec powtarza³, ¿e pewnego dnia zast¹pi go prawdziwym rubinem.~
@2476 = ~To precyzyjny opis. Mam ju¿ nawet pomys³, gdzie mog¹ byæ twoi z³odzieje.~
@2477 = ~Dziêkujê. Bêdê tu na ciebie czeka³a.~
@2478 = ~Tyle z³ota, ile zdo³asz odebraæ z³odziejom, ty chciwy draniu. Po prostu przynieœ mój pierœcieñ, jeœli to dla ciebie nie k³opot!~ ~Tyle z³ota, ile zdo³asz odebraæ z³odziejom, ty chciwa harpio. Po prostu przynieœ mój pierœcieñ, jeœli to dla ciebie nie k³opot!~
@2479 = ~Grzeczniej, paniusiu, grzeczniej! Jak wygl¹da ten pierœcieñ?~
@2480 = ~Wygl¹da jak zwyk³y pierœcieñ tañcz¹cego p³omienia, jednak g³ówny p³omieñ zosta³ zast¹piony przez ciemnoczerwony granat. Nie ma zbyt wielkiej wartoœci dla z³odzieja.~
@2481 = ~To precyzyjny opis. Mam ju¿ nawet pomys³, gdzie mog¹ byæ twoi z³odzieje.~
@2482 = ~Mam nadziejê, ¿e go znajdziesz. Nie pozwól, ¿eby z³odzieje wykorzystali twoj¹ arogancjê przeciwko tobie. Bêdê tu na ciebie czeka³a. ~
@2483 = ~Czy znalaz³eœ ju¿ mój pierœcieñ?~ ~Czy znalaz³aœ ju¿ mój pierœcieñ?~
@2484 = ~Jeszcze nie.~
@2485 = ~Mój pierœcieñ!!! Naprawdê go znalaz³eœ! Tak siê cieszê!~ ~Mój pierœcieñ!!! Naprawdê go znalaz³aœ! Tak siê cieszê!~
@2486 = ~Ca³a przyjemnoœæ po mojej stronie, Lady El¿bieto.~
@2487 = ~Chwileczkê. Nie zosta³o mi zbyt wiele z³ota, ale proszê, przyjmij to jako nagrodê za twój trud.~
@2488 = ~Dziêkujê ci.~
@2489 = ~Mój pierœcieñ!!! Mówi³am ci, ¿e nie op³aca siê go sprzedawaæ, ale na pewno próbowa³eœ.~ ~Mój pierœcieñ!!! Mówi³am ci, ¿e nie op³aca siê go sprzedawaæ, ale na pewno próbowa³aœ.~
@2490 = ~Nie próbowa³em. A teraz dawaj nagrodê.~ ~Nie próbowa³am. A teraz dawaj nagrodê.~
@2491 = ~Mówi³am ci, ¿e mo¿esz sobie zatrzymaæ ca³e z³oto, jakie znajdziesz przy z³odziejach. A teraz idŸ! Nie mam ochoty ciê wiêcej ogl¹daæ.~
@2492 = ~Ani ja ciebie.~
@2493 = ~Jesteœ tak samo bezu¿yteczny jak stra¿ miejska. OdejdŸ wiêc i do³¹cz do twoich tchórzliwych przyjació³ na ulicy.~ ~Jesteœ tak samo bezu¿yteczna jak stra¿ miejska. OdejdŸ wiêc i do³¹cz do twoich tchórzliwych przyjació³ na ulicy.~

//*************************************************************************
