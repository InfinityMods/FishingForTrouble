//*************************************************************************
// Tahir
@3890 = ~Ach, kolejni goœcie! Jesteœcie Pustynnymi Wêdrowcami? Nie... Wasz wygl¹d wskazuje, ¿e pochodzicie z Pó³nocy. Witajcie w Wodnej Krawêdzi! W czym mogê wam pomóc? ~
@3891 = ~Kim jesteœ?~
@3892 = ~Co próbujesz mi sprzedaæ? Co to za miejsce?~
@3893 = ~Jesteœcie w Wodnej Krawêdzi, najlepszym karawanseraju na ca³ej pustyni Calim. Jestem Tahir, w³aœciciel Wodnej Krawêdzi.~
@3894 = ~Karawanseraju? Co to takiego?~
@3895 = ~Dla mnie to wygl¹da bardziej na œmietnisko.~
@3896 = ~Jestem Tahir, w³aœciciel Wodnej Krawêdzi. Œmiem twierdziæ, ¿e to najlepszy karawanseraj na ca³ej pustyni Calim.~
@3897 = ~Rzeczywiœcie, wygl¹da znakomicie.~
@3898 = ~Có¿, karawanseraj to miejsce postoju dla kupców i karawan przemierzaj¹cych pustyniê Calim. Zazwyczaj jest dla nich ostatnim dogodnym schronieniem, które bêd¹ ogl¹daæ przez d³u¿szy czas, niezale¿nie w któr¹ stronê zmierzaj¹.~
@3899 = ~Z mojej perspektywy rzeczywiœcie wygl¹da okazale.~
@3900 = ~Za³o¿ê siê, ¿e ³ó¿ka s¹ tutaj pe³ne pche³, w pokojach roi siê od jadowitych paj¹ków, a za wynajem postarasz siê zedrzeæ ze mnie tyle z³ota, ile zdo³asz, prawda?~
@3901 = ~Wszystko zale¿y od punktu widzenia. Moje ceny s¹ przystêpne, chocia¿ w obrêbie wielu mil nie ma innego miejsca, w którym mo¿na siê zatrzymaæ. Wolê mieæ niskie ceny i pe³ny zajazd, ni¿ wysokie i zwin¹æ interes. Brzmi sensownie, nieprawda¿? Chcesz zobaczyæ moj¹ ofertê?~
@3902 = ~Chyba tak. Poka¿ mi wiêc, jak niskie s¹ twoje ceny, Tahirze.~
@3903 = ~Nie w tej chwili, Tahirze.~
@3904 = ~To miejsce nadal wygl¹da jak œmietnisko.~
@3905 = ~Có¿... twój wybór. Chcesz skorzystaæ z moich us³ug czy nie?~
@3906 = ~Dobrze. Zaskocz mnie.~
