@6157 = ~Niektórzy maj¹ pe³no miodu w uszach. Odczep siê.~

//*************************************************************************
// Kucharka
@6200 = ~Elf! W MOJEJ kuchni! Czego tu szukasz, szpiczastouchy?~ ~Elfka! W MOJEJ kuchni! Czego tu szukasz, szpiczastoucha?~
@6201 = ~Musisz byæ taka niegrzeczna?~
@6202 = ~Udam, ¿e nie s³ysza³em tej obelgi. Na razie.~ ~Udam, ¿e nie s³ysza³am tej obelgi. Na razie.~
@6203 = ~Tak. Nie lubiê elfów. Za³apa³eœ?~ ~Tak. Nie lubiê elfów. Za³apa³aœ?~
@6204 = ~Zrobi³em ci jak¹œ krzywdê? Nie, zapomnij. Nie musisz odpowiadaæ. Hrabina mówi³a, ¿e masz problem ze z³odziejem.~ ~Zrobi³am ci jak¹œ krzywdê? Nie, zapomnij. Nie musisz odpowiadaæ. Hrabina mówi³a, ¿e masz problem ze z³odziejem.~
@6205 = ~„Obelgi”, powiadasz? Z mojego punktu widzenia to szczera prawda! Elfy zawsze sprowadzaj¹ k³opoty. Nawet krasnoludy s¹ lepsze.~
@6206 = ~Co takiego ci uczyni³em, ¿e mnie obra¿asz? Nie, zapomnij. Nie musisz odpowiadaæ. Hrabina mówi³a, ¿e masz problem ze z³odziejem.~ ~Co takiego ci uczyni³am, ¿e mnie obra¿asz? Nie, zapomnij. Nie musisz odpowiadaæ. Hrabina mówi³a, ¿e masz problem ze z³odziejem.~
@6207 = ~Hê? Czego chcesz? Gadaj prêdko, nie mam ca³ego dnia!~
@6208 = ~Jesteœ kuchark¹ Warowni Cerendora?~
@6209 = ~Czy ktoœ kradnie jedzenie ze spi¿arni?~
@6210 = ~A jak myœlisz? Oczywiœcie, ¿e jestem kuchark¹!!! Jesteœ œlepy czy co?~ ~A jak myœlisz? Oczywiœcie, ¿e jestem kuchark¹!!! Jesteœ œlepa czy co?~
@6211 = ~Nie jestem œlepy, ty g³upia, stara wiedŸmo. Ktoœ kradnie ci jedzenie, czy nie?~ ~Nie jestem œlepa, ty g³upia, stara wiedŸmo. Ktoœ kradnie ci jedzenie, czy nie?~
@6212 = ~Dobrze ju¿, dobrze. S³uchaj, hrabina mówi³a, ¿e masz jakiœ problem z kradzie¿ami. Czy to prawda?~
@6213 = ~Ha! WiedŸma, tak? Gdzie twoje dobre maniery?~
@6214 = ~Wygl¹da na to, ¿e uciek³y na twój widok.~
@6215 = ~CO TAKIEGO?!~
@6216 = ~Hrabina mówi³a, ¿e masz jakiœ problem z kradzie¿ami. Czy to prawda?~
@6217 = ~Problem z kradzie¿ami? Oczywiœcie, ¿e mam problem z kradzie¿ami!!! Czemuœ nie mówi³, ¿e to hrabina ciê przysy³a?~ ~Problem z kradzie¿ami? Oczywiœcie, ¿e mam problem z kradzie¿ami!!! Czemuœ nie mówi³a, ¿e to hrabina ciê przysy³a?~
@6218 = ~Mo¿e dlatego, ¿e nie dopuœci³aœ mnie do g³osu? To o co chodzi z tym z³odziejem? Co zginê³o?~
@6219 = ~Problem z kradzie¿ami? Oczywiœcie, ¿e mam problem z kradzie¿ami!!! Wszyscy wiedz¹, ¿e mam problem z kradzie¿ami!!!~
@6220 = ~Wiêc co kradnie ten z³odziej?~
@6221 = ~No przecie¿ ¿arcie!!! To w koñcu kuchnia, tak czy nie?~
@6222 = ~Tak, to jest kuchnia. Jakiego rodzaju jedzenie znika?~
@6223 = ~Po prostu ¿arcie!!! Wszystko, co zostaje po przygotowaniu posi³ków, znika! Co noc! Jeœli tak dalej pójdzie, to nied³ugo nie bêdzie tutaj czego ukraœæ!~
@6224 = ~Masz jakiœ pomys³, kto mo¿e byæ z³odziejem?~
@6225 = ~Skad mog³abym wiedzieæ? Chocia¿ jednej nocy coœ widzia³am... kogoœ ma³ego, mo¿e nizio³ka. Ale w warowni nie ma ¿adnych nizio³ków. ¯adnych dzieci te¿ tu w tej chwili nie ma.~
@6226 = ~Nizio³ek, tak? Albo ktoœ bardzo niski. Jesteœ pewna?~
@6227 = ~Oczywiœcie, ¿e tak! Nie jestem przecie¿ œlepa!!! Ktokolwiek to by³, znikn¹³ za drzwiami prowadz¹cymi na blanki. By³ diablo szybki.~
@6228 = ~Jasne. Ta informacja mo¿e byæ pomocna. Zostawiê ciê z twoimi garnkami.~
@6229 = ~Najwy¿szy czas. Obiad sam siê nie ugotuje, a ten pata³ach nie potrafi³by ugotowaæ jajka, nawet gdyby zale¿a³o od tego jego ¿ycie.~
@6230 = ~Jeœli koniecznie musisz wiedzieæ, dzisiaj na obiad bêdzie obrzydliwa ryba z tej przeklêtej rzeki. Znowu. Znowu. NIENAWIDZÊ gotowaæ RYB!!!~
@6231 = ~Hej, ty tam. To moja kuchnia i nie lubiê intruzów. Wynocha!~
@6232 = ~Hej, ty... tak, ty, przem¹drza³y, zarozumia³y szpiczastouchy!!! To MOJA kuchnia, a ja nie lubiê elfów, wiêc wynocha!~ ~Hej, ty... tak, ty, przem¹drza³a, zarozumia³a szpiczastoucha!!! To MOJA kuchnia, a ja nie lubiê elfów, wiêc wynocha!~
@6233 = ~Ale ja nic nie zrobi³em!~ ~Ale ja nic nie zrobi³am!~
@6234 = ~Ale ja nie jestem elfem!~ ~Ale ja nie jestem elfk¹!~
@6235 = ~WYPAD!!!~
@6236 = ~Masz szpiczaste uszy, tak? Wynocha st¹d!!!~
@6237 = ~Czy nie kaza³am ci siê wynieœæ? Nie chcê ciê w mojej kuchni. Dotar³o do têpej czachy!?~
@6238 = ~Znowu ty. Na Szpony Umberlee, d³u¿ej nie wytrzymam tych najœæ. Wynoœ siê z mojej kuchni i nie wracaj!~
@6239 = ~Wypad! Wypad! Wypad! WYPAD!!!~

//*************************************************************************
// Kowal z Warowni Cerendora [w³aœciwy]
@6240 = ~Moje towary s¹ dla ciebie dostêpne od rêki. Proszê, rozejrzyj siê.~
@6241 = ~No to poka¿, co masz.~
@6242 = ~Nie teraz.~
@6243 = ~Dziêkujê.~
@6244 = ~Dziêkujê, nie w tej chwili.~
@6245 = ~Czego chcesz?~
@6246 = ~Kim jesteœ?~
@6247 = ~Nie b¹dŸ taki nieuprzejmy, starcze. Mo¿esz tego po¿a³owaæ.~
@6248 = ~To nie jest dobry pomys³, choæ mo¿e ci siê wydawaæ inaczej. Mo¿e chcesz spróbowaæ? Przejœæ od s³ów do czynów?~
@6249 = ~Pewnego dnia, starcze, tak zrobiê. Kim jesteœ?~
@6250 = ~Nazywam siê Havren Kowal, jak siê mo¿esz domyœliæ, jestem zbrojmistrzem i kowalem Warowni Cerendora.~
@6251 = ~Co ci wiadomo na temat krêc¹cych siê po okolicy Czerwonych Magów?~
@6252 = ~Musisz na ten temat porozmawiaæ z zarz¹dc¹ karawan. Ja siê zajmujê kowalstwem, nie politykowaniem.~
@6253 = ~I pewnie s³usznie czynisz. Masz coœ do sprzedania?~
@6254 = ~Proszê bardzo.~
