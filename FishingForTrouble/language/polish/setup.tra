@3350 = ~Chcesz kupiæ wiêcej moich towarów?~
@3351 = ~Tak.~
@3352 = ~Nie.~
@3353 = ~Witaj, <CHARNAME>. Jestem Colla syn Tigernacha syna Muirgheasa.~
@3354 = ~Witaj, Collo synu Tigernacha. Co mogê dla ciebie zrobiæ?~
@3355 = ~A czego chcesz?~
@3356 = ~Witaj, panie. Jestem Colla syn Tigernacha syna Muirgheasa.~ ~Witaj, pani. Jestem Colla syn Tigernacha syna Muirgheasa.~
@3357 = ~Mam trochê przedmiotów dla maga, które ciê mog¹ zainteresowaæ. Chcesz rzuciæ na nie okiem?~
@3358 = ~Tak, proszê.~
@3359 = ~Nie teraz, mo¿e innym razem.~
@3360 = ~Mam trochê przedmiotów dla maga, które ciê mog¹ zainteresowaæ – za op³at¹, oczywiœcie. Chcesz rzuciæ na nie okiem?~
@3361 = ~Poka¿ mi je.~
@3362 = ~Ale¿ proszê.~

