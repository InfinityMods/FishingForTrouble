// Pashan
@3700 = ~Obcy w naszych stronach! Pochodzisz z Pó³nocy, nieprawda¿? Poznajê. Czego chcesz siê dowiedzieæ?~
@3701 = ~W tej chwili niczego, dziêkujê.~
@3702 = ~Chcê ci zadaæ kilka pytañ.~
@3703 = ~IdŸ wsadzaæ nos w sprawy kogoœ innego.~
@3704 = ~Kolejne pytania? Tak? Czego chcesz siê dowiedzieæ?~
@3705 = ~Tak, mam wiêcej pytañ.~
@3706 = ~Moja matka mówi, ¿e jestem g³upi, ale przynajmniej potrafiê byæ uprzejmy.~
@3707 = ~Zadawaj swoje pytania. Odpowiem, jeœli zdo³am!~
@3708 = ~Na razie to wszystko.~
@3709 = ~Kim jesteœ?~
@3710 = ~Co to za miejsce?~
@3711 = ~Czy mo¿na gdzieœ tutaj znaleŸæ nocleg?~
@3712 = ~Gdzie mogê znaleŸæ zbrojmistrza?~
@3713 = ~Gdzie znajdê Tygrysie oko?~
@3714 = ~Tygrysie oko. Podobno jest naprawdê piêkne. Zapytaj o nie Aieshê. Aiesha wie wszystko!~
@3715 = ~Gdzie mogê j¹ znaleŸæ?~
@3716 = ~Mieszka w tamtej chacie. To równie¿ moja chata.~
@3717 = ~Co to za wielki dom?~
@3718 = ~Nazywam siê Pashan i mieszkam tutaj!~
@3719 = ~Jesteœ w Imradim, najbardziej wysuniêtej na pó³noc oazie na pustyni Calim. Nie wiedzia³eœ o tym? Wszyscy tutaj wiedz¹!~ ~Jesteœ w Imradim, najbardziej wysuniêtej na pó³noc oazie na Pustyni Calim. Nie wiedzia³aœ o tym? Wszyscy tutaj wiedz¹!~
@3720 = ~IdŸ porozmawiaæ z grubasem w Wodnej Krawêdzi. Nie podam ci jego imienia, bo mnie nie lubi.~
@3721 = ~Koury twierdzi, ¿e najlepsz¹ broñ na pustyni Calim wytwarzaj¹ Pustynni Wêdrowcy. Masz szczêœcie, w³aœnie dziœ rozbili obóz na po³udnie od miasta. Ale i tak nie pozwol¹ mi siê pobawiæ ich lœni¹cymi mieczami.~
@3722 = ~Ten dom nale¿y do najbogatszego kupca w ca³ym Imradim! Kiedyœ dorównam mu maj¹tkiem!~
@3723 = ~Bogatego kupca, tak? Jak siê nazywa?~
@3724 = ~Levon.~
@3725 = ~Po prostu Levon?~
@3726 = ~Tak. Nie. Nie powinienem ci tego mówiæ. Aiesha twierdzi, ¿e jego prawdziwe nazwisko to Levon z Desthimy.~

