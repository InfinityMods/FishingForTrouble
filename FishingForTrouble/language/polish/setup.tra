// Akil
@4800 = ~Po prostu znajdŸ dla mnie tego drania Levona. Nie mogê siê doczekaæ jego miny.~
@4801 = ~Có¿, to chyba koniec. Nie chcia³em jego œmierci, ale nie pozostawi³ nam wyboru.~
@4802 = ~Niestety.~
@4803 = ~G³upiec. Co chcia³ osi¹gn¹æ?~
@4804 = ~Wraz z nasz¹ œmierci¹ zniknê³oby ryzyko kompromitacji. Dziêkujê ci za pomoc, <CHARNAME>. Nie by³oby mnie tutaj bez ciebie. Jak mogê ci siê odwdziêczyæ?~
@4805 = ~Za pomoc¹ 2000 sztuk z³ota?~
@4806 = ~Za pomoc¹ 10000 sztuk z³ota?~
@4807 = ~Nagroda nie jest konieczna. Zrobi³em, co do mnie nale¿a³o.~ ~Nagroda nie jest konieczna. Zrobi³am, co do mnie nale¿a³o.~
@4808 = ~Nie mogê na to pozwoliæ! Bywaj, <CHARNAME>. Niechaj bogowie spogl¹daj¹ na ciebie przychylnym okiem.~
@4809 = ~Wysokoœæ ceny za moj¹ g³owê? Doprawdy? Nic ³atwiejszego! WeŸ jeszcze to. Bywaj, <CHARNAME>. Niechaj bogowie spogl¹daj¹ na ciebie przychylnym okiem.~
@4810 = ~Wartoœæ b³êkitnych diamentów, tak? Trochê kosztowne. Bywaj, <CHARNAME>. Niechaj bogowie spogl¹daj¹ na ciebie przychylnym okiem.~
@4811 = ~Hmm, intruzi. Kim jesteœcie, ¿e wkraczacie tu z tak¹ œmia³oœci¹?~
@4812 = ~Jestem <CHARNAME>, od niedawna z Athkatli. Dlaczego pytasz?~
@4813 = ~Kim ty jesteœ?~
@4814 = ~Zamknij jadaczkê. Powiem ci, kiedy bêdê mia³ na to ochotê, nie wczeœniej.~ ~Zamknij jadaczkê. Powiem ci, kiedy bêdê mia³a na to ochotê, nie wczeœniej.~
@4815 = ~Jeœli nie zaczniesz uwa¿aæ na s³owa, ju¿ tam nie wrócisz. Co tutaj robisz?~
@4816 = ~Szukam osoby o imieniu Akil. Przypuszczam, ¿e to ty.~
@4817 = ~Po prostu siê rozgl¹dam. Zobaczy³em jaskiniê i wszed³em do œrodka.~ ~Po prostu siê rozgl¹dam. Zobaczy³am jaskiniê i wesz³am do œrodka.~
@4818 = ~To ja tutaj zadajê pytania. Gdybyœ nie zauwa¿y³, mamy przewagê liczebn¹. Gadaj, kim jesteœ.~
@4819 = ~Na razie nie odpowiem na to pytanie. Najpierw powiedz, kim ty jesteœ.~
@4820 = ~Dobrze. Nie wygl¹dasz na zwyk³ego poszukiwacza skarbów, wiêc powiem ci. Jestem Akil.~
@4821 = ~A ja jestem <CHARNAME>, od niedawna z Athkatli. Szuka³em ciê.~ ~A ja jestem <CHARNAME>, od niedawna z Athkatli. Szuka³am ciê.~
@4822 = ~Akil, tak? Jestem <CHARNAME> z Amn. Nie jestem poszukiwaczem skarbów, ale lubiê czasem poszwendaæ siê po jaskiniach.~ ~Akil, tak? Jestem <CHARNAME> z Amn. Nie jestem poszukiwaczk¹ skarbów, ale lubiê czasem poszwendaæ siê po jaskiniach.~
@4823 = ~Gdybyœ nie zauwa¿y³, mamy przewagê liczebn¹. Mów, kim jesteœ. I to prêdko!~
@4824 = ~<CHARNAME>. Po prostu <CHARNAME>~
@4825 = ~Dobrze, <CHARNAME>, po prostu <CHARNAME>. Nie by³o to takie trudne, nieprawda¿. Imiê za imiê – jestem Akil, a to s¹ moi przyjaciele. B¹dŸ z nimi ostro¿ny, <CHARNAME>.~ ~Dobrze, <CHARNAME>, po prostu <CHARNAME>. Nie by³o to takie trudne, nieprawda¿. Imiê za imiê – jestem Akil, a to s¹ moi przyjaciele. B¹dŸ z nimi ostro¿na, <CHARNAME>.~
@4826 = ~Akil? Szuka³em ciê.~ ~Akil? Szuka³am ciê.~
@4827 = ~Akil. A to jest twoja jaskinia, tak?~
@4828 = ~To moja jaskinie. Moja kryjówka. Mój dom z dala od domu.~
@4829 = ~Doprawdy? Chyba kryje siê za tym coœ wiêcej. Chêtnie wys³ucham twojej opowieœci, jeœli zgodzisz siê ni¹ podzieliæ.~
@4830 = ~Skoro mnie szukasz, to rozmawia³eœ z tym draniem Levonem, prawda? Zaproponowa³ ci nagrodê za moj¹ g³owê? Kilka osób ju¿ próbowa³o j¹ zdobyæ i nie uda³o im siê. Chcesz byæ nastêpny?~ ~Skoro mnie szukasz, to rozmawia³aœ z tym draniem Levonem, prawda? Zaproponowa³ ci nagrodê za moj¹ g³owê? Kilka osób ju¿ próbowa³o j¹ zdobyæ i nie uda³o im siê. Chcesz byæ nastêpna?~
@4831 = ~Spokojnie, Akilu. Levon rzeczywiœcie pragnie twojej œmierci, ale ja jeszcze nie podj¹³em decyzji. Cena za twoj¹ g³owê jest trochê za wysoka jak na zwyk³ego bandytê.~ ~Spokojnie, Akilu. Levon rzeczywiœcie pragnie twojej œmierci, ale ja jeszcze nie podjê³am decyzji. Cena za twoj¹ g³owê jest trochê za wysoka jak na zwyk³ego bandytê.~
@4832 = ~Nagroda za twoj¹ g³owê? 2000 sztuk z³ota, które mam zamiar zdobyæ!~
@4833 = ~Chcesz us³yszeæ moj¹ historiê? Nie mam zbyt wiele do opowiadania i œmiem twierdziæ, ¿e s³ysza³eœ ju¿ podobne opowieœci. Jest to historia o g³upocie, zach³annoœci i zemœcie. Usi¹dŸmy sobie wygodnie. A wiêc by³o to tak.~ ~Chcesz us³yszeæ moj¹ historiê? Nie mam zbyt wiele do opowiadania i œmiem twierdziæ, ¿e s³ysza³aœ ju¿ podobne opowieœci. Jest to historia o g³upocie, zach³annoœci i zemœcie. Siedzicie wygodnie? Pozwólcie wiêc, ¿e zacznê.~
@4834 = ~Moim pierwszym b³êdem by³o zakochanie siê w córce Levona, Aaliyi. To znaczy, wtedy nie uwa¿a³em tego za b³¹d, ale tak siê póŸniej siê okaza³o. Drugim b³êdem by³o moje pragnienie udowodnienia Levonowi, ¿e jestem godny rêki jego córki.~
@4835 = ~Nu¿y mnie ta opowieœæ. Zdecydowa³em, ¿e szybciej bêdzie skróciæ ciê o g³owê.~ ~Nu¿y mnie ta opowieœæ. Zdecydowa³am, ¿e szybciej bêdzie skróciæ ciê o g³owê.~
@4836 = ~I?~
@4837 = ~Moim trzecim b³êdem by³o zostanie handlarzem klejnotami, tak jak Levon. Widzisz, by³em w tym dobry, nawet bardzo. Kilka podró¿y do Calimportu, gdzie dobija³em targów z ¿eglarzami z Tashalaru, parê wypraw do Królestw Granicznych i jedna pamiêtna ekspedycja do Nelantheru – by³em bliski stania siê bogaczem.~
@4838 = ~Talosie! Odby³em nawet kilka wycieczek do Athkatli, ale droga tam i z powrotem szlakiem l¹dowym by³a zbyt uci¹¿liwa. Morzem by³o szybciej.~
@4839 = ~Nadszed³ w koñcu dzieñ, w którym uzna³em, ¿e moje sukcesy wywr¹ wra¿enie nawet na tym starym chciwcu.~
@4840 = ~Poprosi³eœ go o rêkê Aaliyi?~
@4841 = ~Tak. A ten zdradziecki drañ siê zgodzi³. Wiedzia³, ¿e wybieram siê w jeszcze jedn¹ podró¿ do Suldolphoru i Marchii They, wiêc poprosi³ mnie o odebranie dla niego pewnych klejnotów z Almraiven.~
@4842 = ~Rzecz jasna zgodzi³em siê. Co z³ego mog³o siê staæ? Levon nie powiedzia³ mi jednak, ¿e ta „niewielka paczuszka klejnotów” zawiera³a b³êkitne diamenty wysokiej jakoœci pochodz¹ce z Dymi¹cych Gór. By³y warte mniej wiêcej tyle samo, co ca³y mój ³adunek i oszczêdnoœci.~
@4843 = ~Przykre. Ale chyba wystarczy ju¿ tej ³zawej historii.~
@4844 = ~Niech zgadnê. By³y kradzione?~
@4845 = ~Sk¹d wiedzia³eœ? Zbli¿aliœmy siê w³aœnie do zachodniego skraju Bagniska Paj¹ków, kiedy wpadliœmy w zasadzkê.~ ~Sk¹d wiedzia³eœ? Zbli¿aliœmy siê w³aœnie do zachodniego skraju Bagniska Paj¹ków, kiedy wpadliœmy w zasadzkê.~
@4846 = ~Wygl¹da³o to na po¿ar traw – nic nadzwyczajnego o tej porze roku, wiêc zboczyliœmy na po³udnie i kontynuowaliœmy podró¿ przez mokrad³a. To nas spowolni³o. I wtedy grupa uzbrojonych po zêby rabusiów wy³oni³a siê z gêstego dymu i runê³a na nas.~
@4847 = ~Po¿ar traw? Phi. To by³o perfekcyjnie przygotowane zaklêcie iluzji. Najpierw zabito stra¿ników karawany. Wiêkszoœæ z nich nie zd¹¿y³a nawet wyci¹gn¹æ mieczy. PóŸniej jeŸdŸcy wziêli siê za nas – za mnie i moich szeœciu ochroniarzy. Rozumiecie? Karawana sk³ada³a siê z oœmiu kupców, a my byliœmy w jej tylnej czêœci, a mimo to skierowali siê w³aœnie ku nam.~
@4848 = ~Czy móg³ to byæ zbieg okolicznoœci?~
@4849 = ~Móg³by, gdyby nie jedna rzecz. S³ysza³em s³owa jednego z jeŸdŸców: „To oni, ci, o których powiedzia³ nam Levon”.~
@4850 = ~Mo¿esz to udowodniæ?~
@4851 = ~Oczywiœcie, ¿e nie. Mia³em zgin¹æ, ale prze¿y³em. JeŸdŸcy zabili moich ochroniarzy, a ja otrzyma³em ranê w bok. Koñ zrzuci³ mnie do wody, a oni, sugeruj¹c siê krwi¹, która pokrywa³a powierzchniê bagna wokó³ mnie, uznali mnie za martwego.~
@4852 = ~Co siê sta³o z reszt¹ karawany?~
@4853 = ~JeŸdŸcy najwyraŸniej rozbili j¹, okradli kilku kupców, ¿eby zatrzeæ œlady, po czym odjechali w sin¹ dal, unosz¹c ze sob¹ b³êkitne diamenty i ca³y mój urobek.~
@4854 = ~Zosta³o mi kilka sztuk z³ota w sakiewce przy pasie, a rana nie okaza³a siê groŸna. Trzy miesi¹ce póŸniej przyby³em z powrotem do Imradim. Levon rozdziawi³ usta ze zdumienia tak szeroko, ¿e móg³by mnie chyba po³kn¹æ. Prêdko jednak odzyska³ rezon i okaza³ mi g³êbokie wspó³czucie. Dwa dni póŸniej otrzyma³em wezwanie do zap³aty.~
@4855 = ~Wezwanie do zap³aty? Za co?~
@4856 = ~Za utracone b³êkitne diamenty. By³o w nim napisane, ¿e niew³aœciwie ich pilnowa³em i pozwoli³em, ¿eby zosta³y skradzione podczas ucieczki. I jeszcze, ¿e po pijanemu przechwala³em siê swoim ³adunkiem. Tyle tylko, ¿e ja nie pijê. I wiesz co? Skojarzy³em to z pods³uchanymi s³owami jeŸdŸca i nie by³em ani trochê zdziwiony.~
@4857 = ~Koniec koñców, Levon ogo³oci³ mnie do ostatniego miedziaka. Czêœæ pieniêdzy posz³a na rekompensatê za ukradzione diamenty, reszta na pokrycie potencjalnych zysków i strat moralnych. W ten sposób nieŸle zarobi³ na tych kamykach.~
@4858 = ~A co siê sta³o z Aaliy¹?~
@4859 = ~No tak, wreszcie doszliœmy do niej. Znaleziono jej mê¿a. Ksiêcia, ¿eby nie by³o, trzeciego syna su³tana. Zosta³o mi paru przyjació³ – jak mo¿na siê by³o domyœliæ, wiêkszoœæ zniknê³a wraz z moim maj¹tkiem – i zada³em przy ich pomocy parê dyskretnych pytañ.~
@4860 = ~Odpowiedzi ujawni³y kilka faktów. Su³tan z³o¿y³ propozycjê ma³¿eñstwa na tydzieñ przed moim wyjazdem na wyprawê. Mogê to udowodniæ. Sojusz z panuj¹cym rodem bardzo wzmocni³ pozycjê Levona. Nigdy nie zaszed³by tak wysoko o w³asnych si³ach. W tej sytuacji nie by³em dla niego nic wart.~
@4861 = ~Ale po co odebra³ ci maj¹tek?~
@4862 = ~Poniewa¿ zamach na moje ¿ycie siê nie powiód³, Levon nie odwa¿y³ siê próbowaæ tego samego po raz drugi. Biedny Akil jest jednak o wiele mniej k³opotliwy od bogatego.~
@4863 = ~Ciekawa, ³zawa historyjka, m³ody Akilu. Dziêkujê ci za darmow¹ rozrywkê. Na bis skrócê ciê o g³owê.~
@4864 = ~Rozumiem. Gdzie dowód na propozycjê ksiêcia?~
@4865 = ~W archiwum miejskim w Calimporcie. Widzia³em ten dokument. Tutaj mam kopiê. Jak widzisz, jej prawdziwoœæ jest potwierdzona podpisem urzêdnika. Zanim podejmiesz ostateczn¹ decyzjê, jeszcze jedna sprawa. Pamiêtasz, jak wspomina³em o jeŸdŸcu? Dziwnym zbiegiem okolicznoœci przebywa teraz w Wodnym Brzegu i czeka na wyruszenie kolejnej karawany na po³udnie. Ma na imiê Rimon. Rozpozna³bym go wszêdzie i mia³em zamiar zapoznaæ jego brzuch z moim no¿em. Jeœli zdo³asz wywabiæ go z tawerny, chêtnie zamieniê z nim kilka s³ów. Mo¿e spróbujemy tego dokonaæ po zapadniêciu zmroku?~
@4866 = ~Ciekawa, ³zawa historyjka, m³ody Akilu. Dziêkujê za darmow¹ rozrywkê. Niestety ci nie wierzê.~
@4867 = ~Myœlê, ¿e mówisz prawdê. O zmroku zatem, przy zbiorniku na wodê.~
@4868 = ~Em... Potrafisz rzucaæ zaklêcie unieruchomienia, prawda?~
@4869 = ~Mogê przygotowaæ jedno w razie potrzeby. Nie mówi³eœ powa¿nie o ognistych mrówkach, co?~
@4870 = ~Niestety nie jestem magiem. Nie mówi³eœ powa¿nie o ognistych mrówkach, co?~
@4871 = ~Widzia³em coœ takiego na w³asne oczy. Nieprzyjemny widok. Nie, nie zrobi³bym tego. Nie jestem nawet pewien, czy potrafi³bym go zabiæ. Jestem kupcem, nie najemnikiem.~
@4872 = ~Chyba ju¿ czas zamieniæ kilka s³ów z Levonem. Spotkajmy siê w sklepie w jego posiad³oœci, kiedy bêdziesz gotowy.~

//*************************************************************************
// Rimon
@4900 = ~Czego chcesz?~
@4901 = ~S¹dz¹c po twoim wygl¹dzie, przypuszczam, ¿e jesteœ Rimon.~
@4902 = ~Co z tego?~
@4903 = ~Pewien twój przyjaciel chcia³by z tob¹ zamieniæ kilka s³ów.~
@4904 = ~Nie widzê ¿adnego przyjaciela. Gdzie on jest?~
@4905 = ~Na zewn¹trz, przy zbiorniku z wod¹.~
@4906 = ~Dlaczego nie przyjdzie tutaj? Nogi odmówi³y mu pos³uszeñstwa?~
@4907 = ~Mówi, ¿e kilka dni temu mia³ zatarg z Tahirem i nie mo¿e siê tu pokazywaæ. Chodzi o jakieœ pijañstwo.~
@4908 = ~Hmm. To mo¿e byæ ka¿dy. Mimo to nie zaszkodzi sprawdziæ.~
@4909 = ~TY!!! Ale ty powinieneœ byæ martwy! Umar³eœ na tym bagnie, widzia³em ciê le¿¹cego twarz¹ w wodzie!~
@4910 = ~S³uchaj, to nie by³o nic osobistego. Zap³acono nam za wykonanie roboty i tyle.~
@4911 = ~A wiêc takie masz do tego podejœcie? Zabijanie to praca jak ka¿da inna?~
@4912 = ~Brzmi jak ³atwa, dobrze p³atna robota.~
@4913 = ~Nie, nie chcia³em, ¿eby to tak zabrzmia³o. S³owo.~
@4914 = ~Wiêc co chcia³eœ przez to powiedzieæ? Przyzna³eœ, ¿e Levon zap³aci³ ci za zabójstwo Akila. Co nas powstrzymuje przed odp³aceniem ci siê tym samym?~
@4915 = ~Hê? C-co?~
@4916 = ~Niewa¿ne. Pomimo moich s³ów istniej¹ rzeczy, których siê nigdy nie podejmê. Jednak co powstrzyma mnie i Akila przed odp³aceniem ci piêknym za nadobne? Przyzna³eœ, ¿e Levon zap³aci³ ci za zabójstwo.~
@4917 = ~Zale¿a³o mu tylko na towarze, który przewozi³ Akil. Mówi³, ¿e zosta³ mu skradziony i obieca³ sut¹ nagrodê za jego zwrot.~
@4918 = ~Doprawdy? Akilu, oto dowód, którego pragn¹³eœ, prosto z ust niedosz³ego mordercy. Co z nim teraz zrobimy?~
@4919 = ~Nie zabijaj mnie, b³agam!!!~
@4920 = ~Idê ju¿, idê!!!~
@4921 = ~Nie mam takiego zamiaru. Wydosta³em siê z tego cuchn¹cego bagna i docz³apa³em tutaj tylko po to, ¿eby zostaæ zrujnowanym przez tego t³ustego, g³odnego w³adzy kupca. Teraz pomo¿esz mi siê na nim zemœciæ.~
@4922 = ~Chyba zapoznam jego brzuch z moim no¿em... powoli. Bardzo powoli. Najpierw jednak stêpiê nó¿.~
@4923 = ~Nie wierzê, ¿e w³aœnie to powiedzia³eœ, <CHARNAME>. Proszê, wyprowadŸ mnie z b³êdu.~ ~Nie wierzê, ¿e w³aœnie to powiedzia³aœ, <CHARNAME>. Proszê, wyprowadŸ mnie z b³êdu.~
@4924 = ~Prosisz o to po tym, jak przebi³eœ mnie mieczem? Powiem ci, co z tob¹ zrobiê: zabiorê ciê zwi¹zanego na pustyniê, rzucê obok gniazda ognistych mrówek i bêdê ciê powoli obdziera³ ze skóry, tak ¿eby twoja krew zwabi³a owady.~
@4925 = ~Zostawiê ci tyle wody, ¿ebyœ nie umar³ z pragnienia i zabezpieczê przed mrówkami twoje uszy, oczy i nozdrza, bo chcê, ¿eby ciê ogryz³y a¿ do koœci. I bêdê na ciebie patrzy³, napawaj¹c siê ka¿dym ugryzieniem.~
@4926 = ~Dam ci jednak fory. Masz dziesiêæ minut na op³acenie Tahira i wyniesienie siê z Imradim. Gdybym by³ tob¹, zacz¹³bym biec, bo kiedy twój czas minie, <CHARNAME> rzuci na ciebie zaklêcie parali¿u.~

//*************************************************************************
// Levon
@4950 = ~Witaj ponownie! I jak? Uda³o ci siê znaleŸæ Akila?~
@4951 = ~Tak. Nie ¿yje i wiêkszoœæ jego bandziorów te¿.~
@4952 = ~Oczywiœcie, ¿e tak! Masz mnie za g³upca?~ ~Oczywiœcie, ¿e tak! Masz mnie za g³upi¹?~
@4953 = ~Jeszcze nie.~
@4954 = ~Znakomicie, znakomicie. Pewnie chcesz swoj¹ nagrodê? Proszê bardzo. Dziêkujê ci za pomoc. Ca³e Imradim ci dziêkuje.~
@4955 = ~Akil! Jak¿e siê cieszê, ¿e ciê widzê! I twojego przyjaciela te¿.~ ~Akil! Jak¿e siê cieszê, ¿e ciê widzê! I twoj¹ przyjació³kê te¿.~
@4956 = ~Cieszysz siê? Czy¿by?~
@4957 = ~Daj spokój, Akilu, to by³y tylko interesy. Naprawdê s¹dzi³eœ, ¿e tak po prostu pogodzi³bym siê z utrat¹ b³êkitnych diamentów i nic z tym nie zrobi³?~
@4958 = ~Pos³uchaj, ju¿ to przerabialiœmy. Nie wys³a³em za tob¹ bandytów. Sk¹d móg³bym wiedzieæ, gdzie bêdziesz?~
@4959 = ~Jeden z twoich pracowników by³ bardziej rozmowny od innych. Pope³ni³ te¿ g³upi b³¹d, pojawiaj¹c siê w tym mieœcie. Akil i ja zamieniliœmy z nim przed chwil¹ kilka s³ów. Mia³ do powiedzenia bardzo interesuj¹ce rzeczy. Nazywa siê Rimon. Mówi ci to coœ?~
@4960 = ~Nigdy o nim nie s³ysza³em.~
@4961 = ~K³amca. Rimon powiedzia³, ¿e zaplanowa³eœ atak na Akila, ¿eby ukraœæ b³êkitne diamenty. Rimon w tej chwili w poœpiechu opuszcza Imradim, ¿eby unikn¹æ rzucenia go na po¿arcie ognistym mrówkom, ale odnalezienie go nie bêdzie trudne. Masz dwie mo¿liwoœci, Levonie: zostaniesz publicznie zhañbiony przez Rimona albo zwrócisz Akilowi to, co mu zrabowa³eœ. Szkoda, ¿e nie mo¿emy do tej listy dopisaæ Aaliyah.~
@4962 = ~A jeœli nie zgodzê siê na ¿adn¹ z tych propozycji? Co wtedy? I tak nic nie mo¿ecie mi zrobiæ. Zreszt¹ do niczego siê nie przyznajê.~
@4963 = ~Nawet do tych 2000 sztuk z³ota, które zaoferowa³eœ mi za g³owê Akila? To by³a zbyt wysoka cena. Gdybyœ zaproponowa³, powiedzmy, 200 sztuk z³ota, byæ mo¿e zabi³bym Akila i jego bandytów bez zbytniego zastanowienia. Skoro jednak jest tak, jak jest, pomyœl o hañbie, jak¹ œci¹gniesz na sw¹ rodzinê.~ ~Nawet do tych 2000 sztuk z³ota, które zaoferowa³eœ mi za g³owê Akila? To by³a zbyt wysoka cena. Gdybyœ zaproponowa³, powiedzmy, 200 sztuk z³ota, byæ mo¿e zabi³abym Akila i jego bandytów bez zbytniego zastanowienia. Skoro jednak jest tak, jak jest, pomyœl o hañbie, jak¹ œci¹gniesz na sw¹ rodzinê.~
@4964 = ~Có¿, pozostaj¹ jeszcze ogniste mrówki...~
@4965 = ~Nie zrobisz tego!~
@4966 = ~Zastanów siê dobrze przed podjêciem decyzji, Levonie. Mamy Rimona, mamy twój kontrakt ze mn¹ i s³owo Akila, wszystko to tylko przeciwko twojemu s³owu. Ksi¹¿ê nie bêdzie zadowolony, kiedy siê dowie, ¿e jego teœæ jest podejrzany o zlecenie morderstwa.~
@4967 = ~Zrobi³bym to z przyjemnoœci¹. Nie lubiê takich k³amliwych ropuch jak ty.~ ~Zrobi³abym to z przyjemnoœci¹. Nie lubiê takich k³amliwych ropuch jak ty.~
@4968 = ~To szanta¿! Grozisz mi œmierci¹!~
@4969 = ~Ty posun¹³eœ siê w stosunku do Akila dalej ni¿ do gróŸb. Co wiêc wybierasz? Wstyd czy zadoœæuczynienie?~
@4970 = ~Ani jedno, ani drugie!! Stra¿e!! Aresztowaæ intruzów!~
@4971 = ~Nie mo¿esz niczego udowodniæ!~
@4972 = ~Niech tak bêdzie. Akilu, poprosimy o audiencjê u ksiêcia i przedstawimy mu nasze dowody. Bêdzie trzeba dogoniæ Rimona, zanim odjedzie za daleko. Mam nadziejê, ¿e nie wystraszy³ siê a¿ tak bardzo tych ognistych mrówek.~
@4973 = ~NIE!! Zrujnujecie mnie!~
@4974 = ~Tym lepiej. Mo¿e uczyni to z ciebie na powrót uczciwego kupca. Zwrócisz wszystko, co odebra³eœ Akilowi, do ostatniego miedziaka i do tego dorzucisz odsetki.~
@4975 = ~Bandyci? W moim domu?~
@4976 = ~Tak, nie zapominaj o bandytach, Levonie. Zamieszkaj¹ tutaj, dopóki nie sp³acisz ca³ej nale¿noœci.~
@4977 = ~Obyœ zgni³ w Otch³ani!~ ~Obyœ zgni³a w Otch³ani!~
@4978 = ~Zapewnie tak siê stanie, Levonie. Jeœli jednak Akil nie doniesie mi, ¿e d³ug zosta³ przez ciebie sp³acony, z³o¿ê wizytê ksiêciu. Zaopatrzê siê w pisemne zeznanie Rimona, co zreszt¹ prawdopodobnie ocali mu ¿ycie. ¯egnaj, Levonie – i lepiej niech ¿ebyœ nie dosta³ przypadkowego zaniku pamiêci.~
@4979 = ~Dzieñ dobry! Przybyliœcie do domu Levona, by pohandlowaæ?~
@4980 = ~Pohandlowaæ? Co tu sprzedajesz?~
@4981 = ~Co to za miejsce?~
@4982 = ~Nie.~
@4983 = ~Jestem Levon, handlarz klejnotami, a to mój dom handlowy. Kupujê i sprzedajê wszelkiego rodzaju klejnoty z ca³ego Calimshanu i okolicznych krajów. PodejdŸ i spójrz na te wspania³e rubiny. Przyby³y dzisiaj z Almraiven, a jutro odjad¹ do Calimportu.~
@4984 = ~Nie masz problemów z rabusiami napadaj¹cymi na karawany?~
@4985 = ~Trzymaj tego szczura z dala od moich klejnotów!~
@4986 = ~Skoro tak mówisz... Fuj!~
@4987 = ~Panienko, proszê od³o¿yæ ten rubin. S¹ dok³adnie policzone, a tylko ty ich dotykasz.~
@4988 = ~Nic takiego nie sugerowa³em, panienko. Wybacz, jeœli ciê urazi³em.~
@4989 = ~Nie nazwa³bym ich œwiecide³kami, m³oda damo. Ten pojedynczy klejnot ma wartoœæ 3200 sztuk z³ota.~
@4990 = ~To prawda, ¿e niewiele osób mo¿e sobie pozwoliæ na zakup takiego klejnotu, m³oda damo, ale zwróæ uwagê na jego nieskazitelnoœæ!~
@4991 = ~Nalio, b¹dŸ cicho. To nie jest Athkatla, a ty pochodzisz z rodu d'Arnise, czy ci siê to podoba, czy nie.~
@4992 = ~D'Arnise, tak? Jeden z rodów szlacheckich Amnu, jeœli dobrze pamiêtam. Zawêdrowa³aœ daleko na po³udnie od domu.~
@4993 = ~Tak jak my wszyscy.~
@4994 = ~To nie twoja sprawa.~
@4995 = ~Tak, oczywiœcie.~
@4996 = ~Czasem siê tak zdarza, ale wiêkszoœæ karawan jest dobrze chroniona. Jest jednak pewien bandyta, który ostatnio bywa³ niezwykle k³opotliwy i najwyraŸniej obra³ sobie za cel tylko moje karawany. Uda³o mi siê ustaliæ jego imiê i prawdopodobn¹ kryjówkê. Mia³bym dla ciebie niewielkie zadanie, jeœli ciê to interesuje.~
@4997 = ~Byæ mo¿e, byæ mo¿e...~
@4998 = ~Nie, dziêkujê. Nie pracujê w ten sposób.~
@4999 = ~Hmm. Szkoda. W takim razie ¿yczê dobrego dnia, przyjacielu. Jestem cz³owiekiem zapracowanym i muszê przygotowaæ te rubiny na jutrzejsz¹ podró¿.~ ~Hmm. Szkoda. W takim razie ¿yczê dobrego dnia, przyjació³ko. Jestem cz³owiekiem zapracowanym i muszê przygotowaæ te rubiny na jutrzejsz¹ podró¿.~
@5000 = ~ChodŸmy na górê i porozmawiajmy na osobnoœci. Sklep nie jest doœæ ustronnym miejscem na tak¹ rozmowê.~
@5001 = ~Tutaj jest przyjemniej, nieprawda¿? Jak ju¿ mówi³em, hmm...?~
@5002 = ~Jestem <CHARNAME>.~
@5003 = ~Lepiej bêdzie, jeœli nie bêdziemy u¿ywaæ imion.~
@5004 = ~Zgoda. Bandyci, o których mówi³em, zaszyli siê w jaskini le¿¹cej niedaleko na po³udnie od mojej posiad³oœci. Ich przywódc¹ jest cz³owiek o imieniu Akil, kiedyœ szanowany obywatel Imradim, który niestety zszed³ na z³¹ drogê. Napada nie tylko na mnie, ale na wszystkich, którzy tamtêdy przeje¿d¿aj¹.~
@5005 = ~Niedawno zaatakowa³ o jedn¹ karawanê za du¿o i zabi³ dwóch moich stra¿ników. Dobrzy ludzie z Imradim zebrali 2000 sztuk z³ota na nagrodê za unieszkodliwienie tego przestêpcy. Nie obchodzi nas, czy zostanie schwytany, czy zabity. Zale¿y nam na zatrzymaniu napadów.~
@5006 = ~2000 sztuk z³ota, powiadasz? Hmm.~
@5007 = ~To spora suma za g³owê pospolitego bandyty.~
@5008 = ~Zbyt dobrze mu idzie. Zaoferowalibyœmy nawet wiêcej, lecz tylko tyle zdo³aliœmy zebraæ.~
@5009 = ~Przyjmê to zadanie. Jaskinia jest na po³udnie st¹d, tak? Wrócê do ciebie, kiedy z nim skoñczê.~
@5010 = ~Chyba zrezygnujê z tej oferty. Jeœli jest tak skuteczny, moje ¿ycie jest dla mnie warte wiêcej ni¿ 2000 sztuk z³ota. Dobrego dnia, Levonie.~
@5011 = ~Jak sobie ¿yczysz. A teraz bardzo ciê przepraszam, ale mam interes do prowadzenia.~
@5012 = ~A ty, Levonie, jesteœ k³amc¹. Sprawia ci przyjemnoœæ patrzenie na moj¹ nêdzê, chocia¿ wola³byœ ogl¹daæ mojego trupa.~
@5013 = ~To dlaczego nas³a³eœ na mnie bandytów?~
@5014 = ~Nie wiem, jak ci dziêkowaæ za pomoc, <CHARNAME>. To nie przywróci mi Aaliyah, ale pozwoli przynajmniej zacz¹æ wszystko od nowa. Bêdê móg³ nawet zatrudniæ kilku moich bandytów do uczciwej pracy.~
@5015 = ~Ooo, Boo mówi: piêkne, b³yszcz¹ce przedmioty. Boo chce je schowaæ do swoich kieszeni!~
@5016 = ~Boo nie jest szczurem! Boo jest miniaturowym Wielkim Kosmicznym Chomikiem. Spójrz, jak trzês¹ mu siê policzki! Urazi³eœ go!~
@5017 = ~S¹ naprawdê piêkne, <CHARNAME>. Nawet ja nie jestem obojêtna na ich uroki!~
@5018 = ~Jestem Harfiarzem, kupcze! Nie kradnê!~
@5019 = ~Wiêc to ty jesteœ Levon, handlarz klejnotami. W Athkatli mo¿na nabyæ twoje œwiecide³ka.~
@5020 = ~3200 sztuk z³ota! Pomyœl tylko, ilu ludzi mo¿na by wy¿ywiæ przez rok za tê sumê!~

//*************************************************************************
// Akila
@5050 = ~Co ty tu robisz? Czekaj, niech zgadnê. Aiesha wys³a³a ciê po kwaœn¹ wodê.~
@5051 = ~Kim jest Aiesha?~
@5052 = ~Zgadza siê. Czym jest ta „kwaœna woda”?~
@5053 = ~Co wiesz o Oku Tygrysa?~
@5054 = ~Zajmij siê w³asnymi sprawami, jêdzo.~
@5055 = ~O to musisz zapytaæ Aieshê.~
@5056 = ~Czym jest ta „kwaœna woda”?~
@5057 = ~Po prostu odpowiedz na pytanie, jêdzo.~
@5058 = ~„Jêdzo”, tak? Gdyby któryœ z moich synów tak do mnie powiedzia³, poczu³by moj¹ rêkê. Byæ mo¿e jednak w krainach barbarzyñców zwracacie siê do siebie w ten sposób. OdejdŸ, Nieuprzejmy. Nie jesteœ tu mile widziany.~ ~„Jêdzo”, tak? Gdyby któryœ z moich synów tak do mnie powiedzia³, poczu³by moj¹ rêkê. Byæ mo¿e jednak w krainach barbarzyñców zwracacie siê do siebie w ten sposób. OdejdŸ, Nieuprzejma. Nie jesteœ tu mile widziana.~
@5059 = ~Och, jeszcze jej nie spotka³eœ. Aiesha to m¹dra kobieta. Jest miejscow¹ szamank¹ i uzdrowicielk¹. Wie o wszystkim, co dzieje siê w Imradim i okolicach.~ ~Och, jeszcze jej nie spotka³aœ. Aiesha to m¹dra kobieta. Jest miejscow¹ szamank¹ i uzdrowicielk¹. Wie o wszystkim, co dzieje siê w Imradim i okolicach.~
@5060 = ~Gdzie mogê znaleŸæ t¹ Aieshê?~
@5061 = ~„M¹dra” kobieta? Jeszcze nigdy takiej nie spotka³em. By³o natomiast wiele g³upich.~ ~„M¹dra” kobieta? Jeszcze nigdy takiej nie spotka³am. By³o natomiast wiele g³upich.~
@5062 = ~W du¿ym domu w œrodku miasta.~
@5063 = ~Woda, która daje Imradim ¿ycie, tu¿ przy tym domu podchodzi blisko powierzchni. Mo¿na j¹ dojrzeæ na dnie dziury w miejscu, w którym wyp³uka³a piasek. Nie nadaje siê jednak do picia – coœ j¹ zatruwa i nadaje jej nieprzyjemny smak. To nasza kwaœna woda.~
@5064 = ~Ach tak. Dziêkujê.~
@5065 = ~Ach tak. Dziêkujê. W takim razie zaniosê trochê tej kwaœniej wody Aieshy.~
@5066 = ~Jesteœ naprawdê têpy, dzikusie. Jednym zdaniem obrazi³eœ pó³ miasta.~ ~Jesteœ naprawdê têpa, dzikusko. Jednym zdaniem obrazi³aœ pó³ miasta.~
@5067 = ~Osobiœcie uwa¿am, ¿e to by³o ca³kiem zabawne.~
@5069 = ~Gdyby któryœ z moich synów tak do mnie powiedzia³, poczu³by moj¹ rêkê. Byæ mo¿e jednak w krainach barbarzyñców zwracacie siê do siebie w ten sposób. OdejdŸ, nieuprzejmy. Nie jesteœ tu mile widziany.~ ~Gdyby któryœ z moich synów tak do mnie powiedzia³, poczu³by moj¹ rêkê. Byæ mo¿e jednak w krainach barbarzyñców zwracacie siê do siebie w ten sposób. OdejdŸ, nieuprzejma. Nie jesteœ tu mile widziana.~
@5070 = ~Dobrego dnia, przybyszu z pó³nocy.~ ~Dobrego dnia, przybyszko z pó³nocy.~

//*************************************************************************
// Stra¿nicy Warowni Cerendora
@6000 = ~Uwa¿aj tam.~
@6001 = ~Cicho! Naprawdê nie chcesz przyci¹gn¹æ ich uwagi.~
@6002 = ~Skopaliœmy im ty³ki, prawda? To poka¿e wszystkim, ¿e lepiej z nami nie zadzieraæ!~
@6003 = ~Proszê patrzeæ pod nogi. Te pod³ogi nie s¹ zbyt równe.~
@6004 = ~¯o³nierze na dole, wy¿ej goœcie, szlachta na samej górze. Nie jest to szczyt luksusu, ale taki podzia³ w warowni siê sprawdza.~
@6005 = ~Nie sprawiaj k³opotów. Nie spodoba³yby ci siê... konsekwencje.~
@6006 = ~Warownia Cerendora... na koñcu ostatniego odludzia i rzekomo nie do zdobycia. Ha! A teraz... spójrz.~
@6007 = ~Warownia Cerendora... zwykle to spokojny posterunek, ale nie teraz!~
@6008 = ~Nie s¹dzi³em, ¿e do¿yjê dnia, w którym warownia zostanie zdobyta bez walki.~
@6009 = ~Nazywali siebie „Czerwonymi Gwardzistami”... Ho, ho! Jak przysz³o do prawdziwej walki, to raczej Czerwone Maminsynki!~
@6010 = ~Uwa¿aj na s³owa. Ci Czerwoni Magowie s¹ ma³o wyrozumiali.~
@6011 = ~To by³o genialne, jak wykoñczyliœcie tych Czerwonych Magów! Thayskie bêkarty.~

//*************************************************************************
// Czerwoni Gwardziœci
@6020 = ~Uwa¿aj na siebie. Nie chcesz chyba zdenerwowaæ innych goœci?~
@6021 = ~Odwal siê.~
@6022 = ~Nie mam ci nic do powiedzenia. A teraz odczep siê.~
@6023 = ~Mi³e miejsce. Bywa³em ju¿ w gorszych.~
@6024 = ~Wynocha st¹d. Nie bêdziesz siê tu krêciæ ca³y dzieñ.~
@6025 = ~S³uchaj, mam ciekawsze rzeczy do roboty ni¿ pró¿ne rozmowy z tob¹. IdŸ, poszukaj sobie w³asnych zabawek.~

//*************************************************************************
// Dziennik Labraida
@6050 = ~Otwierasz rêcznie napisan¹ ksiêgê. Na stronie tytu³owej widzisz s³owa: „Dziennik rybaka Labraida Wolnosieci”. Co robisz?~
@6051 = ~Czytam ksi¹¿kê.~
@6052 = ~Zamykam ksi¹¿kê.~
@6053 = ~Któr¹ stronê chcesz przeczytaæ?~
@6054 = ~Czytam pierwsz¹ stronê.~
@6055 = ~Czytam drug¹ stronê.~
@6056 = ~Czytam trzeci¹ stronê.~
@6057 = ~Czytam czwart¹ stronê.~
@6058 = ~Czytam pi¹t¹ stronê.~
@6059 = ~Czytam ostatni¹ stronê.~
@6060 = ~Kiedy zaczê³y siê te wszystkie problemy? Jestem pewien, ¿e od przybycia tego piekielnego Czerwonego Maga, który postanowi³ tu zostaæ. Czego on tu w ogóle chce? Pentyrch to spokojna wioska, nie chcemy tutaj ludzi jego pokroju. Nie zna siê ani na rybo³ówstwie ani na rolnictwie i na pewno coœ kombinuje. Najgorsze jest to, ¿e wydaje siê doœæ mi³y, ale nie ufam mu ani trochê.~
@6061 = ~Kontynuuj.~
@6062 = ~Wczoraj w nocy us³ysza³em jakiœ szelest za domem. Myœla³em, ¿e to jeleñ, ale gdy wyszed³em na zewn¹trz, zobaczy³em wielk¹, cz³ekokszta³tn¹ postaæ znikaj¹c¹ w ciemnoœci. By³a zbyt pokraczna jak na cz³owieka, ale i nie doœæ du¿a jak na trolla. Zreszt¹ sk¹d mia³by siê tu wzi¹æ troll? Wydawa³o mi siê te¿, ¿e zobaczy³em tego przeklêtego czarodzieja czaj¹cego siê w krzakach za magazynem.~
@6063 = ~Jestem pewny, ¿e dziœ wieczorem widzia³em ducha Artana Sporo³owa. W takiej rybackiej wiosce jak Pentyrch to nic nadzwyczajnego spotkaæ duchy topielców. Ale Sporo³ów umar³ we w³asnym ³ó¿ku jakieœ dziesiêæ lat temu. To nie jest normalne, ¿eby po spokojnej œmierci wstaæ i chodziæ, prawda? Co siê tu dzieje?~
@6064 = ~Ponownie zobaczy³em tê cz³ekokszta³tn¹ kreaturê. Czy to ma zwi¹zek ze znikniêciem Gadiona Szybkowodnego? Dziœ rano wdowa po Szybkowodnym swoim lamentem zbudzi³a ca³¹ okolicê; kiedy poszliœmy tam, aby sprawdziæ, co siê sta³o, zobaczyliœmy ³ó¿ko Gadiona pokryte mnóstwem krwi, ale samego cia³a nie by³o. Canna Bezrybia na sam ten widok zwymiotowa³a na ulicy.~
@6065 = ~Ghule! Co tu robi¹ ghule? I na pewno widzia³em te¿ ghasta! Kolejne trzy osoby zniknê³y w przeci¹gu ostatnich dwóch dni – Donaut Bezrybi oraz bracia Selevan i Conomor Pe³nosieæ. Matka braci z rozpaczy postrada³a zmys³y.~
@6066 = ~Teraz co i rusz po zachodzie s³oñca pojawiaj¹ siê nieumarli. Przysiêgam na Mystrê, jeden z nich mia³ twarz Gadiona Szybkowodnego! Zaginiêcia i nieumar³ych musi coœ ³¹czyæ, tylko co??!!~
@6067 = ~To musi byæ ten po trzykroæ przeklêty czarodziej. To MUSI byæ ten po trzykroæ przeklêty czarodziej. Widzia³em, jak skrada³ siê po zmroku, a nieumarli zupe³nie go ignorowali. Co gorsza – latarnia pogr¹¿y³a siê w ciemnoœci. Przez ostatni tydzieñ Daalin Jasny nie zapali³ ognia po zmierzchu – nie jestem nawet pewny, czy on jeszcze ¿yje. Nawet nie chcê myœleæ, ile statków zatopi siê na K³ach Grelthota w ujœciu rzeki Isthlwyn. Ostatni raz widzia³em go z trzy dni temu, gdy bieg³ do sklepu z narzêdziami zaraz nad jaskini¹ rzeczn¹.~
@6068 = ~Demon! W latarni jest przeklêty demon, z piek³a rodem!! Tego ju¿ za wiele – wyje¿d¿amy, jak tylko wzejdzie s³oñce. Po³owa wioski ju¿ zniknê³a, nie zamierzamy byæ ostatnimi, którzy odejd¹. Zabijê tego zafajdanego czarodzieja, je¿eli tylko wpadnie w moje rêce.~
@6069 = ~Zamykasz dziennik i odk³adasz go.~

//*************************************************************************
// Hrabina Wultheof
@6080 = ~To by by³o na tyle. Dziêkujê ci za pomoc, <CHARNAME>.~ 
@6081 = ~Znów ty. Ju¿ wiesz, jak siê nazywasz?~
@6082 = ~Jestem <CHARNAME> z Candlekeep, proszê pani.~ 
@6083 = ~Lothrard z Purskal.~
@6084 = ~Lothrard z Purskal... Z pewnoœci¹ nie takie imiê s³ysza³am z ust twoich towarzyszy, gdy rozmawialiœcie miêdzy sob¹. Choæ w³aœciwie nigdy nie us³ysza³am go doœæ wyraŸnie. Jaka jest twoja ostateczna odpowiedŸ?~ 
@6085 = ~Jestem Salran z Athkatli, proszê pani.~
@6086 = ~Nie, to te¿ nie brzmi jak nale¿y – pachnie mi kolejnym k³amstwem. Nie mam zamiaru d³u¿ej z tob¹ rozmawiaæ.~
@6087 = ~Dopiero co przyby³eœ do warowni, prawda? Wybacz – nie dos³ysza³am twojego imienia.~ ~Dopiero co przyby³aœ do warowni, prawda? Wybacz – nie dos³ysza³am twojego imienia.~ 
@6088 = ~Nie musisz go znaæ. Im mniej ludzi wie, kim jestem – tym dla mnie bezpieczniej.~
@6089 = ~Och. Wiêc jak mam siê do ciebie zwracaæ?~ 
@6090 = ~Ja wiem, do kogo siê zwracasz i to wystarczy. Po prostu mów.~
@6091 = ~„Nowy Goœæ Cerendoru”?~
@6092 = ~Tak szczerze mówi¹c, to jestem <CHARNAME> z Candlekeep, proszê pani. Ale równie szczerze powiedzia³em wczeœniej – im mniej osób wie, kim jestem, tym dla mnie bezpieczniej.~ ~Tak szczerze mówi¹c, to jestem <CHARNAME> z Candlekeep, proszê pani. Ale równie szczerze powiedzia³am wczeœniej – im mniej osób wie, kim jestem, tym dla mnie bezpieczniej.~ 
@6093 = ~To niedorzeczne. OdejdŸ i wróæ, gdy bêdziesz móg³ udzieliæ lepszej odpowiedzi.~ ~To niedorzeczne. OdejdŸ i wróæ, gdy bêdziesz mog³a udzieliæ lepszej odpowiedzi.~
@6094 = ~Hmm. Nie zwyk³am rozmawiaæ z bezimiennym plebsem. Wcale a wcale. Nie mam zamiaru zmieniaæ swoich manier – wróæ do mnie, gdy bêdziesz móg³ porz¹dnie siê przedstawiæ.~ ~Hmm. Nie zwyk³am rozmawiaæ z bezimiennym plebsem. Wcale a wcale. Nie mam zamiaru zmieniaæ swoich manier – wróæ do mnie, gdy bêdziesz mog³a porz¹dnie siê przedstawiæ.~ 
@6095 = ~Candlekeep! Tak dawno ju¿ tam nie by³am. Jesteœ uchodŸc¹? Mo¿e uciekasz przed prawem? Albo przed mnichami?~ ~Candlekeep! Tak dawno ju¿ tam nie by³am. Jesteœ uchodŸczyni¹? Mo¿e uciekasz przed prawem? Albo przed mnichami?~
@6096 = ~UchodŸca, co? Mo¿na tak powiedzieæ. Na pewno nie uciekam przed prawem, mo¿na wrêcz powiedzieæ, ¿e stojê po jego stronie.~ ~UchodŸczyni, co? Mo¿na tak powiedzieæ. Na pewno nie uciekam przed prawem, mo¿na wrêcz powiedzieæ, ¿e stojê po jego stronie.~
@6097 = ~Uciekam przed mnichami? Och, pani – gdybyœ wiedzia³a, jak wiele bym odda³, ¿eby móc tam wróciæ. Niestety bramy Candlekeep s¹ dla mnie tak samo zamkniête jak dla ka¿dego innego podró¿nika.~ ~Uciekam przed mnichami? Och, pani – gdybyœ wiedzia³a, jak wiele bym odda³a, ¿eby móc tam wróciæ. Niestety bramy Candlekeep s¹ dla mnie tak samo zamkniête jak dla ka¿dego innego podró¿nika.~
@6098 = ~Candlekeep! Dlaczego od razu tak nie mówi³eœ?~ ~Candlekeep! Dlaczego od razu tak nie mówi³aœ?~ 
@6099 = ~To zbyt d³uga historia, pani i na pewno nie masz teraz doœæ czasu, ¿eby jej wys³uchaæ.~
@6100 = ~Candlekeep! Tak dawno ju¿ tam nie by³am. To wci¹¿ ta sama stara, zatêch³a biblioteka pe³na mnichów, prawda? Czy G³osy nadal dzieñ w dzieñ wyœpiewuj¹ Przepowiedniê Alaunda?~ 
@6101 = ~Nic siê nie zmienia w Candlekeep, pani. Œwiat móg³by siê skoñczyæ, a Candlekeep bêdzie staæ dalej.~
@6102 = ~To wci¹¿ tak samo nudna dziura jak j¹ zapamiêta³aœ, pani. Nic siê tam nie zmienia.~
@6103 = ~<CHARNAME> z Candlekeep, no dobrze. Jako ¿e nasi niechciani czerwoni goœcie nie znaj¹ ciê za dobrze, mo¿e wyœwiadczy³byœ mi ma³¹ przys³ugê. Kucharka twierdzi, ¿e co noc ktoœ wykrada jedzenie z kuchni. Nie jest to bardzo powa¿na sprawa, ale chcia³abym, byœ rzuci³ na to okiem, jeœli znajdziesz czas.~ ~<CHARNAME> z Candlekeep, no dobrze. Jako ¿e nasi niechciani czerwoni goœcie nie znaj¹ ciê za dobrze, mo¿e wyœwiadczy³abyœ mi ma³¹ przys³ugê. Kucharka twierdzi, ¿e co noc ktoœ wykrada jedzenie z kuchni. Nie jest to bardzo powa¿na sprawa, ale chcia³abym, byœ rzuci³a na to okiem, jeœli znajdziesz czas.~
@6104 = ~Oczywiœcie, pani. Zrobiê to dla ciebie.~
@6105 = ~Nie mam teraz na to czasu. Mo¿e innym razem.~
@6106 = ~Skoro tak uwa¿asz. Có¿, <CHARNAME>; mi³ego pobytu w Warowni Cerendora.~
@6107 = ~Ach, <CHARNAME>. Czy zmieni³eœ zdanie odnoœnie mojej proœby?~ ~Ach, <CHARNAME>. Czy zmieni³aœ zdanie odnoœnie mojej proœby~
@6108 = ~Tak.~
@6109 = ~Niestety nie, wci¹¿ nie mam czasu.~
@6110 = ~Dobrze. Pomów z kuchark¹. Powinna daæ ci parê wskazówek – o ile twoje uszy przetrwaj¹ spotkanie. Dobra z niej kucharka, ale na innych polach trochê jej brakuje.~
@6111 = ~<CHARNAME>, czy rozmawia³eœ ju¿ z kuchark¹?~ ~<CHARNAME>, czy rozmawia³aœ ju¿ z kuchark¹?~
@6112 = ~Jeszcze nie, pani.~
@6113 = ~Tak, pani.~
@6114 = ~I znalaz³eœ z³odzieja?~ ~I znalaz³aœ z³odzieja?~
@6115 = ~Jeszcze nie, wci¹¿ szukam.~
@6116 = ~Jeszcze nie, pani, ale chyba ju¿ wiem, kto jest z³odziejem.~
@6117 = ~Tak, pani, chyba ju¿ wiem, kto jest z³odziejem.~
@6118 = ~Wiêc?~
@6119 = ~Nie zdo³a³em porz¹dnie go przes³uchaæ, bo uciek³, ale na pewno by³ to gnom.~ ~Nie zdo³a³am porz¹dnie go przes³uchaæ, bo uciek³, ale na pewno by³ to gnom.~
@6120 = ~Gnom! Jak to mo¿liwe?~
@6121 = ~Ukrywa³ siê w pó³nocnej wie¿y, pani. Chcia³am go szczegó³owo wypytaæ, ale znienacka pomkn¹³ do drzwi.~ ~Ukrywa³ siê w pó³nocnej wie¿y, pani. Chcia³em go szczegó³owo wypytaæ, ale znienacka pomkn¹³ do drzwi.~
@6122 = ~No dobrze, <CHARNAME>, miejmy nadziejê, ¿e z³odziej znikn¹³ na dobre i nie pojawi siê wiêcej w kuchni. Dziêkujê ci za pomoc.~
@6123 = ~Pani.~
@6124 = ~Nie, pani, jeszcze nie. Ale wiem, kto jest z³odziejem.~
@6125 = ~Tak, pani i wiem, kto jest z³odziejem.~
@6126 = ~To gnom imieniem Cado.~
@6127 = ~Ukrywa³ siê w pó³nocnej wie¿y. Porozmawialiœmy sobie o tutejszych niechcianych goœciach i o tym, jak uda³o mu siê przetrwaæ. Znasz plotki kr¹¿¹ce o pó³nocnej wie¿y?~
@6128 = ~Masz na myœli ducha? To bzdury. Po prostu nie korzystamy z pó³nocnej wie¿y, bo nie ma takiej potrzeby.~
@6129 = ~M³ody Cado sprytnie wykorzysta³ tê plotkê, aby zniechêciæ bandytów do wejœcia na wie¿ê.~
@6130 = ~Co zrobi³?! Och, nie wierzê! Chcia³abym porozmawiaæ z tym gnomem i bezpoœrednio od niego us³yszeæ tê historiê!~
@6131 = ~Jak siê rozstaliœmy, zmierza³ w³aœnie do kuchni, aby pogodziæ siê z kuchark¹. Ca³kiem kulturalny gnom z tego Cado.~
@6132 = ~A zatem, <CHARNAME>, zagadka rozwi¹zana, a w kuchni bêdzie teraz spokojniej. Dziêkujê ci za pomoc.~

