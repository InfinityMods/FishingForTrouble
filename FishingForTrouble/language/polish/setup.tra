// Stra¿nik wie¿y w Warowni Cerendora
@1430 = ~Czego chcesz?~
@1431 = ~Chcê porozmawiaæ z zarz¹dc¹ karawan.~
@1432 = ~Czemu ciê to interesuje?~
@1433 = ~Zamknij siê i otwieraj bramê.~
@1434 = ~No, no, najpierw odpowiesz na moje pytanie, a potem ja odpowiem tobie, czy mo¿esz wejœæ, czy nie, w zale¿noœci od twoich s³ów.~
@1435 = ~Otwieraj bramê albo nie po¿yjesz dostatecznie d³ugo, ¿eby tego po¿a³owaæ.~
@1436 = ~Kogo mam mu zaanonsowaæ? I o czym chcesz z nim mówiæ?~
@1437 = ~Jestem <CHARNAME> i zmierzam do Athkatli. Interesuje mnie bezpieczna podró¿ w towarzystwie karawany.~
@1438 = ~Ju¿ powiedzia³em poprzedniemu stra¿nikowi!~ ~Ju¿ powiedzia³am poprzedniemu stra¿nikowi!~
@1439 = ~Ha! Proponujê, ¿ebyœ sobie poszed³ i wróci³, kiedy bêdziesz w bardziej uprzejmym nastroju.~ ~Ha! Proponujê, ¿ebyœ sobie posz³a i wróci³a, kiedy bêdziesz w bardziej uprzejmym nastroju.~
@1440 = ~Dobrze ju¿, dobrze! Jestem <CHARNAME> i zmierzam do Athkatli. Interesuje mnie bezpieczna podró¿ w towarzystwie karawany.~
@1441 = ~Powiedz wiêc i mnie!~
@1442 = ~Zapomnij.~
@1443 = ~Zaczekaj, a¿ opuszczê most, i mo¿esz wejœæ.~
@1444 = ~Co? Jak œmiesz! Otwieraj natychmiast tê bramê!~
@1445 = ~A kim¿e ty jesteœ, œliczna ptaszyno?~
@1446 = ~Jestem Nalia D'Arnise, œlepy g³upcze! Otwieraj natychmiast albo ka¿ê odci¹æ ci jaja, ugotowaæ je i ususzyæ na pociski do procy!~
@1447 = ~Nalia...! Na Dziewiêæ Piekie³. Natychmiast, moja pani.~

//*************************************************************************
