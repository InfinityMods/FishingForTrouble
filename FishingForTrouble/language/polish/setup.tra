// Keldrel z Gospody pod Smoczym Kresem
@4650 = ~Co mogê dla ciebie zrobiæ? Chcesz coœ do picia? A mo¿e pokój na noc?~
@4651 = ~Czy wiesz cokolwiek o gnomie, który mieszka w jednym z domów przy pó³nocnym murze?~
@4652 = ~A co masz?~
@4653 = ~W tym momencie niczego nie potrzebujê.~
@4654 = ~Ach, masz na myœli Brana. Niech zgadnê – mia³ w domu lisza.~
@4655 = ~W³aœciwie to dwóch obserwatorów.~
@4656 = ~Taaak... Tak naprawdê to by³ Adag, jego brat. Uzdolniony iluzjonista. Ta dwójka napêdza stracha niemal ka¿demu, kto têdy przechodzi. Nie ma szans, by siê na nich zemœciæ – maj¹ wystarczaj¹co rozumu, by uciec, kiedy zadr¹ z kimœ, kto mo¿e im naprawdê zaszkodziæ.~
@4657 = ~Uch... uciekli, tak?~
@4658 = ~Nie. Adag nie ¿yje. Zabi³em go.~ ~Nie. Adag nie ¿yje. Zabi³am go.~
@4659 = ~Có¿, to siê musia³o w koñcu staæ, wiêc powiem, bym by³ zaskoczony. Tak to jest, gdy ktoœ najpierw dzia³a, a dopiero potem pyta. Mimo to przykro mi, ¿e tak siê sta³o.~
@4660 = ~Mnie równie¿.~
@4661 = ~G³upi æwok. Za takie sztuczki zas³u¿y³ na œmieræ.~
@4662 = ~Coœ siê sta³o, ju¿ siê nie odstanie. A teraz, co mogê podaæ?~
@4663 = ~Co wiesz na temat gnoma o imieniu Bran? Powiedzia³, ¿e jest cieœl¹.~
@4664 = ~Niech zgadnê. Zobaczy³eœ w jego domu lisza.~ ~Niech zgadnê. Zobaczy³aœ w jego domu lisza.~
@4665 = ~Gdy tam by³em, widzia³em jakiegoœ przeklêtego obserwatora. Dwóch obserwatorów. Zaraz... wiesz coœ o tym?~ ~Gdy tam by³am, widzia³am jakiegoœ przeklêtego obserwatora. Dwóch obserwatorów. Zaraz... wiesz coœ o tym?~
@4666 = ~NieŸle ciê nastraszy³, prawda? To jego brat, Adag. Adag jest doœwiadczonym gnomem iluzjonist¹, a ta dwójka przez ostatnie kilka miesiêcy przerazi³a jak Dziewiêæ Piekie³ ka¿dego nieznajomego, który przechodzi³ w pobli¿u.~
@4667 = ~Zabijê tego ma³ego drania!~
@4668 = ~Gnom iluzjonista! Ach... s³owem, wystrychniêto mnie na dudka!~
@4669 = ~Mo¿esz spróbowaæ, ale nie znajdziesz nikogo w domu. Maj¹ wystarczaj¹co rozumu, by uciekaæ, gdzie pieprz roœnie, kiedy zadr¹ z kimœ, kto naprawdê mo¿e im zaszkodziæ. Odpuœæ sobie. A teraz, co mogê podaæ?~
@4670 = ~Ale nie ma sensu wracaæ, by siê mœciæ. Maj¹ wystarczaj¹co rozumu, by uciekaæ, gdzie pieprz roœnie, kiedy zadarli z kimœ, kto naprawdê mo¿e im zaszkodziæ. Odpuœæ sobie i uznaj to za doœwiadczenie. A teraz, co mogê podaæ?~
@4671 = ~Rozmawia³eœ ju¿ z tym gnomim z³odziejaszkiem?~ ~Rozmawia³aœ ju¿ z tym gnomim z³odziejaszkiem?~
@4672 = ~Tak, mówi³ o pijackim zak³adzie pomiêdzy waszymi ojcami, w którym twój ojciec wygra³ gospodê Pod Smoczym Kresem.~
@4673 = ~Och, a wiêc to tak? Tak te¿ myœla³em.~
@4674 = ~Mówi³, ¿e twój ojczunio skorzysta³ z okazji, gdy jego ojciec by³ kompletnie pijany, aby zmusiæ go do zrobienia czegoœ g³upiego, a on nawet po wytrzeŸwieniu nie zmieni³by swego stanowiska. Mówi³ te¿ coœ o wyci¹ganiu ciê ze sterty smoczego ³ajna.~
@4675 = ~Có¿, ten fragment ze smoczym ³ajnem jest prawdziwy, chocia¿ nie jestem z niego dumny. Wracaj¹c do pijackiego zak³adu – ka¿dy opowie ci inn¹ wersjê historii. Obaj byli zalani w pestkê, a nastêpnego dnia mój ojczunio próbowa³ oddaæ mu Budkê Gnoma, ale bêd¹c upartym i przepe³nionym pych¹, Grunard Seltin nie chcia³ jej wzi¹æ. Mimo to zostali przyjació³mi, a gdy gospoda prosperowa³a, Grunard powiedzia³, ¿e utrata jej to najlepsza rzecz jak¹ z ni¹ zrobi³. Nie by³ zbyt szczêœliwy, ¿e nadal nazywa³a siê Budk¹ Gnoma, wiêc mój ojczunio nazwa³ j¹ gospod¹ Pod Smoczym Kresem na czeœæ tamtej szalonej przygody, któr¹ prze¿yliœmy w Górach Burzowych Rogów. Ta przygoda skutecznie zniechêci³a nas do kolejnych.~
@4676 = ~Pamiêtam, ¿e Drosig Seltin zawsze by³ ponurym dzieckiem – nie by³em wiele od niego starszy – ale po tym szybko znikn¹³ z mojego ¿ycia. Dziêkujê ci za potwierdzenie tego, co od dawna podejrzewa³em. Nie chcia³ rozmawiaæ z nikim w okolicy i s¹dzi³em, ¿e tylko obcy mogliby wyci¹gn¹æ z niego ca³¹ historiê. Nie ma wiêc sensu marnowaæ moich pieniêdzy na jeszcze jeden nowy szyld, i naprawdê nie s¹dzê, by stra¿nicy miejscy byli tym zainteresowani.~
@4677 = ~Prawdopodobnie nie.~
@4678 = ~Tak, ale nie chcia³ mi nic powiedzieæ i wyrzuci³ mnie ze swego domu.~
@4679 = ~Wiêc nigdy nie dowiem siê, dlaczego ci¹gle kradnie moje szyldy. Zwa¿ywszy na, ¿e to jedyna gospoda w tej czêœci Athkatli, nie s¹dzê, bym tak naprawdê potrzebowa³ szyldu.~
@4680 = ~Skoro tak mówisz.~
@4681 = ~Ach, có¿ to, nowe twarze. Nowe twarze szybko staj¹ siê starymi przyjació³mi. Co mogê dla ciebie zrobiæ?~
@4682 = ~Po prostu powiedz mi, co sprzedajesz.~
@4683 = ~Jak nazywa siê to miejsce?~
@4684 = ~Przecie¿ to gospoda Pod Smoczym Kresem. Nie widzia³eœ informacji przy drzwiach?~ ~Dlaczego, przecie¿ to Gospoda pod Smoczym Kresem. Nie widzia³aœ informacji przy drzwiach?~
@4685 = ~Nie widzia³em ¿adnej informacji.~ ~Nie widzia³am ¿adnej informacji.~
@4686 = ~¯e co? Co to za nazwa?~
@4687 = ~Jesteœ tak œlepy, jak kwaœne jest piwo z Miedzianego Diademu. Nie ma ¿adnej informacji na œcianie na zewn¹trz.~
@4688 = ~Jeju, ale z ciebie zrzêda!~
@4689 = ~Tak, jestem zrzêd¹, musisz siê z tym pogodziæ.~
@4690 = ~Idealna nazwa, moim zdaniem.~
@4691 = ~Wiêc, zgadujê z nazwy, ¿e by³eœ przynajmniej po czêœci odpowiedzialny za œmieræ smoka?~
@4692 = ~Có¿.... nie do koñca. To nie by³ tak naprawdê smok, tylko wiwerna. Mój ojczunio sta³ przed ni¹ i atakowa³ ³eb; sz³o mu ca³kiem nieŸle, a ja tu¿ przy nim rozpaczliwie próbowa³em zadaæ dobry cios. Nagle mój ojczunio trafi³ j¹ swym mieczem prosto miêdzy œlepia.~
@4693 = ~No i?~
@4694 = ~Wiwerna machnê³a swym ogonem, a ja uskoczy³em, ale musia³a wybraæ akurat ten moment, by wypuœciæ nieprawdopodobnego b¹ka.~
@4695 = ~Ale oczywiœcie wiwerna by³a martwa? Powiedzia³eœ, ¿e twój ojciec dŸgn¹³ j¹ miêdzy œlepia?~
@4696 = ~Mo¿na by rzec, ¿e by³ to swego rodzaju prezent na po¿egnanie. Czu³eœ kiedyœ wiwerniego b¹ka?~ ~Mo¿na by rzec, ¿e by³ to swego rodzaju prezent na po¿egnanie. Czu³aœ kiedyœ wiwerniego b¹ka?~
@4697 = ~Raczej nie mia³em okazji...~ ~Raczej nie mia³am okazji...~
@4698 = ~I nie chcia³byœ mieæ. To gorsze ni¿ wszystkie zgni³e kapusty œwiata zebrane razem do fermentacji i pod³o¿one pod twój nos. Gorsze nawet ni¿ skutki jedzenia rzepowej zupy Jana Jansena.~ ~I nie chcia³abyœ mieæ. To gorsze ni¿ wszystkie zgni³e kapusty œwiata zebrane razem do fermentacji i pod³o¿one pod twój nos. Gorsze nawet ni¿ skutki jedzenia rzepowej zupy Jana Jansena.~
@4699 = ~To naprawdê kiepsko.~
@4700 = ~Nie zauwa¿y³em, ¿e siê tam chowasz, Janie. Jak siê miewasz?~
@4701 = ~Mo¿e nie by³o a¿ tak Ÿle, w ka¿dym razie ju¿ masz ogl¹d na sprawê.~
@4702 = ~Co siê wydarzy³o potem?~
@4703 = ~Nie wiem. Powali³ mnie smród... Nastêpn¹ rzecz¹, jak¹ pamiêtam, by³ mój ojczunio, potrz¹sa³ mn¹ i obudzi³em siê tu¿ przy tym olbrzymim truchle wiwerny. Przez kolejny miesi¹c sprzedawaliœmy steki ze „smoka”.~
@4704 = ~By³y smaczne?~
@4705 = ~Nie wiem. Za ka¿dym razem, gdy zawiesza³em oko na steku, czu³em smród zgni³ej kapusty lub czegoœ gorszego. Po prostu nie da³bym rady tego zjeœæ.~
@4706 = ~No dobrze. Chyba ju¿ rozumiem dlaczego nazywa siê to gospod¹ Pod Smoczym Kresem.~
@4707 = ~Zatem wiesz wiêcej ni¿ ja, poniewa¿ ja nie ca³kiem. Musisz zapytaæ o to mojego ojczunia – to on nazwa³ gospodê, a czasem niezbyt rozumia³em jego poczucie humoru. A wiêc masz pewnoœæ, ¿e nie by³o na zewn¹trz szyldu?~
@4708 = ~Nie, ja ¿adnego szyldu czy innej tabliczki nie widzia³em.~ ~Nie, ja ¿adnego szyldu czy innej tabliczki nie widzia³em.~
@4709 = ~*wzdycha* Pewnie znowu ukrad³ go ten przeklêty gnom.~
@4710 = ~Dlaczego jakiœ gnom mia³by kraœæ twój szyld?~
@4711 = ~To jego sposób na „zemstê” na mnie, choæ nie wiem z jakiego powodu, bo nie chce ze mn¹ rozmawiaæ. S³uchaj, a mo¿e spróbujesz z nim zamieniæ s³owo?~
@4712 = ~Nie mam teraz zbyt wiele do roboty. Gdzie mogê go znaleŸæ?~
@4713 = ~Obecnie jestem trochê zajêty.~ ~Obecnie jestem trochê zajêta.~
@4714 = ~Niewa¿ne... ale warto by³o zapytaæ. Interesuj¹ ciê moje towary?~
@4715 = ~Zale¿y, co masz.~
@4716 = ~Kilka domów na pó³noc st¹d. Nie za bardzo lubi on goœci.~
@4717 = ~Pójdê z nim porozmawiaæ. A teraz, co masz na sprzeda¿?~
@4718 = ~Proszê... mam nadziejê, ¿e ci siê spodoba.~
@4719 = ~No có¿, mo¿e innym razem.~
@4720 = ~Protestujê. Moja zupa z rzepy jest najlepsza na Wybrze¿u Mieczy – <CHARNAME> mo¿e potwierdziæ.~
@4721 = ~Po prostu kontynuuj opowieœæ, Keldrelu. Nadal nie mam pewnoœci, czy to by³a zniewaga, czy nie.~

//*************************************************************************
// Jalil
@4750 = ~WejdŸ, <CHARNAME>, zapraszam! Spodziewa³em siê twojej wizyty.~
@4751 = ~Hm? Kim jesteœ?~
@4752 = ~Wœcibski staruchu! Kim jesteœ i kto doniós³ ci o mojej obecnoœci?~
@4753 = ~Jestem Jalil Astrolog. Twoj¹ wizytê przepowiedzia³y mi gwiazdy.~
@4754 = ~Kolejny szaleniec. Czym siê tu zajmujesz, starcze?~
@4755 = ~Spogl¹dam w niebiosa w poszukiwaniu informacji o przysz³oœci i studiujê gwiazdy w ich sferach. Czy¿ nie korzystamy z gwiazd podczas nawigacji na morzu lub wyznaczania marszruty?~
@4756 = ~Wiem, dok¹d zmierzam i nie potrzebujê podpowiedzi gwiazd, aby tam dotrzeæ.~
@4757 = ~O rety. Ka¿dy z nas potrzebuje czasem pomocy. Nawet ja. Jeœli zgodzisz siê mnie wys³uchaæ, <CHARNAME>, mia³bym dla ciebie kilka rad.~
@4758 = ~Có¿ za idiotyzmy masz zamiar wygadywaæ?~
@4759 = ~Nie zgadzam siê.~
@4760 = ~St¹paj ostro¿nie po swojej œcie¿ce. Jeœli nie bêdziesz mieæ siê na bacznoœci, konsekwencje bêd¹ straszliwe.~
@4761 = ~Ha! Tylko tyle? Bardzo niewiele wiesz!~
@4762 = ~W takim razie niewiele wiêcej mogê ci powiedzieæ.~
@4763 = ~Ach tak. Em... czy moja wizyta naprawdê zosta³a zapisana w gwiazdach?~
@4764 = ~No dobrze... Co jeszcze wiesz?~
@4765 = ~Gwiazdy zdradzi³y mi równie¿, ¿e jesteœ Dzieckiem Bhaala, ale poza tym nie chc¹ lub nie mog¹ wyjawiæ nic wiêcej.~
@4766 = ~Nie mog¹ czy nie chc¹?~
@4767 = ~Nie wiem, <CHARNAME>. W miejscach dotycz¹cych ciebie jest tylko czarna pustka. PodejdŸ. Co w³aœciwie sprowadzi³o ciê do Imradim?~
@4768 = ~Myœla³em, ¿e gwiazdy ci to powiedzia³y!~ ~Myœla³am, ¿e gwiazdy ci to powiedzia³y!~
@4769 = ~Chcesz powiedzieæ, ¿e nie masz pojêcia?~
@4770 = ~Nie jestem nieomylny, a czytanie gwiazd nie jest nauk¹ œcis³¹. Robiê, co mogê, ale to nie zawsze wystarcza.~
@4771 = ~Poszukujê Tygrysiego oka. Jest potrzebne pewnej osobie do uleczenia ciê¿ko chorego krewnego.~
@4772 = ~I ta osoba wys³a³a tutaj ciebie? Z Amn?~
@4773 = ~Mê¿czyzna, o którym mówiê, nie móg³ zostawiæ siostry, wiêc wys³a³ mnie.~
@4774 = ~Porozmawiaj z Aiesh¹, jeœli jeszcze tego nie zrobi³eœ. Ona mo¿e ci pomóc.~ ~Porozmawiaj z Aiesh¹, jeœli jeszcze tego nie zrobi³aœ. Ona mo¿e ci pomóc.~
@4775 = ~Gdzie mogê znaleŸæ tê Aieshê?~
@4776 = ~Rozmawia³em ju¿ z Aiesh¹.~ ~Rozmawia³am ju¿ z Aiesh¹.~
@4777 = ~W domu niedaleko na po³udnie st¹d.~
@4778 = ~Tak, przypominam sobie to miejsce. Dziêkujê. Porozmawiam z ni¹.~
@4779 = ~¯yczê ci powodzenia w twojej misji, <CHARNAME>. Niech gwiazdy prowadz¹ ciê dobr¹ œcie¿k¹.~
@4780 = ~Moja ¿ona Basima czasami pomaga Aieshy i sama posiada pewne umiejêtnoœci zwi¹zane z leczeniem. O której to œwi¹tyni wspomina³a? Ach tak, Lathandera. Œwi¹tynia Lathandera. Liznê³a te¿ nieco magii, choæ sztuka ta jest w Imradim pogardzana. Wspomnia³a kiedyœ, ¿e szkoli³ j¹ Amelior Amanitas w pobli¿u Secomber, jednak z powodu jego irytuj¹cego zwyczaju znikania w po³owie lekcji nie uda³o siê jej opanowaæ zbyt wiele materia³u.~
@4781 = ~Odnoszê wra¿enie, ¿e z twoj¹ ¿on¹ lepiej nie zadzieraæ.~
@4782 = ~Niezupe³nie, <CHARNAME>. Nie skrzywdzi³aby muchy i jest bardzo pracowita. Kiedy nie pomaga Aieshy, kr¹¿y po wiosce, wspomagaj¹c potrzebuj¹cych. Hmm. Czasem siê zastanawiam, jak wiele czarów tak naprawdê zna. Hmm. Niewa¿ne. ¯yczê ci powodzenia w twojej misji, <CHARNAME>. Niech gwiazdy prowadz¹ ciê dobr¹ œcie¿k¹.~

